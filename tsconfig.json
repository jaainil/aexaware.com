{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",

    "skipLibCheck": true,
    "incremental": true,
    "noEmit": true,

    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    "paths": {
      "@/*": ["src/*"]
    },

    "types": ["astro/client"]
  },
  "include": ["src", "astro.config.mjs"],
  "exclude": ["node_modules", "dist", ".astro", ".vercel"]
}