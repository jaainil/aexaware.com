---
import '@/styles/global.css';
import Navbar from '@/components/global/Navbar.astro';
import Footer from '@/components/global/Footer.astro';
import BackToTop from '@/components/global/BackToTop.astro';
import { Schema } from 'astro-seo-schema';
import { SEO } from "astro-seo";

// FIX: Removed @fontsource imports. 
// We are handling fonts in globals.css/tailwind.config to avoid render-blocking and duplicate loads.
// Fonts - Plus Jakarta Sans
import "@fontsource-variable/plus-jakarta-sans";

// Fonts - Space Grotesk (Headings/Display)
import "@fontsource-variable/space-grotesk";

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  tags?: string[];
  lang?: string;
}

const { 
  title, 
  description = "Aexaware Infotech - Building Digital Excellence", 
  image = "/og-image.png",
  type = "website",
  publishedTime,
  modifiedTime,
  author,
  tags,
  lang = "en"
} = Astro.props;

const currentPath = Astro.url.pathname;
const siteUrl = Astro.site ? Astro.site.href : 'https://aexaware.com';
const canonicalURL = new URL(currentPath, siteUrl).href;

// FIX: Handle external images (e.g., from Unsplash/CMS) preventing build crashes
const imageUrl = image.startsWith('http') 
  ? image 
  : new URL(image, siteUrl).href;
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#3347F3" />
    <meta name="generator" content={Astro.generator} />
    
    <SEO
      title={title}
      description={description}
      openGraph={{
        basic: {
          title: title,
          type: type,
          image: imageUrl,
          url: canonicalURL,
        },
        optional: {
          siteName: "Aexaware Infotech",
          locale: "en_US",
          description: description,
        },
        ...(type === 'article' && {
          article: {
            ...(publishedTime && { publishedTime }),
            ...(modifiedTime && { modifiedTime }),
            ...(author && { authors: [author] }),
            ...(tags && { tags }),
          }
        }),
      }}
      twitter={{
        card: "summary_large_image",
        site: "@aexaware",
        creator: "@aexaware",
        title: title,
        description: description,
        image: imageUrl,
      }}
      extend={{
        link: [
          { rel: "icon", type: "image/png", href: "/favicon.png" },
          { rel: "apple-touch-icon", href: "/favicon.png" },
          { rel: "canonical", href: canonicalURL },
        ],
      }}
    />
    
    {import.meta.env.PROD && <link rel="sitemap" href="/sitemap-index.xml" />}
    <link rel="alternate" type="application/rss+xml" title="Aexaware Infotech Blog" href="/rss.xml" />
    
    <Schema
      item={{
        '@context': 'https://schema.org',
        '@type': 'Organization',
        name: "Aexaware Infotech",
        url: siteUrl.toString(),
        logo: new URL('/og-image.png', siteUrl).href,
        description: "Full-service digital agency specializing in web development, mobile apps, AI/ML integration, and cloud solutions",
        sameAs: [
          "https://www.linkedin.com/company/aexaware",
          "https://twitter.com/aexaware",
          "https://github.com/aexaware"
        ],
        contactPoint: {
          '@type': 'ContactPoint',
          telephone: "+91-8140734392",
          contactType: "Customer Service",
          email: "contact@aexaware.com"
        },
        address: {
          '@type': 'PostalAddress',
          streetAddress: "Anand",
          addressLocality: "Vadodara",
          addressRegion: "Gujarat",
          postalCode: "388001",
          addressCountry: "IN"
        }
      }}
    />
    <Schema
      item={{
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: "Aexaware Infotech",
        url: siteUrl.toString(),
        description: "Building Digital Excellence - Web, Mobile, AI/ML Solutions"
      }}
    />
    <slot name="head" />
  </head>
 
  <body class="min-h-screen bg-background font-sans antialiased flex flex-col overflow-x-hidden">
    <a 
      href="#main-content" 
      class="sr-only focus:not-sr-only focus:absolute focus:z-[100] focus:top-4 focus:left-4 focus:px-4 focus:py-2 focus:bg-primary focus:text-primary-foreground focus:rounded-md transition-all"
    >
      Skip to main content
    </a>
    
    <Navbar />
    
    <main id="main-content" class="flex-1 w-full relative">
      <slot />
    </main>
    
    <Footer />
    <BackToTop />
  </body>
</html>