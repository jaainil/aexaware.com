---
import '@/styles/global.css';
import Navbar from '@/components/global/Navbar.astro';
import Footer from '@/components/global/Footer.astro';
import BackToTop from '@/components/global/BackToTop.astro';
import { Schema } from 'astro-seo-schema';
import { SEO } from "astro-seo";

import "@fontsource-variable/plus-jakarta-sans";
import "@fontsource-variable/space-grotesk";

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  tags?: string[];
  lang?: string;
  noIndex?: boolean;
}

const { 
  title, 
  description,
  image,
  type = "website",
  publishedTime,
  modifiedTime,
  author,
  tags,
  lang = "en",
  noIndex = false
} = Astro.props;

const currentPath = Astro.url.pathname;
const siteUrl = Astro.site ? Astro.site.href : 'https://aexaware.com';
const canonicalURL = new URL(currentPath, siteUrl).href;

const imageUrl = image 
  ? (image.startsWith('http') ? image : new URL(image, siteUrl).href)
  : new URL('/og-image.png', siteUrl).href;

const siteName = "Aexaware Infotech";
const twitterHandle = "@aexaware";
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1d4ed8" />
    <meta name="generator" content={Astro.generator} />
    
    <SEO
      title={title}
      description={description || `${siteName} - Custom web, mobile, AI/ML, and DevOps solutions for startups and enterprises.`}
      noindex={noIndex}
      nofollow={noIndex}
      openGraph={{
        basic: {
          title: title,
          type: type,
          image: imageUrl,
          url: canonicalURL,
        },
        optional: {
          siteName: siteName,
          locale: "en_US",
          description: description || `${siteName} - Custom web, mobile, AI/ML, and DevOps solutions for startups and enterprises.`,
        },
        ...(type === 'article' && {
          article: {
            ...(publishedTime && { publishedTime }),
            ...(modifiedTime && { modifiedTime }),
            ...(author && { authors: [author] }),
            ...(tags && { tags }),
          }
        }),
      }}
      twitter={{
        card: image ? "summary_large_image" : "summary",
        site: twitterHandle,
        creator: twitterHandle,
        title: title,
        ...(description && { description }),
        ...(image && { image: imageUrl }),
      }}
      canonical={canonicalURL}
      extend={{
        link: [
          { rel: "icon", type: "image/png", href: "/favicon.png" },
          { rel: "apple-touch-icon", href: "/favicon.png" },
          { rel: "alternate", type: "application/rss+xml", title: `${siteName} Blog`, href: "/rss.xml" },
          { rel: "alternate", hreflang: "en", href: canonicalURL },
          { rel: "alternate", hreflang: "x-default", href: canonicalURL },
        ],
        meta: [
          { name: "author", content: author || siteName },
          ...(tags && tags.length > 0 ? [{ name: "keywords", content: tags.join(", ") }] : []),
          ...(!noIndex ? [{ name: "robots", content: "max-image-preview:large, max-snippet:-1, max-video-preview:-1" }] : []),
          { property: "og:image:width", content: "1200" },
          { property: "og:image:height", content: "630" },
          { property: "og:image:type", content: "image/png" },
        ],
      }}
    />
    
    <link rel="sitemap" href="/sitemap-index.xml" />
    
    {/* RFC 8288 & ARD Link relations for agent discovery */}
    <link rel="service-desc" href="/openapi.json" type="application/vnd.oai.openapi+json" />
    <link rel="api-catalog" href="/.well-known/api-catalog" type="application/linkset+json" />
    <link rel="ai-catalog" href="/.well-known/ai-catalog.json" type="application/json" />
    <link rel="describedby" href="/llms.txt" type="text/plain" />
    <link rel="service-desc" href="/.well-known/mcp/server-card.json" type="application/json" />
    <link rel="service-doc" href="/services" type="text/html" />

    <Schema
      item={{
        '@context': 'https://schema.org',
        '@graph': [
          {
            '@type': 'Organization' as const,
            '@id': `${siteUrl}#organization`,
            name: siteName,
            legalName: 'Aexaware Infotech',
            alternateName: ['Aexaware', 'Aexaware Infotech', 'Aexaware Infotech Pvt Ltd', 'aexaware.com'],
            url: siteUrl,
            logo: {
              '@type': 'ImageObject',
              url: new URL('/og-image.png', siteUrl).href,
            },
            brand: {
              '@type': 'Brand',
              name: 'Aexaware',
              alternateName: 'Aexaware Infotech',
              url: siteUrl,
            },
            description: "Full-service software development company specializing in web development, mobile apps, AI/ML integration, DevOps, cloud solutions, and digital marketing. Founded in 2024, based in Vadodara, Gujarat, India.",
            foundingDate: "2024",
            founder: {
              '@type': 'Person',
              name: 'Axit Padaliya',
              jobTitle: 'Founder & CEO',
              url: 'https://www.linkedin.com/in/axit-padaliya-451463202/',
            },
            numberOfEmployees: {
              '@type': 'QuantitativeValue',
              minValue: 2,
              maxValue: 10,
            },
            areaServed: ['Worldwide', 'IN', 'US', 'GB', 'AE', 'CA', 'AU'],
            sameAs: [
              'https://www.linkedin.com/company/aexaware',
              'https://twitter.com/aexaware',
              'https://x.com/aexaware',
              'https://github.com/aexaware',
              'https://www.instagram.com/aexaware/',
              'https://www.youtube.com/@aexaware',
              'https://clutch.co/profile/aexaware-infotech',
              'https://www.goodfirms.co/company/aexaware-infotech',
              'https://codeberg.org/Aexaware'
            ],
            contactPoint: {
              '@type': 'ContactPoint',
              telephone: '+91-8140734392',
              contactType: 'Customer Service',
              email: 'info@aexaware.com',
              areaServed: ['IN', 'US', 'GB', 'AE', 'CA', 'AU'],
              availableLanguage: ['English', 'Hindi', 'Gujarati'],
            },
            address: {
              '@type': 'PostalAddress',
              streetAddress: 'Office no 13, 3rd Floor Aarya\'s landmark, Canal Ring Road, Sevasi',
              addressLocality: 'Vadodara',
              addressRegion: 'Gujarat',
              postalCode: '391101',
              addressCountry: 'IN',
            },
            knowsAbout: [
              'React', 'Next.js', 'Node.js', 'Python', 'PHP', 'Laravel', 'TypeScript', 
              'Tailwind CSS', 'Astro', 'PostgreSQL', 'MongoDB', 'Redis',
              'AWS', 'GCP', 'Azure', 'Docker', 'Kubernetes', 'Terraform',
              'TensorFlow', 'PyTorch', 'OpenAI', 'LangChain', 'LLM Integration',
              'WordPress', 'Ghost CMS', 'WooCommerce',
              'Web Development', 'Mobile Development', 'AI Development', 'Cloud DevOps'
            ],
          },
          {
            '@type': 'WebSite',
            '@id': `${siteUrl}#website`,
            name: siteName,
            url: siteUrl,
            description: 'Custom web, mobile, AI/ML, and DevOps solutions for startups and enterprises – built in Vadodara, serving globally.',
            publisher: {
              '@type': 'Organization',
              name: siteName,
            },
            potentialAction: {
              '@type': 'SearchAction',
              target: `${siteUrl}blog?q={search_term_string}`,
              'query-input': 'required name=search_term_string',
            } as any,
          },
          {
            '@type': 'Person',
            '@id': `${siteUrl}#founder`,
            name: 'Axit Padaliya',
            url: siteUrl,
            jobTitle: 'Founder & CEO',
            worksFor: {
              '@type': 'Organization',
              name: siteName,
              url: siteUrl,
            },
            sameAs: [
              'https://www.linkedin.com/in/axit-padaliya-451463202/',
            ],
          },
        ],
      }}
    />
    
    <slot name="head" />
  </head>
 
  <body class="min-h-screen bg-background font-sans antialiased flex flex-col overflow-x-hidden">
    <div class="sr-only" role="contentinfo" aria-label="Company information">
      <p>Aexaware Infotech — Software development company in Vadodara, Gujarat, India. We build web, mobile, and AI solutions for startups and enterprises worldwide.</p>
    </div>
    
    <a 
      href="#main-content" 
      class="sr-only focus:not-sr-only focus:absolute focus:z-100 focus:top-4 focus:left-4 focus:px-4 focus:py-2 focus:bg-primary focus:text-primary-foreground focus:rounded-md transition-all"
    >
      Skip to main content
    </a>
    
    <Navbar />
    
    <main id="main-content" class="flex-1 w-full relative">
      <slot />
    </main>
    
    <Footer />
    <BackToTop />

    {/* WebMCP - Expose site tools to AI agents via the browser (https://webmachinelearning.github.io/webmcp/) */}
    <script is:inline>
      (function () {
        if (typeof navigator === "undefined" || !("modelContext" in navigator)) return;
        var mc = navigator.modelContext;
        if (typeof mc === "undefined" || typeof mc.registerTool !== "function") return;

        var controller = new AbortController();
        var signal = controller.signal;

        // Tool: Search the blog
        mc.registerTool({
          name: "search_blog",
          description: "Search Aexaware Infotech's engineering blog for articles on web development, AI/ML, DevOps, and software engineering.",
          inputSchema: {
            type: "object",
            properties: {
              query: { type: "string", description: "Search term or topic to look up" }
            },
            required: ["query"]
          },
          execute: function (params) {
            var query = params.query;
            window.location.href = "/blog?q=" + encodeURIComponent(query);
            return Promise.resolve({ redirected: true, url: "/blog?q=" + encodeURIComponent(query) });
          }
        }, { signal: signal });

        // Tool: Get services list
        mc.registerTool({
          name: "list_services",
          description: "Get the full list of software development services offered by Aexaware Infotech, including web, mobile, AI/ML, cloud, and design services.",
          inputSchema: { type: "object", properties: {} },
          execute: function () {
            return Promise.resolve({
              services: [
                { name: "Web & Software Development", url: "https://aexaware.com/services/web-development", stack: "React, Next.js, Node.js, Python, PHP, e-commerce, CMS, SaaS" },
                { name: "Mobile App Development", url: "https://aexaware.com/services/mobile-development", stack: "React Native, Flutter, iOS, Android" },
                { name: "MVP Development", url: "https://aexaware.com/services/mvp-development", stack: "Rapid prototyping, idea validation" },
                { name: "AI & Machine Learning", url: "https://aexaware.com/services/ai-ml-integration", stack: "Custom chatbots, AI agents, RAG, workflow automation, generative media, predictive analytics" },
                { name: "Cloud, DevOps & IoT", url: "https://aexaware.com/services/cloud-devops", stack: "AWS, GCP, Azure, Kubernetes, Terraform, firmware, edge" },
                { name: "UI/UX Design", url: "https://aexaware.com/services/ui-ux-design", stack: "Figma, design systems, user research" },
                { name: "Branding & Marketing", url: "https://aexaware.com/services/branding-positioning", stack: "Brand identity, SEO, paid ads, content, CRO" },
                { name: "Hire Developers", url: "https://aexaware.com/services/extended-team", stack: "Dedicated developers, pods, white-label for agencies" }
              ]
            });
          }
        }, { signal: signal });

        // Tool: Get company contact info
        mc.registerTool({
          name: "get_contact_info",
          description: "Get Aexaware Infotech's contact information, office address, and ways to start a project.",
          inputSchema: { type: "object", properties: {} },
          execute: function () {
            return Promise.resolve({
              company: "Aexaware Infotech",
              email: "info@aexaware.com",
              phone: "+91 81407 34392",
              address: "Office no 13, 3rd Floor Aarya's landmark, Canal Ring Road, Sevasi, Vadodara, Gujarat 391101, India",
              contact_url: "https://aexaware.com/contact",
              start_project_url: "https://aexaware.com/start-project",
              book_call_url: "https://cal.com/aexaware-infotech",
              social: {
                linkedin: "https://www.linkedin.com/company/aexaware",
                twitter: "https://twitter.com/aexaware",
                github: "https://github.com/aexaware"
              }
            });
          }
        }, { signal: signal });

        // Tool: Get portfolio case studies
        mc.registerTool({
          name: "list_portfolio",
          description: "Get Aexaware Infotech's portfolio of completed projects with descriptions, tech stack, and live URLs.",
          inputSchema: { type: "object", properties: {} },
          execute: function () {
            return Promise.resolve({
              projects: [
                { name: "Qreius", url: "https://aexaware.com/portfolio/qreius", live: "https://qreius.com/", stack: "React, Tailwind CSS, shadcn/ui, Cloudflare CDN, Vercel", delivered_in: "3 weeks" },
                { name: "ADFerti", url: "https://aexaware.com/portfolio/adferti", live: "https://adferti.com/", stack: "WordPress 6.9, WooCommerce, Elementor, RankMath SEO", delivered_in: "4 weeks" },
                { name: "Shravonix", url: "https://aexaware.com/portfolio/shravonix", live: "https://shravonix.com/", stack: "Ghost CMS 6.8, React, Node.js, Cloudflare CDN", delivered_in: "4 weeks" },
                { name: "Bharat Krushi Bio Fertilizer", url: "https://aexaware.com/portfolio/bharat-krushi", live: "https://bharatkrushibiofertilizer.com/", stack: "WordPress, WooCommerce, LiteSpeed, Yoast SEO", delivered_in: "4 weeks" },
                { name: "JK Fertilizers", url: "https://aexaware.com/portfolio/jk-fertilizers", live: "https://jkfertilizers.com/", stack: "WordPress, WooCommerce, GTranslate, GSAP", delivered_in: "5 weeks" }
              ]
            });
          }
        }, { signal: signal });

        window.addEventListener("unload", function () { controller.abort(); }, { once: true });
      })();
    </script>
  </body>
</html>