---
import Layout from '@/layouts/Layout.astro';
import { Schema } from 'astro-seo-schema';
import { ArrowRight, Sparkles } from "lucide-astro";
import { buttonVariants } from '@/components/ui/button-variants';
import { cn } from '@/lib/utils';
import CTA from '@/components/astro/CTA.astro';
import BackgroundGrid from '@/components/astro/BackgroundGrid.astro';
import { 
  Code2, 
  Braces, 
  FileCode, 
  Server, 
  Database, 
  Cloud, 
  Container, 
  Smartphone, 
  Palette, 
  Layers, 
  GitBranch, 
  Terminal, 
  Globe, 
  Cpu, 
  Wrench,
  Cog
} from "lucide-astro";

interface ServiceItem {
  id: string;
  // FIX: Loosened type to 'any' to accept Astro components (Lucide icons) without TS friction
  icon: any; 
  title: string;
  desc: string;
  gradient: string;
  iconColor: string;
}

interface Props {
  title: string;
  description: string;
  heroTitle: string;
  heroSubtitle: string;
  heroDescription: string;
  heroBadge: string;
  servicesTitle: string;
  servicesDescription: string;
  services: ServiceItem[];
  techStack: string[];
  ctaTitle?: string;
  ctaDescription?: string;
}

const {
  title,
  description,
  heroTitle,
  heroSubtitle,
  heroDescription,
  heroBadge,
  servicesTitle,
  servicesDescription,
  services,
  techStack,
  ctaTitle = "Ready to transform your business?",
  ctaDescription = "Let's build something extraordinary together.",
} = Astro.props;

// Icon mapping for common technologies
const techIconMap: Record<string, any> = {
  // Languages & Frameworks
  "React": Braces,
  "Next.js": Layers,
  "TypeScript": FileCode,
  "JavaScript": Code2,
  "Node.js": Server,
  "Python": Terminal,
  "Vue.js": Braces,
  "Angular": Braces,
  "Svelte": Braces,
  "Astro": Globe,
  
  // Mobile
  "React Native": Smartphone,
  "Flutter": Smartphone,
  "Swift": Smartphone,
  "Kotlin": Smartphone,
  "iOS": Smartphone,
  "Android": Smartphone,
  
  // Databases
  "PostgreSQL": Database,
  "MongoDB": Database,
  "MySQL": Database,
  "Redis": Database,
  "Firebase": Database,
  "Supabase": Database,
  
  // Cloud & DevOps
  "AWS": Cloud,
  "Azure": Cloud,
  "GCP": Cloud,
  "Docker": Container,
  "Kubernetes": Container,
  "Vercel": Cloud,
  "Netlify": Cloud,
  
  // Design
  "Figma": Palette,
  "Adobe XD": Palette,
  "Sketch": Palette,
  
  // Other
  "GraphQL": GitBranch,
  "REST API": GitBranch,
  "Tailwind CSS": Palette,
  "TensorFlow": Cpu,
  "PyTorch": Cpu,
  "OpenAI": Cpu,
  "Shopify": Globe,
  "WooCommerce": Globe,
  "Stripe": Globe,
  "Jenkins": Cog,
  "GitHub Actions": GitBranch,
  "CI/CD": Cog,
  "Terraform": Wrench,
  "Ansible": Wrench,
};

// Get icon for a tech, with fallback
const getTechIcon = (tech: string) => techIconMap[tech] || Code2;

// Generate breadcrumb schema
const siteUrl = Astro.site || 'https://aexaware.com';
---

<Layout 
  title={`${title} – Aexaware Infotech`} 
  description={description}
>
  <Fragment slot="head">
    <Schema
      item={{
        "@context": "https://schema.org",
        "@type": "Service",
        serviceType: title,
        provider: {
          "@type": "Organization",
          name: "Aexaware Infotech",
          url: siteUrl.toString(),
        },
        areaServed: {
          "@type": "Country",
          name: "India"
        },
        description: description,
      }}
    />
    <Schema
      item={{
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: [
          {
            "@type": "ListItem",
            position: 1,
            name: "Home",
            item: siteUrl.toString(),
          },
          {
            "@type": "ListItem",
            position: 2,
            name: "Services",
            item: new URL('/services', siteUrl).href,
          },
          {
            "@type": "ListItem",
            position: 3,
            name: title,
          },
        ]
      }}
    />
  </Fragment>
  
  {/* Hero Section */}
  {/* FIX: Use 100dvh for full-screen hero on mobile and desktop */}
  <section class="relative w-full min-h-dvh flex flex-col justify-center pt-32 pb-16 lg:pb-24 overflow-hidden border-b border-border/40">
    
    {/* FIX: Semantic Grid Background */}
    <BackgroundGrid density="sm" mask="top" />
    
    <div class="container-normal relative z-10">
      <div class="max-w-5xl mx-auto text-center">
        
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-primary/20 bg-primary/5 backdrop-blur-xs mb-8">
          <Sparkles className="w-4 h-4 text-primary" />
          <span class="text-sm font-semibold text-primary tracking-wide uppercase">{heroBadge}</span>
        </div>

        <h1 class="font-heading font-bold text-5xl sm:text-7xl lg:text-8xl tracking-tighter leading-[0.9] text-foreground mb-8">
          {heroTitle} <br class="hidden md:block" />
          <span class="text-transparent bg-clip-text bg-linear-to-r from-primary to-accent">
            {heroSubtitle}
          </span>
        </h1>
        
        <p class="mx-auto mt-8 max-w-2xl text-xl text-muted-foreground leading-relaxed whitespace-pre-line text-pretty">
          {heroDescription}
        </p>
        
        <div class="mt-12 flex flex-col sm:flex-row gap-4 justify-center">
          <a 
            href="/contact" 
            class={cn(buttonVariants({ size: "lg" }), "h-14 rounded-full px-10 text-lg shadow-lg hover:shadow-primary/20 transition-all")}
          >
            Start Project <ArrowRight className="ml-2 h-5 w-5" />
          </a>
          <a 
            href="#services" 
            class={cn(buttonVariants({ variant: "outline", size: "lg" }), "h-14 rounded-full px-10 text-lg bg-background/50 hover:bg-background")}
          >
            Explore Services
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* Services Section */}
  <section id="services" class="section-padding relative overflow-hidden bg-background">
     {/* Subtle grid background */}
    <BackgroundGrid density="md" opacity={0.03} class="opacity-50" />

    <div class="container-normal relative z-10">
      
      <div class="flex flex-col md:flex-row justify-between items-end mb-20 gap-8 border-b border-border/40 pb-8">
        <div class="max-w-3xl">
          <span class="text-sm font-semibold text-primary uppercase tracking-widest mb-3 block">Our Capabilities</span>
          <h2 class="font-heading text-4xl md:text-5xl font-bold leading-tight text-foreground">
            {servicesTitle}
          </h2>
          <p class="mt-4 text-xl text-muted-foreground">
            {servicesDescription}
          </p>
        </div>
      </div>

      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {services.map((service) => (
          <div class="group relative bg-card/50 backdrop-blur-xs p-10 rounded-card-lg border border-border/50 hover:border-primary/50 hover:shadow-2xl transition-all duration-500 hover:-translate-y-1 overflow-hidden">
            
            {/* Hover Gradient Background */}
            <div class={`absolute inset-0 bg-linear-to-br ${service.gradient} opacity-0 group-hover:opacity-100 transition-opacity duration-500`} />

            <div class="relative z-10">
              <div class="flex justify-between items-start mb-8">
                <div class={`h-14 w-14 rounded-2xl bg-background border border-border/50 flex items-center justify-center shadow-xs group-hover:scale-110 transition-transform duration-500`}>
                  <service.icon className={cn("h-7 w-7", service.iconColor)} strokeWidth={1.5} />
                </div>
                <span class="text-6xl font-bold font-heading text-muted-foreground/5 group-hover:text-foreground/5 transition-colors select-none">
                  {service.id}
                </span>
              </div>

              <h3 class="font-heading text-2xl font-bold text-foreground mb-4">
                {service.title}
              </h3>
              <p class="text-muted-foreground leading-relaxed text-base">
                {service.desc}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* Technical Toolbox */}
  <section class="section-padding border-y border-border/40 bg-linear-to-b from-secondary/5 to-background relative overflow-hidden">
    {/* Decorative background elements */}
    <BackgroundGrid density="lg" opacity={0.02} />
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-primary/5 rounded-full blur-3xl pointer-events-none" />
    
    <div class="container-normal relative z-10">
      <div class="text-center mb-16">
        <span class="text-sm font-semibold text-muted-foreground uppercase tracking-widest block mb-4">
          Powered By Modern Tech
        </span>
        <h2 class="font-heading text-3xl md:text-4xl font-bold text-foreground">
          Our Technical Toolbox
        </h2>
      </div>

      {/* Tech Stack Grid */}
      <div class="flex flex-wrap justify-center gap-4 md:gap-5 max-w-5xl mx-auto">
        {techStack.map((tech) => {
          const IconComponent = getTechIcon(tech);
          return (
            <div class="group flex items-center gap-3 px-5 py-3 rounded-full bg-card/80 backdrop-blur-xs border border-border/50 hover:border-primary/40 hover:bg-primary/5 hover:shadow-lg hover:shadow-primary/10 transition-all duration-300 cursor-default">
              <div class="flex items-center justify-center w-8 h-8 rounded-lg bg-primary/10 text-primary group-hover:bg-primary group-hover:text-primary-foreground transition-all duration-300 group-hover:scale-110">
                <IconComponent className="h-4 w-4" aria-hidden="true" />
              </div>
              <span class="font-medium text-base text-muted-foreground group-hover:text-foreground transition-colors whitespace-nowrap">
                {tech}
              </span>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <CTA 
    buttonText="Start Project"
    description={ctaDescription}
  />
</Layout>