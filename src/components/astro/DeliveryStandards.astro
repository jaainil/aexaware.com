---
import {
  Zap,
  Clock,
  Code2,
  Users,
  Layers,
  GitBranch,
  Terminal,
  Shield,
} from "lucide-astro";

const features = [
  {
    icon: Zap,
    title: "Rapid Prototyping",
    desc: "For landing pages and UI concepts, we guarantee a delivery time of less than 3 days. High-fidelity Figma or Code.",
    stat: "72h",
    statLabel: "Turnaround",
    colSpan: "md:col-span-2",
    bgClass: "bg-primary/5 border-primary/20",
  },
  {
    icon: Clock,
    title: "Weekly Sprint Cycles",
    desc: "For complex apps, we work in 1-week sprints. Shippable, testable code deployed to staging every Friday.",
    stat: "Fridays",
    statLabel: "Demo Day",
    colSpan: "md:col-span-1",
    bgClass: "bg-background border-border/50",
  },
  {
    icon: GitBranch,
    title: "Code Ownership",
    desc: "You own the source code from Day 1. Full GitHub access, no vendor lock-in.",
    colSpan: "md:col-span-1",
    bgClass: "bg-background border-border/50",
  },
  {
    icon: Users,
    title: "Direct Engineering Access",
    desc: "Speak directly with the architects building your product. No middle-management.",
    colSpan: "md:col-span-1",
    bgClass: "bg-background border-border/50",
  },
  {
    icon: Layers,
    title: "Zero Bloat",
    desc: "We build exactly what you need to validate your business goals. Lean and efficient.",
    colSpan: "md:col-span-1",
    bgClass: "bg-background border-border/50",
  },
];
---

<section class="section-padding bg-secondary/5 relative overflow-hidden">
  <div class="container-normal relative z-10">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div
        class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-primary/20 bg-primary/5 text-primary text-xs font-semibold uppercase tracking-wider mb-6"
      >
        <Shield className="w-3 h-3" />
        Our Guarantee
      </div>
      <h2
        class="font-heading text-4xl md:text-5xl font-bold tracking-tight text-foreground mb-6"
      >
        Speed is a <span class="text-primary font-serif">Feature.</span>
      </h2>
      <p class="text-xl text-muted-foreground leading-relaxed">
        We have optimized our development pipeline to eliminate bureaucracy and
        focus purely on shipping code.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {
        features.map((item, i) => (
          <div
            class={`group relative p-8 rounded-card border overflow-hidden transition-all duration-300 hover:shadow-lg hover:border-primary/30 ${item.colSpan} ${item.bgClass} flex flex-col justify-between`}
          >
            <div class="absolute inset-0 bg-primary/5 opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none" />

            <div>
              <div class="flex items-center justify-between mb-6">
                <div class="p-3 rounded-xl bg-secondary text-primary group-hover:scale-110 transition-transform duration-300 shadow-xs">
                  <item.icon className="h-6 w-6" strokeWidth={1.5} />
                </div>
                {item.stat && (
                  <div class="text-right">
                    <div class="text-2xl font-bold text-foreground font-heading leading-none">
                      {item.stat}
                    </div>
                    <div class="text-xs font-medium text-muted-foreground uppercase tracking-wide">
                      {item.statLabel}
                    </div>
                  </div>
                )}
              </div>

              <h3 class="font-heading text-xl font-bold text-foreground mb-3 group-hover:text-primary transition-colors">
                {item.title}
              </h3>
              <p class="text-muted-foreground leading-relaxed">{item.desc}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
