---
import { buttonVariants } from "@/components/ui/button-variants";
import { ArrowRight, CheckCircle2, Sparkles, Layers, Rocket, Search } from "lucide-astro";
import { cn } from "@/lib/utils";

const steps = [
  {
    number: "01",
    title: "Discovery",
    icon: Search,
    timeline: "Week 1-2",
    desc: "We dive deep into your goals. No assumptions. Just pure strategy and architectural planning to set a rock-solid foundation.",
    features: ["Tech Roadmap", "Architecture Design", "UX Research"],
  },
  {
    number: "02",
    title: "Build",
    icon: Layers,
    timeline: "Week 3-8",
    desc: "Agile development with weekly sprints. You see your product evolve in real-time, ensuring we hit every milestone perfectly.",
    features: ["Rapid Prototyping", "Scalable Code", "Weekly Demos"],
  },
  {
    number: "03",
    title: "Launch",
    icon: Rocket,
    timeline: "Ongoing",
    desc: "Seamless deployment and beyond. We ensure high availability, security, and performance as your user base grows.",
    features: ["CI/CD Pipeline", "24/7 Monitoring", "Growth Support"],
  },
];
---

<section class="relative py-32 overflow-hidden bg-background" aria-labelledby="process-heading">
  
  {/* Connected Line Background */}
  <div class="absolute top-1/2 left-0 w-full h-px bg-border -translate-y-1/2 hidden md:block" />
  
  <div class="container relative z-10 mx-auto px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-20">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-primary/20 bg-primary/5 text-primary text-xs font-semibold uppercase tracking-wider mb-6">
        <Sparkles className="w-3 h-3" />
        Process
      </div>
      <h2 id="process-heading" class="text-4xl md:text-5xl font-bold tracking-tight text-foreground mb-6">
        From Concept to Code.
      </h2>
      <p class="text-xl text-muted-foreground">
        A transparent, agile workflow designed for speed and quality.
      </p>
    </div>

    <!-- Steps Grid -->
    <div class="grid md:grid-cols-3 gap-8 relative">
      {steps.map((step, i) => (
        <div class="group relative bg-card border border-border/50 rounded-3xl p-8 hover:border-primary/50 transition-colors duration-300">
          
          {/* Step Number Background */}
          <span class="absolute top-6 right-8 text-6xl font-bold text-foreground/5 pointer-events-none select-none group-hover:text-primary/10 transition-colors">
            {step.number}
          </span>

          <div class="mb-8 relative">
            <div class="h-14 w-14 rounded-2xl bg-secondary flex items-center justify-center text-foreground mb-6 group-hover:scale-110 transition-transform duration-300 shadow-sm">
              <step.icon className="h-7 w-7 text-primary" strokeWidth={1.5} />
            </div>
            
            <div class="inline-block px-3 py-1 bg-secondary/50 rounded-full text-xs font-medium text-muted-foreground mb-4">
              {step.timeline}
            </div>

            <h3 class="text-2xl font-bold text-foreground mb-3">
              {step.title}
            </h3>
            <p class="text-muted-foreground leading-relaxed mb-6">
              {step.desc}
            </p>
          </div>

          <ul class="space-y-3 border-t border-border/40 pt-6">
            {step.features.map((feature) => (
              <li class="flex items-center gap-3 text-sm font-medium text-foreground/80">
                <CheckCircle2 className="w-4 h-4 text-primary" />
                {feature}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- CTA -->
    <div class="mt-20 text-center">
      <a 
        href="/contact" 
        class={cn(buttonVariants({ size: "lg" }), "h-14 rounded-full px-8 text-lg hover:shadow-lg transition-all")}
      >
        Start Your Journey <ArrowRight className="ml-2 h-5 w-5" />
      </a>
    </div>
  </div>
</section>
