---
import { buttonVariants } from "@/components/ui/button-variants";
import { Briefcase, ArrowRight } from "lucide-astro";
import { cn } from "@/lib/utils";
import TrustedBy from "@/components/astro/TrustedBy.astro";
import Typewriter from "astro-typewriter";
---

<section class="relative w-full bg-background min-h-[100svh] flex flex-col justify-center py-32 lg:py-40 overflow-hidden">
  
  {/* Decorative background blobs */}
  <div class="pointer-events-none absolute top-0 right-0 -z-10 h-[600px] w-[600px] translate-x-1/3 -translate-y-1/4 rounded-full bg-primary/10 blur-3xl" aria-hidden="true" />
  <div class="pointer-events-none absolute bottom-0 left-0 -z-10 h-[500px] w-[500px] -translate-x-1/3 translate-y-1/4 rounded-full bg-accent/10 blur-3xl" aria-hidden="true" />

  <div class="container relative z-10 px-6 mx-auto">
    <div class="max-w-4xl mx-auto space-y-8 text-center flex flex-col items-center">
      
      {/* Main Headline */}
      <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl tracking-tight leading-[1.15] text-foreground font-bold">
        <span class="font-serif italic font-medium block mb-2 sm:mb-4">We Build</span>
        
        {/* Typewriter Container Fix:
            1. h-[3em] reserves space for 2 lines of text on mobile to prevent layout jumping.
            2. flex & justify-center keeps the cursor aligned.
        */}
        <span class="text-primary block min-h-[2.5em] sm:min-h-[1.5em] h-auto flex justify-center items-start sm:items-center">
          <Typewriter 
            messages={[
              "Jamstack Apps",
              "UI/UX Designs",
              "Mobile Apps", 
              "Web Applications",
              "E-Commerce Stores",
              "Scalable AI Systems",
              "Cloud Solutions"
            ]} 
            writeSpeed={100}
            deleteSpeed={50}
            waitWritten={2000}
          />
        </span>
      </h1>

      {/* Subheadline */}
      <p class="max-w-2xl mx-auto text-base md:text-xl text-muted-foreground leading-relaxed font-medium px-2">
        From idea to launch — web, mobile & AI systems designed for startups and enterprises that need to grow fast.
      </p>

      {/* CTA Buttons */}
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 w-full sm:w-auto pt-4">
        <a 
          href="/contact" 
          class={cn(
            buttonVariants({ size: "lg" }), 
            "h-12 md:h-14 rounded-full px-8 text-base md:text-lg shadow-xl w-full sm:w-auto transition-transform hover:scale-105"
          )}
        >
          <Briefcase className="mr-2 h-5 w-5" aria-hidden="true" />
          Book Free Strategy Call
        </a>
        <a 
          href="/portfolio" 
          class={cn(
            buttonVariants({ size: "lg", variant: "outline" }), 
            "h-12 md:h-14 rounded-full px-8 text-base md:text-lg bg-background/50 backdrop-blur-sm border-primary/20 w-full sm:w-auto transition-transform hover:scale-105"
          )}
        >
          View Portfolio
          <ArrowRight className="ml-2 h-5 w-5" aria-hidden="true" />
        </a>
      </div>

      {/* Social Proof - Added spacing so it doesn't hit the bottom edge */}
      <div class="w-full pt-8 sm:pt-12 pb-4">
        <TrustedBy minimal={true} />
      </div>
    </div>
  </div>
</section>