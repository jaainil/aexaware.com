---
import { buttonVariants } from "@/components/ui/button-variants";
import { Briefcase, ArrowRight, Sparkles } from "lucide-astro";
import { cn } from "@/lib/utils";
import TrustedBy from "@/components/astro/TrustedBy.astro";

// FIX: Use the React component for client-side animation, not the static Astro package
import { TypewriterEffect } from "@/components/react/TypewriterEffect";

const words = [
  "Digital Futures",
  "Killer Apps",
  "E-Commerce",
  "AI Systems"
];
---

<section class="relative w-full bg-background min-h-[95dvh] flex flex-col justify-center pt-32 pb-20 lg:py-32 overflow-hidden border-b border-white/5">
  
  {/* Modern Grid Background */}
  <div class="absolute inset-0 bg-[linear-gradient(to_right,hsl(var(--foreground)/0.03)_1px,transparent_1px),linear-gradient(to_bottom,hsl(var(--foreground)/0.03)_1px,transparent_1px)] bg-[size:14px_24px] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)] pointer-events-none" />

  {/* Ambient Glows */}
  <div class="pointer-events-none absolute top-0 left-1/2 -translate-x-1/2 -z-10 h-[500px] w-[1000px] rounded-full bg-primary/10 blur-3xl" aria-hidden="true" />
  
  <div class="container relative z-10 px-6 mx-auto">
    <div class="max-w-6xl mx-auto text-center flex flex-col items-center">
      
      {/* Badge */}
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-primary/20 bg-primary/5 backdrop-blur-sm mb-8">
        <Sparkles className="w-4 h-4 text-primary" />
        <span class="text-sm font-semibold text-primary tracking-wide uppercase">Top Rated Digital Agency</span>
      </div>

      {/* Main Headline */}
      <h1 class="font-heading font-bold text-4xl sm:text-6xl md:text-7xl lg:text-8xl tracking-tighter leading-none lg:leading-[0.9] mb-8 select-none text-balance">
        <span class="block text-foreground">We Build</span>
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary via-accent to-primary bg-[length:200%_auto] animate-gradient block h-[1.1em]">
          {/* FIX: Hydrate the React component. 'client:visible' ensures it starts when user sees it. */}
          <TypewriterEffect 
            client:visible 
            words={words} 
            typingSpeed={80}
            deletingSpeed={50}
          />
        </span>
      </h1>

      {/* Subheadline */}
      <p class="max-w-2xl mx-auto text-lg md:text-xl text-muted-foreground leading-relaxed font-medium px-4 mb-10 text-pretty">
        We architect high-performance digital solutions for ambitious brands. 
        <span class="text-foreground font-semibold">Fast. Scalable. Beautiful.</span>
      </p>

      {/* CTA Buttons */}
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 w-full sm:w-auto">
        <a 
          href="/contact" 
          class={cn(
            buttonVariants({ size: "lg" }), 
            "h-14 px-8 text-lg font-bold shadow-lg shadow-primary/20 hover:scale-105 transition-all w-full sm:w-auto"
          )}
        >
          Start Project
          <Briefcase className="ml-2 h-5 w-5" aria-hidden="true" />
        </a>
        <a 
          href="/portfolio" 
          class={cn(
            buttonVariants({ size: "lg", variant: "outline" }), 
            "h-16 rounded-full px-10 text-xl font-bold tracking-wide bg-transparent border-2 hover:bg-foreground hover:text-background w-full sm:w-auto transition-all"
          )}
        >
          Our Work
          <ArrowRight className="ml-3 h-6 w-6" aria-hidden="true" />
        </a>
      </div>

      {/* Trusted By */}
      <div class="w-full pt-20 lg:pt-32 opacity-80 mix-blend-screen">
        <TrustedBy minimal={true} />
      </div>
    </div>
  </div>
</section>

<style>
  .animate-gradient {
    animation: gradient 8s linear infinite;
  }
  @keyframes gradient {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }
</style>