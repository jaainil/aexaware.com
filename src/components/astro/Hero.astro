---
import { buttonVariants } from "@/components/ui/button";
import { Briefcase, ArrowRight } from "lucide-astro";
import { cn } from "@/lib/utils";
import { InteractiveGridPattern } from "@/components/ui/interactive-grid-pattern";
import TrustedBy from "@/components/astro/TrustedBy.astro";
import Typewriter from "astro-typewriter";

---

<section class="relative overflow-hidden bg-background min-h-screen flex items-center justify-center pt-20">
  <InteractiveGridPattern
    client:idle
    className="absolute inset-0 z-0 opacity-40 text-primary/30 [mask-image:radial-gradient(ellipse_at_center,black_40%,transparent_100%)]"
    squares={[60, 40]}
    squaresClassName="hover:fill-primary/20"
  />

  <div class="container relative z-10 px-6 mx-auto text-center">
    <div class="max-w-4xl mx-auto space-y-6 md:space-y-8 text-center flex flex-col items-center">
      {/* Brand Logo or Icon (Optional based on image, but keeping simple for now if needed) */}
      
      {/* Main Headline */}
      <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl tracking-tight leading-tight text-foreground">
        <span class="font-serif italic font-medium">We Build</span>
        <br />
        <span class="font-sans font-bold text-primary inline-block min-h-[1.2em]">
          <Typewriter 
            messages={["Jamstack Apps","UI/UX Designs","Mobile Applications","Web Applications","E-Commerce Stores","Scalable AI Systems","Cloud Solutions"]} 
            writeSpeed={100}
            deleteSpeed={50}
            waitWritten={2000}
          />
        </span>
      </h1>

      {/* Subheadline */}
      <p class="max-w-2xl mx-auto text-base md:text-lg lg:text-xl text-foreground/90 leading-relaxed font-medium px-4">
        From idea to launch — web, mobile & AI systems designed for startups and enterprises that need to grow fast.
      </p>

      {/* CTA Buttons */}
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 w-full sm:w-auto pt-2 md:pt-4">
        <a 
          href="/contact" 
          class={cn(
            buttonVariants({ size: "lg" }), 
            "h-12 md:h-14 rounded-full px-8 text-base md:text-lg shadow-xl z-20 relative transition-all duration-300 hover:scale-[1.02] w-full sm:w-auto"
          )}
        >
          <Briefcase className="mr-2 h-5 w-5" />
          Book Free Strategy Call
        </a>
        <a 
          href="/portfolio" 
          class={cn(
            buttonVariants({ size: "lg", variant: "outline" }), 
            "h-12 md:h-14 rounded-full px-8 text-base md:text-lg bg-background/50 backdrop-blur-sm border-primary/20 hover:bg-accent/50 z-20 relative transition-all duration-300 hover:scale-[1.02] w-full sm:w-auto"
          )}
        >
          View Portfolio
          <ArrowRight className="ml-2 h-5 w-5" />
        </a>
      </div>
      {/* Social Proof */}
      <div class="w-full pt-4 md:pt-8">
        <TrustedBy minimal={true} />
      </div>
    </div>
  </div>
</section>
