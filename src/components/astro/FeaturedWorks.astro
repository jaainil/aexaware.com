---
import { buttonVariants } from "@/components/ui/button-variants";
import { ArrowUpRight, ArrowRight, Sparkles } from "lucide-astro";
import { Image } from "astro:assets";
import { cn } from "@/lib/utils";
import { getCollection } from "astro:content";

// Auto-fetch latest 5 portfolio entries, sorted by date (newest first)
// Layout: 1 featured (spans 2 cols) + 4 regular = balanced 2-column grid
const allProjects = await getCollection("portfolio");
const projects = allProjects
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 5);
---


<section class="section-padding bg-background relative overflow-hidden" aria-labelledby="featured-works-heading">
  
  {/* Subtle grid background */}
  <div class="absolute inset-0 bg-[linear-gradient(to_right,hsl(var(--foreground)/0.02)_1px,transparent_1px),linear-gradient(to_bottom,hsl(var(--foreground)/0.02)_1px,transparent_1px)] bg-[size:32px_32px] pointer-events-none" />

  <div class="container-normal relative z-10">
    
    {/* Header */}
    <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-16 gap-8">
      <div class="max-w-2xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-primary/20 bg-primary/5 text-primary text-xs font-semibold uppercase tracking-wider mb-6">
          <Sparkles className="w-3 h-3" />
          Our Work
        </div>
        <h2 id="featured-works-heading" class="font-heading text-4xl md:text-6xl font-bold leading-tight tracking-tight text-foreground mb-4">
          Real Projects. <br/>
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-accent font-serif">Real Results.</span>
        </h2>
        <p class="text-xl text-muted-foreground max-w-lg">
          We don't use stock photos. These are actual websites and applications we've built for real clients.
        </p>
      </div>
      
      <a 
        href="/portfolio" 
        class={cn(buttonVariants({ variant: "outline", size: "lg" }), "group text-base font-semibold rounded-full px-6")}
      >
        View All Work <ArrowRight className="ml-2 h-5 w-5 transition-transform group-hover:translate-x-1" />
      </a>
    </div>

    {/* Bento Grid */}
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {projects.map((project, i) => (
        <a 
          href={`/portfolio/${project.id}`}
          class={cn(
            "group relative overflow-hidden rounded-card-lg border border-border/40 bg-card/30 backdrop-blur-sm transition-all duration-500 hover:border-primary/50 hover:shadow-2xl block",
            i === 0 ? "md:col-span-2 aspect-[16/9]" : "aspect-[4/3]"
          )}
        >
          {/* Project Image */}
          <Image
            src={project.data.image}
            alt={`${project.data.title} - ${project.data.category}`}
            widths={[400, 800, 1200]}
            sizes={i === 0 ? "(max-width: 768px) 100vw, 1200px" : "(max-width: 768px) 100vw, 600px"}
            format="webp"
            quality={85}
            class="w-full h-full object-cover object-top transition-transform duration-700 group-hover:scale-105"
          />
          
          {/* Gradient Overlay - Strong contrast for text readability */}
          <div class="absolute inset-0 bg-gradient-to-t from-background via-background/80 to-background/20 transition-opacity" />
          
          {/* Content Overlay */}
          <div class="absolute bottom-0 left-0 right-0 p-6 md:p-8">
            <div class="flex flex-wrap gap-2 mb-4">
              {project.data.technologies.slice(0, 3).map((tech) => (
                <span class="px-2.5 py-1 text-xs font-semibold bg-secondary/90 backdrop-blur-sm rounded-full text-foreground border border-border/50">
                  {tech}
                </span>
              ))}
            </div>
            
            <div class="flex items-end justify-between gap-4">
              <div>
                <p class="text-sm text-primary font-medium mb-1">{project.data.category}</p>
                <h3 class="font-heading text-2xl md:text-3xl font-bold text-foreground tracking-tight">
                  {project.data.title}
                </h3>
              </div>
              
              <div class="h-12 w-12 rounded-full bg-primary flex items-center justify-center text-primary-foreground opacity-0 translate-y-4 group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-300 shrink-0 shadow-lg">
                <ArrowUpRight className="h-5 w-5" />
              </div>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
