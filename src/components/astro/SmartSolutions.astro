---
import { buttonVariants } from "@/components/ui/button-variants";
import { ArrowUpRight, ShieldCheck, Zap, Users, Gauge } from "lucide-astro";
import { Image } from "astro:assets";
import smartSolutionsImg from "@/assets/smart-solutions.jpg";
import { cn } from "@/lib/utils";

const items = [
  { text: "Elite IT Talent", icon: Users },
  { text: "Enterprise-Grade Security", icon: ShieldCheck },
  { text: "24/7 Dedicated Support", icon: Zap },
  { text: "High-Performance Arch", icon: Gauge },
];
---

<section class="section-padding bg-background overflow-hidden relative">
  <div class="container-normal">
    <div class="grid lg:grid-cols-2 gap-16 lg:gap-24 items-center">
      {/* Left Image Visual */}
      <div class="relative order-2 lg:order-1">
        <div
          class="relative h-[600px] w-full rounded-section overflow-hidden border border-border/50 shadow-2xl group"
        >
          <Image
            src={smartSolutionsImg}
            alt="IT Professional"
            width={800}
            height={1000}
            format="webp"
            class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
          />

          {/* Overlay Card */}
          <div
            class="absolute bottom-8 left-8 right-8 bg-background/80 backdrop-blur-md p-6 rounded-2xl border border-border/50 shadow-lg"
          >
            <div class="flex items-center gap-4">
              <div
                class="h-12 w-12 rounded-full bg-primary flex items-center justify-center text-primary-foreground shrink-0"
              >
                <ShieldCheck className="w-6 h-6" />
              </div>
              <div>
                <p class="font-bold text-foreground">ISO Certified</p>
                <p class="text-xs text-muted-foreground">
                  Security & Quality Standards
                </p>
              </div>
            </div>
          </div>
        </div>

        {/* Decor */}
        <div
          class="absolute -top-12 -left-12 h-64 w-64 bg-primary/20 rounded-full blur-[80px] -z-10"
        >
        </div>
      </div>

      {/* Right Content */}
      <div class="order-1 lg:order-2">
        <h2
          class="font-heading text-4xl md:text-6xl font-bold leading-[1.1] mb-8 text-foreground tracking-tight"
        >
          Smart Solutions. <br />
          <span
            class="text-transparent bg-clip-text bg-linear-to-r from-primary to-accent font-serif"
            >Secure Scale.</span
          >
        </h2>
        <p class="text-xl text-muted-foreground mb-12 leading-relaxed">
          We don't just build software; we build the backbone of your future
          business. Robust, scalable, and ready for anything.
        </p>

        {/* Semantic List */}
        <ul class="grid sm:grid-cols-2 gap-x-8 gap-y-6 mb-12">
          {
            items.map((item) => (
              <li class="flex items-start gap-4 p-4 rounded-xl hover:bg-secondary/30 transition-colors duration-300">
                <div class="mt-1">
                  <item.icon className="h-6 w-6 text-primary" strokeWidth={2} />
                </div>
                <span class="font-medium text-lg text-foreground">
                  {item.text}
                </span>
              </li>
            ))
          }
        </ul>

        <a
          href="/contact"
          class={cn(
            buttonVariants(),
            "rounded-full text-lg px-8 h-14 shadow-lg shadow-primary/25 hover:shadow-primary/40 transition-all",
          )}
        >
          Partner With Us <ArrowUpRight
            className="ml-2 h-5 w-5"
            aria-hidden="true"
          />
        </a>
      </div>
    </div>
  </div>
</section>
