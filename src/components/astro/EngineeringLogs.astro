---
import { getCollection } from "astro:content";
import { ArrowRight, BookOpen, Calendar, User } from "lucide-astro";
import { Image } from "astro:assets";

// Fetch all blog posts
const allPosts = await getCollection("blog");

// Sort by date (newest first) and take the top 3
const latestPosts = allPosts
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

// Function to format date
const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat("en-US", {
    month: "long",
    day: "numeric",
    year: "numeric",
  }).format(date);
};
---

<section
  class="section-padding bg-background border-t border-border/40 relative"
>
  <div class="container-normal">
    {/* Section Header */}
    <div
      class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12"
    >
      <div class="max-w-2xl">
        <div
          class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-primary/20 bg-primary/5 text-primary text-xs font-semibold uppercase tracking-wider mb-4"
        >
          <BookOpen className="w-3 h-3" />
          Engineering Logs
        </div>
        <h2
          class="font-heading text-3xl md:text-5xl font-bold text-foreground mb-4"
        >
          Insights from the <span class="text-primary font-serif"
            >Trenches.</span
          >
        </h2>
        <p class="text-lg text-muted-foreground leading-relaxed">
          Technical deep dives, architectural decisions, and lessons learned
          from building scalable software.
        </p>
      </div>
      <a
        href="/blog"
        class="hidden md:inline-flex items-center text-primary font-medium hover:text-primary/80 transition-colors"
      >
        View all articles <ArrowRight className="ml-2 w-4 h-4" />
      </a>
    </div>

    {/* Blog Grid */}
    <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      {
        latestPosts.map((post) => (
          <a
            href={`/blog/${post.slug}`}
            class="group flex flex-col bg-card border border-border/50 rounded-card-lg overflow-hidden hover:border-primary/30 hover:shadow-lg transition-all duration-300 transform hover:-translate-y-1 h-full"
          >
            {/* Image */}
            <div class="relative aspect-video overflow-hidden bg-secondary">
              {post.data.image ? (
                <Image
                  src={post.data.image}
                  alt={post.data.title}
                  width={600}
                  height={338}
                  layout="none"
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
              ) : (
                <div class="w-full h-full flex items-center justify-center bg-secondary/30 text-muted-foreground">
                  <BookOpen className="w-12 h-12 opacity-20" />
                </div>
              )}
              <div class="absolute inset-0 bg-linear-to-t from-background/80 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300" />
            </div>

            {/* Content */}
            <div class="flex flex-col grow p-6">
              <div class="flex items-center justify-between text-xs text-muted-foreground mb-4">
                <div class="flex items-center gap-1.5">
                  <Calendar className="w-3.5 h-3.5" />
                  <time datetime={post.data.date.toString()}>
                    {formatDate(post.data.date)}
                  </time>
                </div>
              </div>

              <h3 class="font-heading text-xl font-bold text-foreground mb-3 line-clamp-2 group-hover:text-primary transition-colors">
                {post.data.title}
              </h3>

              <p class="text-muted-foreground text-sm leading-relaxed mb-6 line-clamp-3 flex-grow">
                {post.data.description}
              </p>

              <div class="flex items-center justify-between mt-auto pt-4 border-t border-border/40">
                <div class="flex items-center gap-2 text-xs font-medium text-muted-foreground">
                  <User className="w-3.5 h-3.5" />
                  {post.data.author}
                </div>
                <span class="text-sm font-semibold text-primary flex items-center gap-1 group-hover:translate-x-1 transition-transform">
                  Read <ArrowRight className="w-3.5 h-3.5" />
                </span>
              </div>
            </div>
          </a>
        ))
      }
    </div>

    <div class="mt-10 text-center md:hidden">
      <a
        href="/blog"
        class="inline-flex items-center text-primary font-medium hover:text-primary/80 transition-colors"
      >
        View all articles <ArrowRight className="ml-2 w-4 h-4" />
      </a>
    </div>
  </div>
</section>
