---
import IndustriesMarquee from "@/components/react/IndustriesMarquee";

const industries = [
  "Finance & Banking",
  "E-Commerce & Retail",
  "Education & Learning",
  "Health Care & Life Insurance",
  "Manufacturing & Logistics",
  "Government & Public Sector",
  "Telecommunications",
  "Energy & Utilities",
  "Travel & Hospitality",
  "Media & Entertainment",
];

const firstRow = industries.slice(0, Math.ceil(industries.length / 2));
const secondRow = industries.slice(Math.ceil(industries.length / 2));
---

<section class="section-padding border-y border-border/40 bg-secondary/10 overflow-hidden relative">
  
  {/* Modern gradient background */}
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_center,_var(--tw-gradient-stops))] from-primary/5 via-background to-background pointer-events-none" />

  <div class="container-normal mb-16 relative z-10 text-center">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-primary/20 bg-primary/5 mb-4 backdrop-blur-sm">
      <span class="text-xs font-semibold text-primary uppercase tracking-widest">Global Impact</span>
    </div>
    <h2 class="font-heading text-4xl md:text-5xl font-bold leading-tight text-foreground max-w-3xl mx-auto">
      Driving <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-accent italic font-serif">Innovation</span> Across Industries
    </h2>
    <p class="mt-6 text-xl text-muted-foreground max-w-2xl mx-auto">
      Tailored strategies and robust tech infrastructure for every sector.
    </p>
  </div>

  <div class="flex flex-col gap-10 relative z-10">
    {/* NOTE: I removed the absolute "Fade Masks" from here. 
        They are now handled inside the React component so they rotate correctly with the marquee.
    */}

    <div class="-rotate-1 hover:rotate-0 transition-transform duration-700 ease-out will-change-transform">
      <IndustriesMarquee 
        client:visible 
        items={firstRow} 
        speed={40}
      />
    </div>

    <div class="rotate-1 hover:rotate-0 transition-transform duration-700 ease-out will-change-transform">
      <IndustriesMarquee 
        client:visible 
        items={secondRow} 
        direction="right" 
        speed={40}
      />
    </div>
  </div>
</section>