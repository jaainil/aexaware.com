---
const industries = [
  "Finance & Banking",
  "E-Commerce & Retail",
  "Education & Learning",
  "Health Care & Life Insurance",
  "Manufacturing & Logistics",
  "Government & Public Sector",
  "Telecommunications",
  "Energy & Utilities",
  "Travel & Hospitality",
  "Media & Entertainment",
];

const firstRow = industries.slice(0, Math.ceil(industries.length / 2));
const secondRow = industries.slice(Math.ceil(industries.length / 2));

import IndustriesMarquee from "@/components/IndustriesMarquee";
---

<section class="py-24 border-y border-border/40 bg-secondary/10 overflow-hidden relative">
  
  {/* Modern gradient background */}
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_center,_var(--tw-gradient-stops))] from-primary/5 via-background to-background pointer-events-none" />

  <div class="container mx-auto px-6 lg:px-8 mb-16 relative z-10 text-center">
    <span class="text-sm font-semibold text-primary uppercase tracking-widest mb-3 block">Global Impact</span>
    <h2 class="text-4xl md:text-5xl font-bold leading-tight text-foreground max-w-3xl mx-auto">
      Driving Innovation Across Industries
    </h2>
    <p class="mt-6 text-xl text-muted-foreground max-w-2xl mx-auto">
      Tailored strategies and robust tech infrastructure for every sector.
    </p>
  </div>

  <div class="flex flex-col gap-10 relative z-10">
    
    {/* Fade Masks */}
    <div class="absolute inset-y-0 left-0 w-24 md:w-64 bg-gradient-to-r from-background to-transparent z-20 pointer-events-none" />
    <div class="absolute inset-y-0 right-0 w-24 md:w-64 bg-gradient-to-l from-background to-transparent z-20 pointer-events-none" />

    <!-- First Row -->
    <div class="-rotate-1 hover:rotate-0 transition-transform duration-700">
      <IndustriesMarquee 
        client:visible 
        items={firstRow} 
        speed={40}
      />
    </div>

    <!-- Second Row - Offset -->
    <div class="rotate-1 hover:rotate-0 transition-transform duration-700">
      <IndustriesMarquee 
        client:visible 
        items={secondRow} 
        direction="right" 
        speed={40}
      />
    </div>
  </div>
</section>
