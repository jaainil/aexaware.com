---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { ArrowRight } from 'lucide-astro';

interface Props {
  currentSlug: string;
  tags?: string[];
}

const { currentSlug, tags } = Astro.props;

// Get all posts
const allPosts = await getCollection('blog');

// detailed relevance scoring
const scoredPosts = allPosts
  .filter(post => post.slug !== currentSlug) // Exclude current post
  .map(post => {
    let score = 0;
    // Check for tag overlap
    if (tags && post.data.tags) {
      const overlap = post.data.tags.filter(tag => tags.includes(tag)).length;
      score += overlap;
    }
    return { post, score };
  })
  .sort((a, b) => b.score - a.score); // Sort by score descending

// Take top 1, fallback to just the most recent one if no tags match
const fallbackPost = allPosts.find(p => p.slug !== currentSlug);
const nextPost = scoredPosts[0]?.post ?? fallbackPost;
---

{nextPost && (
  <div class="border-t border-border/40 mt-16 pt-12 mb-12">
    <p class="text-sm font-medium text-muted-foreground uppercase tracking-wider mb-6">
      Read Next
    </p>
    <a href={`/blog/${nextPost.slug}`} class="group block">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
        <div class="space-y-4 order-2 md:order-1">
          <h3 class="font-serif text-3xl font-medium text-foreground group-hover:text-primary transition-colors leading-tight">
            {nextPost.data.title}
          </h3>
          <p class="text-muted-foreground line-clamp-2">
            {nextPost.data.description}
          </p>
          <div class="flex items-center text-primary font-medium mt-4">
            Read article <ArrowRight className="ml-2 h-4 w-4 transition-transform group-hover:translate-x-1" />
          </div>
        </div>
        {nextPost.data.image && (
          <div class="aspect-video rounded-3xl overflow-hidden bg-muted order-1 md:order-2">
            <Image
              src={nextPost.data.image}
              alt={nextPost.data.title}
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              width={600}
              height={338}
            />
          </div>
        )}
      </div>
    </a>
  </div>
)}
