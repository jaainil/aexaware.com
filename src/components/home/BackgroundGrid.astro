---
import { cn } from "@/lib/utils";

interface Props {
  /**
   * Grid density preset
   * - sm: 14×24px (hero sections, page headers)
   * - md: 24×24px (service sections, content areas)
   * - lg: 32×40px (CTA, featured works)
   * @default "sm"
   */
  density?: "sm" | "md" | "lg";

  /**
   * Grid line opacity (0.01 - 0.1)
   * @default 0.03
   */
  opacity?: number;

  /**
   * Use fixed positioning (for full-page backgrounds)
   * @default false
   */
  fixed?: boolean;

  /**
   * Radial gradient mask type
   * - top: Fades from top
   * - bottom: Fades from bottom
   * - left: Fades from left
   * - right: Fades from right
   * - center: Fades from center
   * - edges: Fades all edges (vignette effect)
   * - none: No mask (full grid)
   * @default "none"
   */
  mask?: "top" | "bottom" | "left" | "right" | "center" | "edges" | "none";

  /**
   * Color variant for different backgrounds
   * - dark: Uses foreground color (for light backgrounds)
   * - light: Uses white (for dark/primary backgrounds)
   * @default "dark"
   */
  variant?: "dark" | "light";

  /**
   * Additional CSS classes
   */
  class?: string;
}

const {
  density = "sm",
  opacity = 0.05,
  fixed = false,
  mask = "none",
  variant = "dark",
  class: className,
} = Astro.props;

// Grid size presets
const gridSizes = {
  sm: "14px_24px",
  md: "24px_24px",
  lg: "32px_40px",
};

// Mask gradient presets
const maskStyles = {
  top: "mask-[radial-gradient(ellipse_60%_50%_at_50%_0%,var(--color-foreground)_70%,transparent_100%)]",
  bottom:
    "mask-[radial-gradient(ellipse_60%_50%_at_50%_100%,var(--color-foreground)_70%,transparent_100%)]",
  left: "mask-[radial-gradient(ellipse_50%_60%_at_0%_50%,var(--color-foreground)_70%,transparent_100%)]",
  right:
    "mask-[radial-gradient(ellipse_50%_60%_at_100%_50%,var(--color-foreground)_70%,transparent_100%)]",
  center:
    "mask-[radial-gradient(ellipse_60%_50%_at_50%_50%,var(--color-foreground)_70%,transparent_100%)]",
  edges:
    "mask-[radial-gradient(ellipse_80%_80%_at_50%_50%,var(--color-foreground)_50%,transparent_100%)]",
  none: "",
};

// Color based on variant
const gridColor =
  variant === "light"
    ? `rgba(255,255,255,${opacity})`
    : `color-mix(in srgb, var(--color-foreground) ${opacity * 100}%, transparent)`;

const gridSize = gridSizes[density];
const maskClass = maskStyles[mask];
---

<div
  class={cn(
    fixed ? "fixed" : "absolute",
    "inset-0 pointer-events-none",
    maskClass,
    className,
  )}
  style={`background-image: linear-gradient(to right, ${gridColor} 1px, transparent 1px), linear-gradient(to bottom, ${gridColor} 1px, transparent 1px); background-size: ${gridSize.replace("_", " ")};`}
  aria-hidden="true"
>
</div>
