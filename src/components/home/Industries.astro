---
const industries = [
  "Finance & Banking",
  "E-Commerce & Retail",
  "Education & Learning",
  "Health Care & Life Insurance",
  "Manufacturing & Logistics",
  "Government & Public Sector",
  "Telecommunications",
  "Energy & Utilities",
  "Travel & Hospitality",
  "Media & Entertainment",
];

const firstRow = industries.slice(0, Math.ceil(industries.length / 2));
const secondRow = industries.slice(Math.ceil(industries.length / 2));

// ponytail: pure-CSS marquee, mirrors TechStackMarquee.astro — drops the react-fast-marquee island.
const loop = (row: string[]) => [...row, ...row, ...row, ...row];
---

<section
  class="section-padding border-y border-border/40 bg-background overflow-hidden relative"
>
  <div class="container-normal mb-16 relative z-10 text-center">
    <div
      class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-primary/20 bg-primary/5 mb-4 backdrop-blur-xs"
    >
      <span class="text-xs font-semibold text-primary uppercase tracking-widest"
        >Global Impact</span
      >
    </div>
    <h2
      class="font-heading text-4xl md:text-5xl font-bold leading-tight text-foreground max-w-3xl mx-auto"
    >
      Driving <span class="text-primary font-serif">Innovation</span> Across Industries
    </h2>
    <p class="mt-6 text-xl text-muted-foreground max-w-2xl mx-auto">
      Tailored strategies and robust tech infrastructure for every sector.
    </p>
  </div>

  <div class="flex flex-col gap-10 relative z-10">
    <div
      class="-rotate-1 hover:rotate-0 transition-transform duration-700 ease-out will-change-transform"
    >
      <div
        class="relative flex overflow-hidden mask-[linear-gradient(to_right,transparent,black_10%,black_90%,transparent)] py-4"
      >
        <div class="flex animate-marquee min-w-full items-center">
          {
            loop(firstRow).map((name) => (
              <div class="mx-3 px-6 md:px-8 py-3 rounded-full text-sm md:text-base font-medium whitespace-nowrap shadow-xs border border-border/50 bg-background/50 backdrop-blur-md text-foreground/80 hover:text-primary transition-all duration-300 hover:bg-secondary/80 hover:border-primary/20 cursor-default select-none shrink-0">
                {name}
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <div
      class="rotate-1 hover:rotate-0 transition-transform duration-700 ease-out will-change-transform"
    >
      <div
        class="relative flex overflow-hidden mask-[linear-gradient(to_right,transparent,black_10%,black_90%,transparent)] py-4"
      >
        <div class="flex animate-marquee-reverse min-w-full items-center">
          {
            loop(secondRow).map((name) => (
              <div class="mx-3 px-6 md:px-8 py-3 rounded-full text-sm md:text-base font-medium whitespace-nowrap shadow-xs border border-border/50 bg-background/50 backdrop-blur-md text-foreground/80 hover:text-primary transition-all duration-300 hover:bg-secondary/80 hover:border-primary/20 cursor-default select-none shrink-0">
                {name}
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .animate-marquee {
    animation: marquee 40s linear infinite;
  }

  .animate-marquee-reverse {
    animation: marquee 40s linear infinite reverse;
  }

  @keyframes marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  .animate-marquee:hover,
  .animate-marquee-reverse:hover {
    animation-play-state: paused;
  }
</style>
