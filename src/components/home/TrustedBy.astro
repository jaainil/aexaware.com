---
import { Image } from "astro:assets";
// Ensure these images actually exist in src/assets/ or the build will fail!
import partner1 from "@/assets/1.png";
import partner2 from "@/assets/2.png";
import partner3 from "@/assets/3.png";
import partner4 from "@/assets/4.png";
import partner5 from "@/assets/5.png";

const companies = [
  { name: "Partner 1", logo: partner1 },
  { name: "Partner 2", logo: partner2 },
  { name: "Partner 3", logo: partner3 },
  { name: "Partner 4", logo: partner4 },
  { name: "Partner 5", logo: partner5 },
];

interface Props {
  minimal?: boolean;
}

const { minimal = false } = Astro.props;
---

{/* Minimal version (for Hero) */}
{
  minimal && (
    <div class="mt-4 md:mt-8 border-t border-border/20 pt-8">
      <p class="text-sm font-medium text-muted-foreground uppercase tracking-widest mb-6 select-none">
        Partnering with ambitious brands
      </p>
      <div class="relative z-10 flex flex-wrap justify-center items-center gap-8 md:gap-12 opacity-80 select-none">
        {companies.map((company) => (
          <Image
            src={company.logo}
            alt={`${company.name} logo`}
            width={140}
            height={40}
            class="h-8 md:h-10 w-auto object-contain grayscale hover:grayscale-0 transition-all duration-300"
            loading="eager"
          />
        ))}
      </div>
    </div>
  )
}

{/* Full version (Standalone) */}
{
  !minimal && (
    <section class="py-12 border-b border-border/40 bg-secondary/5">
      <div class="container-normal text-center">
        <p class="text-sm font-medium text-muted-foreground uppercase tracking-widest mb-8 select-none">
          Partnering with ambitious brands
        </p>
        <div class="flex flex-wrap justify-center items-center gap-8 md:gap-16 select-none">
          {companies.map((company) => (
            <Image
              src={company.logo}
              alt={`${company.name} logo`}
              width={200}
              height={80}
              class="h-16 md:h-20 w-auto object-contain opacity-60 grayscale hover:grayscale-0 hover:opacity-100 transition-all duration-300"
              loading="lazy"
            />
          ))}
        </div>
      </div>
    </section>
  )
}
