---
/**
 * Prose - Reusable Tailwind Typography wrapper for Markdown content
 * Provides consistent styling for rendered Markdown across blog and portfolio pages
 */
import { cn } from "@/lib/utils";

interface Props {
  /**
   * Size variant for the prose content
   * @default "default"
   */
  size?: "default" | "lg" | "xl";
  /**
   * Additional CSS classes
   */
  class?: string;
}

const { size = "default", class: className } = Astro.props;

const sizeClasses = {
  default: "prose",
  lg: "prose prose-lg",
  xl: "prose prose-lg md:prose-xl",
};
---

<div
  class={cn(
    sizeClasses[size],
    "dark:prose-invert max-w-none",
    // Headings - match global.css base styles
    "prose-headings:font-heading prose-headings:font-bold prose-headings:tracking-tight prose-headings:text-foreground",
    "prose-h1:text-4xl prose-h1:leading-[1.1] prose-h2:text-3xl prose-h2:leading-[1.2] prose-h2:mt-12 prose-h2:mb-6 prose-h3:leading-[1.3]",
    // Paragraphs - match global.css base p styles
    "prose-p:text-muted-foreground prose-p:leading-[1.625] prose-p:text-base",
    // Lists
    "prose-ul:font-sans prose-ol:font-sans prose-li:font-sans prose-li:text-base prose-li:leading-[1.625]",
    "prose-li:text-muted-foreground prose-li:marker:text-muted-foreground",
    // Strong/Bold
    "prose-strong:text-foreground prose-strong:font-semibold",
    // Links
    "prose-a:text-primary prose-a:font-medium prose-a:no-underline hover:prose-a:underline",
    // Images (now responsive with Astro config)
    "prose-img:rounded-card-lg prose-img:shadow-xl prose-img:border prose-img:border-border/50",
    // Blockquotes
    "prose-blockquote:border-l-4 prose-blockquote:border-primary prose-blockquote:bg-secondary/20",
    "prose-blockquote:py-4 prose-blockquote:px-8 prose-blockquote:rounded-r-2xl prose-blockquote:italic",
    // Inline Code
    "prose-code:bg-muted prose-code:text-primary prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:text-[0.875em]",
    "prose-code:before:content-none prose-code:after:content-none prose-code:wrap-break-word",
    // Pre (code blocks)
    "prose-pre:bg-(--shiki-dark-bg) prose-pre:border prose-pre:border-border/50",
    // Tables - styled via scoped CSS below to enable scroll wrapper
    "prose-th:font-heading prose-th:font-semibold prose-th:text-foreground prose-th:tracking-tight prose-th:bg-secondary/30",
    "prose-th:border prose-th:border-border prose-th:px-4 prose-th:py-3",
    "prose-td:border prose-td:border-border prose-td:px-4 prose-td:py-3 prose-td:text-muted-foreground prose-td:text-sm",
    className,
  )}
>
  <slot />
</div>

<style>
  div :global(.table-scroll-wrapper) {
    display: block;
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  div :global(table) {
    display: table;
    width: 100%;
    margin: 0;
    border-collapse: collapse;
    font-size: 0.875rem;
  }
</style>

<script>
  // Wrap every table in a scroll div for overflow + border-radius
  document.querySelectorAll(".prose table").forEach((table) => {
    if (table.parentElement?.classList.contains("table-scroll-wrapper")) return;
    const wrapper = document.createElement("div");
    wrapper.className = "table-scroll-wrapper";
    table.parentNode?.insertBefore(wrapper, table);
    wrapper.appendChild(table);
  });
</script>
