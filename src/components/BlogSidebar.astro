---
import { buttonVariants } from "@/components/ui/button-variants";
import { ArrowUpRight, Sparkles } from "lucide-astro";
import TableOfContents from "./TableOfContents.astro";
import BlogEngagement from "./BlogEngagement.astro";
import type { MarkdownHeading } from "astro";

interface Props {
  headings: MarkdownHeading[];
  url?: string;
  title?: string;
}

const { headings, url, title } = Astro.props;
---

<aside class="space-y-8 sticky top-32 h-fit">
  
  {/* Table of Contents - Glass Card */}
  <div class="hidden lg:block rounded-[2rem] bg-card/30 backdrop-blur-md p-8 border border-border/50 shadow-sm">
    <TableOfContents headings={headings} />
  </div>

  {/* Engagement Actions (Summary & Share) - Glass Card */}
  <div class="rounded-[2rem] bg-card/30 backdrop-blur-md p-6 border border-border/50 shadow-sm">
      <h3 class="font-heading font-bold text-lg mb-4 flex items-center gap-2 text-foreground/80">
          <Sparkles class="size-4 text-primary" />
          AI & Share
      </h3>
      <BlogEngagement url={url} title={title} vertical />
  </div>

  {/* CTA Card */}
  <div class="relative overflow-hidden rounded-[2rem] bg-gradient-to-br from-primary/10 to-primary/5 p-8 border border-primary/20 shadow-lg group">
    <div class="absolute inset-0 bg-primary/5 opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none" />
    <div class="relative z-10">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 text-primary text-xs font-bold uppercase tracking-wider mb-4">
            <Sparkles class="size-3" />
            Partner with us
        </div>
        <h3 class="font-heading font-bold text-2xl text-foreground mb-3 leading-tight">
          Build your next big idea
        </h3>
        <p class="text-muted-foreground mb-6 leading-relaxed">
          Turn your vision into reality with our expert development team.
        </p>
        <a 
          href="/contact" 
          class={buttonVariants({ className: "w-full rounded-xl h-12 text-base font-semibold shadow-md group-hover:shadow-primary/25 transition-all" })}
        >
          Start Project <ArrowUpRight className="ml-2 h-4 w-4" />
        </a>
    </div>
  </div>

</aside>