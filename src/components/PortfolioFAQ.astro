---
import { ChevronDown } from "lucide-astro";

interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  faqs: FAQItem[];
}

const { faqs } = Astro.props;
---

<div class="w-full space-y-4">
  {faqs.map((faq, index) => (
    <div class="border-b border-white/10 last:border-0">
      <details class="group">
        <summary class="flex flex-1 items-center justify-between py-6 font-medium transition-all cursor-pointer list-none text-lg text-left text-foreground hover:text-primary">
          {faq.question}
          <div class="shrink-0 transition-transform duration-300 group-open:rotate-180">
             <ChevronDown className="h-5 w-5 text-muted-foreground" />
          </div>
        </summary>
        <div class="overflow-hidden text-muted-foreground leading-relaxed text-base pb-6 animate-in slide-in-from-top-1 fade-in duration-300">
          <p class="max-w-3xl">
             {faq.answer}
          </p>
        </div>
      </details>
    </div>
  ))}
</div>

<style>
  details > summary {
    list-style: none;
  }
  details > summary::-webkit-details-marker {
    display: none;
  }
</style>
