---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;

// Filter out h1 (title) and distinct headings
const toc = headings.filter((h) => h.depth >= 1 && h.depth <= 4);
---

<nav class="toc-container text-sm">
  {/* FIX: Use font-heading for the title */}
  <h3 class="font-heading font-bold text-foreground mb-6 uppercase tracking-widest text-xs">On this page</h3>
  <ul class="space-y-1 relative">
    {/* Track Line */}
    <div class="absolute left-0 top-2 bottom-2 w-0.5 bg-border rounded-full" />
    
    {toc.map((heading) => (
      <li>
        <a
          href={`#${heading.slug}`}
          class={`block py-1.5 transition-all duration-300 border-l-2 leading-relaxed hover:text-primary ${
            heading.depth === 1 ? "pl-4 font-medium" : heading.depth === 3 ? "pl-8 text-xs" : heading.depth === 4 ? "pl-10 text-xs" : "pl-6"
          } text-muted-foreground border-transparent hover:border-primary/30`}
        >
          {heading.text}
        </a>
      </li>
    ))}
  </ul>
</nav>

<script>
  function initTOC() {
    const tocLinks = document.querySelectorAll('.toc-container a');
    const headings = document.querySelectorAll('article h1, article h2, article h3, article h4'); // Scope to article to avoid sidebar/footer collisions
    
    if (headings.length === 0) return;

    const observerCallback = (entries: IntersectionObserverEntry[]) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const id = entry.target.getAttribute('id');
          if (!id) return;

          // Remove active class from all links
          tocLinks.forEach(link => {
            link.classList.remove('text-primary', 'font-bold', 'border-primary');
            link.classList.add('text-muted-foreground', 'border-transparent');
          });

          // Add active class to current link
          const activeLink = document.querySelector(`.toc-container a[href="#${id}"]`);
          if (activeLink) {
            activeLink.classList.add('text-primary', 'font-bold', 'border-primary');
            activeLink.classList.remove('text-muted-foreground', 'border-transparent');
          }
        }
      });
    };

    const observer = new IntersectionObserver(observerCallback, {
      rootMargin: '-10% 0px -80% 0px' // Adjust margin to trigger "active" near the top of the viewport
    });

    headings.forEach((heading) => {
      observer.observe(heading);
    });
  }

  // Run on load
  initTOC();

  // Re-run on navigation (Astro View Transitions)
  document.addEventListener('astro:page-load', initTOC);
</script> 