---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;

// Filter out h1 (title) and distinct headings
const toc = headings.filter((h) => h.depth > 1 && h.depth <= 3);
---

<nav class="toc-container text-sm">
  <h3 class="font-bold text-foreground mb-6 uppercase tracking-widest text-xs">On this page</h3>
  <ul class="space-y-1 relative">
    {/* Track Line */}
    <div class="absolute left-0 top-2 bottom-2 w-0.5 bg-border rounded-full" />
    
    {toc.map((heading) => (
      <li>
        <a
          href={`#${heading.slug}`}
          class={`block py-1.5 transition-all duration-300 border-l-2 leading-relaxed hover:text-primary ${
            heading.depth === 3 ? "pl-8 text-xs" : "pl-6"
          } text-muted-foreground border-transparent hover:border-primary/30`}
        >
          {heading.text}
        </a>
      </li>
    ))}
  </ul>
</nav>

<script>
  // Robust Active State Highlighting
  const tocLinks = document.querySelectorAll('.toc-container a');
  const headings = document.querySelectorAll('h2, h3');
  
  const observerCallback = (entries: IntersectionObserverEntry[]) => {
    // 1. Update state of intersecting headings
    entries.forEach((entry) => {
      const id = entry.target.getAttribute('id');
      if (!id) return;
      
      const link = document.querySelector(`.toc-container a[href="#${id}"]`);
      if (link) {
        if (entry.isIntersecting) {
          link.classList.add('is-visible');
        } else {
          link.classList.remove('is-visible');
        }
      }
    });

    // 2. Find the *first* visible link in the TOC and make it active
    const links = Array.from(tocLinks);
    let activeLink: Element | null = null;

    // Find first visible link
    for (const link of links) {
        if (link.classList.contains('is-visible')) {
            activeLink = link;
            break;
        }
    }

    // If no link is visible, maybe keep the last one active or check scroll position?
    // For now, simpler is better.

    // Update classes
    links.forEach(link => {
       if (link === activeLink) {
           link.classList.add('text-primary', 'font-bold', 'border-primary');
           link.classList.remove('text-muted-foreground', 'border-transparent');
       } else {
           link.classList.remove('text-primary', 'font-bold', 'border-primary');
           link.classList.add('text-muted-foreground', 'border-transparent');
       }
    });
  };

  const observer = new IntersectionObserver(observerCallback, {
    rootMargin: '-100px 0px -66% 0px' 
  });

  headings.forEach((heading) => {
    observer.observe(heading);
  });
</script>
