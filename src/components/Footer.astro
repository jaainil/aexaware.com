---
import { buttonVariants } from "@/components/ui/button-variants";
import {
  Linkedin,
  Twitter,
  Instagram,
  GitBranch,
  Mail,
  Phone,
  MapPin,
  ArrowRight,
  ArrowUpRight,
} from "lucide-astro";
import Logo from "@/assets/logo 2.svg";

const currentYear = new Date().getFullYear();

const socialLinks = [
  { icon: Linkedin, label: "LinkedIn", href: "https://www.linkedin.com/company/107112329/" },
  { icon: Twitter, label: "X (Twitter)", href: "https://x.com/aexaware" },
  { icon: Instagram, label: "Instagram", href: "https://www.instagram.com/aexaware/" },
  { icon: GitBranch, label: "Codeberg", href: "https://codeberg.org/Aexaware" },
  { icon: Mail, label: "Email", href: "mailto:info@aexaware.com" },
];

const services = [
  { name: "Web Development", path: "/services/web-development" },
  { name: "App Development", path: "/services/mobile-development" },
  { name: "UI/UX Design", path: "/services/ui-ux-design" },
  { name: "Software Solutions", path: "/services/software-solutions" },
  { name: "E-com Development", path: "/services/ecommerce" },
  { name: "Cloud & DevOps", path: "/services/cloud-devops" },
  { name: "AI/ML Integration", path: "/services/ai-ml-integration" },
];

const companyLinks = ["About", "Portfolio", "Blog", "Contact"];
---

<footer class="relative border-t border-border/40 bg-background pt-24 pb-12 overflow-hidden">
  
  {/* Modern Grid Background */}
  <div class="absolute inset-0 bg-[linear-gradient(to_right,#8080800a_1px,transparent_1px),linear-gradient(to_bottom,#8080800a_1px,transparent_1px)] bg-[size:14px_24px] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)] pointer-events-none -z-10" />

  <div class="container mx-auto px-6 lg:px-8 relative z-10">
    
    {/* Pre-Footer CTAs - Cinematic Cards */}
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-24 pb-16 border-b border-border/40">
      <div class="relative overflow-hidden group bg-gradient-to-br from-secondary/30 to-background rounded-[2.5rem] p-8 md:p-12 border border-border/50">
        <div class="absolute inset-0 bg-primary/5 opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none" />
        <div class="relative z-10 flex flex-col items-start gap-6">
            <h3 class="font-bold text-3xl md:text-4xl text-foreground leading-tight">
                Start your project <br /> with confidence.
            </h3>
            <p class="text-muted-foreground text-lg max-w-sm">
                Get a custom quote tailored to your business needs and goals.
            </p>
            <a href="/start-project" class={buttonVariants({ size: "lg", className: "rounded-full px-8 h-12 text-base shadow-lg shadow-primary/20" })}>
                Get Started <ArrowUpRight className="ml-2 h-4 w-4" />
            </a>
        </div>
      </div>

      <div class="relative overflow-hidden group bg-gradient-to-br from-secondary/30 to-background rounded-[2.5rem] p-8 md:p-12 border border-border/50">
         <div class="absolute inset-0 bg-primary/5 opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none" />
        <div class="relative z-10 flex flex-col items-start gap-6">
            <h3 class="font-bold text-3xl md:text-4xl text-foreground leading-tight">
                Explore our <br /> success stories.
            </h3>
            <p class="text-muted-foreground text-lg max-w-sm">
                See how we've transformed other businesses with our tech.
            </p>
             <a href="/portfolio" class={buttonVariants({ variant: "outline", size: "lg", className: "rounded-full px-8 h-12 text-base bg-transparent border-primary/20 hover:bg-primary/5 hover:text-primary hover:border-primary/50" })}>
                View Portfolio <ArrowRight className="ml-2 h-4 w-4" />
            </a>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 gap-12 lg:grid-cols-12 mb-20">
      {/* Brand Section */}
      <div class="lg:col-span-4 space-y-8">
        <a href="/" class="block w-fit">
          <img
            src={Logo.src}
            alt="Aexaware Infotech"
            width="160"
            height="42"
            class="h-10 w-auto opacity-90 transition-opacity hover:opacity-100"
          />
        </a>
        <p class="text-muted-foreground leading-relaxed max-w-xs text-lg">
          Transforming ideas into cutting-edge digital experiences. <br />
          Built for growth.
        </p>
        <div class="flex gap-4">
          {socialLinks.map(({ icon: Icon, label, href }) => (
            <a
              href={href}
              aria-label={label}
              target={href.startsWith('http') ? "_blank" : undefined}
              rel={href.startsWith('http') ? "noopener noreferrer" : undefined}
              class="flex size-10 items-center justify-center rounded-full bg-secondary/50 text-muted-foreground transition-all duration-300 hover:bg-primary hover:text-primary-foreground hover:scale-110 border border-transparent hover:border-primary/20"
            >
              <Icon size={18} />
            </a>
          ))}
        </div>
      </div>

      {/* Services */}
      <div class="lg:col-span-3">
        <h4 class="font-bold text-foreground mb-8 text-lg">Services</h4>
        <ul class="space-y-4">
          {services.map((item) => (
            <li>
              <a
                href={item.path}
                class="group flex items-center text-muted-foreground hover:text-primary transition-colors text-base"
              >
                <span class="w-1.5 h-1.5 rounded-full bg-primary/50 mr-3 opacity-0 group-hover:opacity-100 transition-opacity" />
                <span class="transition-transform group-hover:translate-x-1">
                  {item.name}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      {/* Company */}
      <div class="lg:col-span-2">
        <h4 class="font-bold text-foreground mb-8 text-lg">Company</h4>
        <ul class="space-y-4">
          {companyLinks.map((item) => (
            <li>
              <a
                href={`/${item.toLowerCase().replace(" ", "")}`}
                class="group flex items-center text-muted-foreground hover:text-primary transition-colors text-base"
              >
                 <span class="w-1.5 h-1.5 rounded-full bg-primary/50 mr-3 opacity-0 group-hover:opacity-100 transition-opacity" />
                <span class="transition-transform group-hover:translate-x-1">
                  {item}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      {/* Newsletter */}
      <div class="lg:col-span-3 space-y-8">
        <div>
          <h4 class="font-bold text-foreground mb-8 text-lg">Stay Updated</h4>
          <div class="rounded-[1.5rem] bg-secondary/30 p-6 border border-border/50 backdrop-blur-sm">
            <p class="text-sm text-muted-foreground mb-4 leading-relaxed">
              Get the latest tech trends and insights delivered to your inbox.
            </p>
            <form class="flex flex-col gap-3" action="/api/newsletter" method="POST">
              <input 
                type="email" 
                name="email"
                placeholder="Enter your email"
                required
                class="w-full h-10 px-4 rounded-xl bg-background border border-border/50 text-sm focus:outline-none focus:ring-2 focus:ring-primary/50 transition-all placeholder:text-muted-foreground/50"
              />
              <button
                type="submit"
                class={buttonVariants({ className: "w-full rounded-xl h-10 text-sm font-semibold" })}
              >
                Subscribe
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>

    {/* Footer Bottom */}
    <div class="pt-8 border-t border-border/40 flex flex-col md:flex-row justify-between items-center gap-6 text-sm text-muted-foreground">
      <p>© {currentYear} Aexaware Infotech. All rights reserved.</p>
      <div class="flex items-center gap-8">
        <a href="/privacy" class="hover:text-primary transition-colors">Privacy Policy</a>
        <a href="/terms" class="hover:text-primary transition-colors">Terms of Service</a>
        <button id="scroll-to-top" class="hover:text-primary transition-colors flex items-center gap-2 group">
           Scroll to Top <ArrowUpRight class="w-3 h-3 transition-transform group-hover:-translate-y-0.5" />
        </button>
      </div>
    </div>
  </div>
</footer>

<script>
  const scrollToTopBtn = document.getElementById('scroll-to-top');
  if (scrollToTopBtn) {
    scrollToTopBtn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }
</script>
