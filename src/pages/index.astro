---
import Layout from '@/layouts/Layout.astro';
import Hero from '@/components/astro/Hero.astro';
import TechStackMarquee from '@/components/astro/TechStackMarquee.astro';
import DrivingFuture from '@/components/astro/DrivingFuture.astro';
import ServicesGrid from '@/components/astro/ServicesGrid.astro';
import SmartSolutions from '@/components/astro/SmartSolutions.astro';
import Industries from '@/components/astro/Industries.astro';
import ProcessSteps from '@/components/astro/ProcessSteps.astro';
import Testimonials from '@/components/Testimonials.astro';
import { buttonVariants } from '@/components/ui/button-variants';
import { cn } from '@/lib/utils';
---

<Layout 
  title="Aexaware Infotech – Custom Web, Mobile & AI Solutions from Vadodara, Gujarat" 
  description="Aexaware Infotech builds scalable web, mobile, AI, and DevOps solutions for startups and enterprises – Made in Vadodara, Serving Globally."
>
  <Hero />
  <TechStackMarquee />
  <DrivingFuture />
  <ServicesGrid />
  <SmartSolutions />
  <Industries />
  <ProcessSteps />
  <Testimonials />

  {/* CTA Section */}
  <section class="section-padding bg-background relative overflow-hidden">
    
    {/* FIX: Semantic Grid Background 
        Replaced hardcoded hex #8080800a with semantic variable for theme consistency */}
    <div class="absolute inset-0 bg-[linear-gradient(to_right,hsl(var(--foreground)/0.04)_1px,transparent_1px),linear-gradient(to_bottom,hsl(var(--foreground)/0.04)_1px,transparent_1px)] bg-[size:40px_40px] pointer-events-none" />

    <div class="container-normal relative z-10">
      <div class="relative overflow-hidden rounded-[2.5rem] bg-foreground px-6 py-24 text-center sm:px-16 shadow-2xl">
        
        {/* Glow Effects */}
        <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-full max-w-3xl bg-primary/20 blur-3xl rounded-full pointer-events-none" />

        <div class="relative z-10 mx-auto max-w-3xl">
          <h2 class="font-heading font-bold text-4xl text-background md:text-6xl tracking-tight mb-8">
            Let’s Build Something <br />
            <span class="text-primary italic font-serif">Extraordinary.</span>
          </h2>
          <p class="text-xl text-background/80 mb-10 max-w-xl mx-auto leading-relaxed">
            Ready to transform your digital presence? Book a free consultation and let's map out your success.
          </p>
          <div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
            <a 
              href="/contact" 
              class={cn(buttonVariants({ size: "lg" }), "h-16 rounded-full px-10 text-xl font-bold bg-background text-foreground hover:bg-background/90 hover:scale-105 transition-all shadow-xl")}
            >
              Get Free Consultation
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>