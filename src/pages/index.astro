---
import Layout from '@/layouts/Layout.astro';
import { Schema } from 'astro-seo-schema';
import Hero from '@/components/home/Hero.astro';
import TechStackMarquee from '@/components/home/TechStackMarquee.astro';
import ServicesGrid from '@/components/home/ServicesGrid.astro';
import FeaturedWorks from '@/components/home/FeaturedWorks.astro';
import ProcessSteps from '@/components/home/ProcessSteps.astro';
import DeliveryStandards from '@/components/home/DeliveryStandards.astro';
import EngineeringLogs from '@/components/home/EngineeringLogs.astro';
import Testimonials from '@/components/shared/Testimonials.astro';
import CTA from '@/components/home/CTA.astro';
---

<Layout 
  title="Aexaware Infotech – Custom Web, Mobile & AI Solutions from Vadodara, Gujarat" 
  description="Aexaware Infotech builds scalable web, mobile, AI, and DevOps solutions for startups and enterprises – Made in Vadodara, Serving Globally."
>
  <Fragment slot="head">
    <Schema
      item={{
        "@context": "https://schema.org",
        "@type": "ProfessionalService",
        "name": "Aexaware Infotech",
        "image": "https://aexaware.com/og-image.png",
        "@id": "https://aexaware.com",
        "url": "https://aexaware.com",
        "telephone": "+918140734392",
        "priceRange": "$$$",
        "description": "Full-service software development company specializing in web development, mobile apps, AI/ML integration, DevOps, cloud solutions, UI/UX design, and e-commerce development. Founded in 2024, based in Vadodara, Gujarat, India.",
        "founder": {
          "@type": "Person",
          "name": "Axit Padaliya",
          "jobTitle": "Founder & CEO",
          "url": "https://www.linkedin.com/in/axit-padaliya-451463202/"
        },
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Office no 13, 3rd Floor Aarya's landmark, Canal Ring Road, Sevasi",
          "addressLocality": "Vadodara",
          "addressRegion": "Gujarat",
          "postalCode": "391101",
          "addressCountry": "IN"
        },
        "geo": {
          "@type": "GeoCoordinates",
          "latitude": 22.316837,
          "longitude": 73.136081
        },
        "openingHoursSpecification": [
          {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
            "opens": "09:00",
            "closes": "18:00"
          }
        ],
        "sameAs": [
          "https://www.linkedin.com/in/axit-padaliya-451463202/",
          "https://www.linkedin.com/company/aexaware",
          "https://twitter.com/aexaware",
          "https://github.com/aexaware",
          "https://www.instagram.com/aexaware/",
          "https://www.youtube.com/@aexaware"
        ],
        "areaServed": ["Worldwide", "IN", "US", "GB", "AE", "CA", "AU"],
        "serviceType": ["Web Development", "Mobile App Development", "AI/ML Solutions", "Cloud DevOps", "UI/UX Design", "E-commerce Development"]
      }}
    />
  </Fragment>
  <Hero />
  <TechStackMarquee />
  <ServicesGrid />
  <ProcessSteps />
  <FeaturedWorks />
  <Testimonials />
  <DeliveryStandards />
  <EngineeringLogs />
  <CTA />
</Layout>