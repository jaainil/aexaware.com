---
import Layout from "@/layouts/Layout.astro";
import {
  ArrowRight,
  Code2,
  Smartphone,
  Palette,
  Cloud,
  Database,
  LineChart,
  Globe,
  ShieldCheck,
  Zap,
  Layers,
  Sparkles,
  Rocket,
  Layout as LayoutIcon,
  Cpu,
  Users,
  TrendingUp,
  Ghost,
  Brain,
  Bot,
  Wand2,
  Eye,
  FlaskConical,
  Server,
  Settings,
  Wifi,
  Target,
  Megaphone,
} from "lucide-astro";
import { Schema } from "astro-seo-schema";
import CTA from "@/components/home/CTA.astro";
import BackgroundGrid from "@/components/home/BackgroundGrid.astro";

const services = [
  {
    icon: Code2,
    title: "Web Development",
    desc: "Custom websites and web applications built with modern frameworks for speed, scalability, and SEO.",
    tags: ["React", "Next.js", "TypeScript"],
    path: "/services/web-development",
  },
  {
    icon: Smartphone,
    title: "Mobile App Development",
    desc: "Native and cross-platform mobile apps that deliver seamless user experiences on iOS and Android.",
    tags: ["React Native", "Flutter", "iOS/Android"],
    path: "/services/mobile-development",
  },
  {
    icon: Palette,
    title: "UI/UX Design",
    desc: "User-centric design that blends aesthetics with functionality to create intuitive digital products.",
    tags: ["Figma", "Prototyping", "User Research"],
    path: "/services/ui-ux-design",
  },
  {
    icon: Cloud,
    title: "Cloud Solutions",
    desc: "Secure and scalable cloud infrastructure setup, migration, and management services.",
    tags: ["AWS", "Azure", "GCP", "Kubernetes"],
    path: "/services/cloud-devops",
  },
  {
    icon: Brain,
    title: "AI/ML Integration",
    desc: "Data-driven decision making, predictive modelling, recommendation engines, chatbot automation, and AI-driven features.",
    tags: ["Python", "TensorFlow", "OpenAI"],
    path: "/services/ai-ml-integration",
  },
  {
    icon: Wand2,
    title: "Generative AI",
    desc: "AI-powered content creation, image/video generation, code assistance, and automation for modern businesses.",
    tags: ["GPT-4", "DALL-E", "Custom LLMs"],
    path: "/services/generative-ai",
  },
  {
    icon: Bot,
    title: "AI Agent Development",
    desc: "Autonomous AI agents that automate workflows, handle customer service, and drive business operations 24/7.",
    tags: ["LangChain", "AutoGPT", "Custom Agents"],
    path: "/services/ai-agent-development",
  },
  {
    icon: Eye,
    title: "AI Image & Video Generation",
    desc: "Create stunning visuals and videos with AI. Generate content at scale for marketing and products.",
    tags: ["DALL-E", "Midjourney", "Stable Diffusion"],
    path: "/services/ai-image-video-generation",
  },
  {
    icon: Brain,
    title: "Deep Learning",
    desc: "Advanced neural networks for computer vision, NLP, speech recognition, and complex pattern recognition.",
    tags: ["PyTorch", "TensorFlow", "Neural Networks"],
    path: "/services/deep-learning",
  },
  {
    icon: FlaskConical,
    title: "TensorFlow Development",
    desc: "Enterprise-grade TensorFlow models for production. Custom ML solutions with deployment and monitoring.",
    tags: ["TensorFlow", "Keras", "MLOps"],
    path: "/services/tensorflow-development",
  },
  {
    icon: Database,
    title: "Data Analysis",
    desc: "Turn raw data into actionable insights. Descriptive and predictive analytics for better decisions.",
    tags: ["Python", "R", "Statistical Analysis"],
    path: "/services/data-analysis",
  },
  {
    icon: LineChart,
    title: "Data Visualization",
    desc: "Interactive dashboards and custom visualizations that make data accessible and actionable.",
    tags: ["Tableau", "D3.js", "Power BI"],
    path: "/services/data-visualization",
  },
  {
    icon: Server,
    title: "Big Data Solutions",
    desc: "Scalable data infrastructure. Data lakes, ETL pipelines, and real-time processing at any scale.",
    tags: ["Spark", "Kafka", "Snowflake"],
    path: "/services/big-data-solutions",
  },
  {
    icon: TrendingUp,
    title: "Business Intelligence",
    desc: "Executive dashboards and reporting that drive informed decision-making across your organization.",
    tags: ["Tableau", "Looker", "Power BI"],
    path: "/services/business-intelligence",
  },
  {
    icon: Brain,
    title: "Data Science",
    desc: "Advanced analytics and machine learning models that predict outcomes and uncover hidden opportunities.",
    tags: ["ML", "Python", "Predictive Models"],
    path: "/services/data-science",
  },
  {
    icon: Settings,
    title: "DevOps Strategy & Consulting",
    desc: "Transform your software delivery with expert DevOps consulting and transformation roadmaps.",
    tags: ["CI/CD", "Cloud Native", "Agile"],
    path: "/services/devops-strategy-consulting",
  },
  {
    icon: Zap,
    title: "DevOps Automation",
    desc: "Automate your entire delivery pipeline. Infrastructure as code, CI/CD, and configuration management.",
    tags: ["Terraform", "Ansible", "Jenkins"],
    path: "/services/devops-automation",
  },
  {
    icon: Server,
    title: "DevOps Implementation",
    desc: "Full DevOps implementation and cloud infrastructure. Migration, setup, and managed services.",
    tags: ["AWS", "Kubernetes", "Cloud"],
    path: "/services/devops-implementation",
  },
  {
    icon: Wifi,
    title: "IoT Development",
    desc: "Connect devices and build smart systems. IoT platforms, firmware, and cloud integration.",
    tags: ["Sensors", "Embedded", "Cloud"],
    path: "/services/iot",
  },
  {
    icon: Target,
    title: "Conversion Rate Optimization",
    desc: "Data-driven CRO that increases conversions. A/B testing, landing pages, and funnel optimization.",
    tags: ["A/B Testing", "Analytics", "Funnel"],
    path: "/services/conversion-rate-optimization",
  },
  {
    icon: Megaphone,
    title: "Branding & Positioning",
    desc: "Strategic branding that differentiates you. Brand identity, strategy, and positioning in the market.",
    tags: ["Brand Identity", "Strategy", "Positioning"],
    path: "/services/branding-positioning",
  },
  {
    icon: LineChart,
    title: "E-commerce Development",
    desc: "Secure online stores with payment integration, inventory management, and responsive design.",
    tags: ["Shopify", "WooCommerce", "Custom"],
    path: "/services/ecommerce",
  },
  {
    icon: Rocket,
    title: "MVP Development",
    desc: "Rapid prototyping and core feature development to validate your startup ideas quickly.",
    tags: ["Prototyping", "Lean Startup", "Speed"],
    path: "/services/mvp-development",
  },
  {
    icon: LayoutIcon,
    title: "CMS Development",
    desc: "Custom themes and plugins for WordPress, Shopify, and modern Headless CMS solutions.",
    tags: ["WordPress", "Shopify", "Strapi"],
    path: "/services/cms-development",
  },
  {
    icon: Cpu,
    title: "Custom Software",
    desc: "Tailored software solutions designed to address your specific business challenges and workflows.",
    tags: ["Enterprise", "SaaS", "Automation"],
    path: "/services/software-solutions",
  },
  {
    icon: Users,
    title: "Extended Team",
    desc: "Augment your existing team with our skilled developers, engineers, and digital experts.",
    tags: ["Staff Augmentation", "Dedicated Team", "Remote"],
    path: "/services/extended-team",
  },
  {
    icon: TrendingUp,
    title: "Digital Marketing",
    desc: "Data-driven marketing strategies to increase your online visibility and drive growth.",
    tags: ["SEO", "PPC", "Social Media"],
    path: "/services/digital-marketing",
  },
  {
    icon: Ghost,
    title: "White Label Services",
    desc: "Silent partnership services for agencies looking to scale their production capabilities.",
    tags: ["Confidential", "Agency Support", "Scalable"],
    path: "/services/white-label-services",
  },
];

const solutions = [
  {
    title: "E-Commerce",
    desc: "High-converting online stores with seamless checkout experiences.",
    href: "/services/ecommerce",
  },
  {
    title: "Healthcare",
    desc: "HIPAA-compliant applications for patient management and telemedicine.",
    href: "/contact",
  },
  {
    title: "FinTech",
    desc: "Secure and robust financial platforms for banking and payments.",
    href: "/contact",
  },
  {
    title: "Education",
    desc: "Interactive learning management systems and educational portals.",
    href: "/contact",
  },
];

const techStack = [
  "React",
  "Next.js",
  "TypeScript",
  "Node.js",
  "Python",
  "Go",
  "Java",
  "PHP",
  "PostgreSQL",
  "AWS",
  "Azure",
  "GCP",
  "Docker",
  "Kubernetes",
  "Flutter",
  "React Native",
  "Tailwind CSS",
  "Figma",
  "GraphQL",
  "TensorFlow",
  "PyTorch",
  "MongoDB",
  "Redis",
  "Terraform",
];

// No schema generation variable needed
---

<Layout
  title="Software Development Services – Web, Mobile, AI/ML & Cloud | Aexaware Infotech"
  description="Explore 28+ software development services from Aexaware Infotech: web development, mobile apps, AI/ML integration, generative AI, DevOps, cloud, UI/UX design, and more. Serving startups and enterprises worldwide."
>
  <Fragment slot="head">
    <Schema
      item={{
        "@context": "https://schema.org",
        "@type": "Service",
        serviceType: "Digital Transformation Services",
        provider: {
          "@type": "Organization",
          name: "Aexaware Infotech",
          url: "https://aexaware.com",
        },
        areaServed: {
          "@type": "Place",
          name: "Global",
        },
        hasOfferCatalog: {
          "@type": "OfferCatalog",
          name: "IT Services",
          itemListElement: services.map((service) => ({
            "@type": "Offer",
            itemOffered: {
              "@type": "Service",
              name: service.title,
              description: service.desc,
            },
          })),
        },
      }}
    />
    <Schema
      item={{
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: [
          {
            "@type": "ListItem",
            position: 1,
            name: "Home",
            item: "https://aexaware.com",
          },
          {
            "@type": "ListItem",
            position: 2,
            name: "Services",
          },
        ],
      }}
    />
  </Fragment>

  {/* Hero Section */}
  {/* FIX: Use 100dvh for full-screen hero on mobile and desktop */}
  <section
    class="relative w-full min-h-dvh flex flex-col justify-center pt-(--navbar-height) pb-16 lg:pb-24 overflow-hidden border-b border-border/40"
  >
    {/* FIX: Semantic Grid Background */}
    <BackgroundGrid density="sm" mask="top" />

    <div class="container-normal relative z-10">
      <div class="max-w-4xl mx-auto text-center">
        <div
          class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-primary/20 bg-primary/5 backdrop-blur-xs mb-8"
        >
          <Sparkles className="w-4 h-4 text-primary" />
          <span
            class="text-sm font-semibold text-primary tracking-wide uppercase"
            >Our Expertise</span
          >
        </div>

        <h1
          class="font-heading font-bold text-4xl sm:text-6xl lg:text-8xl tracking-tighter leading-none lg:leading-[0.9] text-foreground mb-8 text-balance"
        >
          Digital solutions that <br />
          <span class="text-primary font-serif">drive growth.</span>
        </h1>
        <p
          class="mx-auto mt-8 max-w-2xl text-xl text-muted-foreground leading-relaxed text-pretty"
        >
          We provide custom web development, mobile-app development, UI/UX
          design, cloud and DevOps support, and AI/ML integration.
        </p>
        <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="/contact"
            aria-label="Start a project with us"
            class="inline-flex items-center justify-center h-14 rounded-full px-8 text-lg font-medium bg-primary text-primary-foreground hover:bg-primary/90 transition-colors shadow-lg shadow-primary/20 hover:shadow-primary/40"
          >
            Start a Project <ArrowRight className="ml-2 h-5 w-5" />
          </a>
          <a
            href="#capabilities"
            class="inline-flex items-center justify-center h-14 rounded-full px-8 text-lg font-medium border border-border bg-background/50 hover:bg-secondary/50 backdrop-blur-xs transition-all hover:border-primary/20"
          >
            Explore Services
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* Core Capabilities */}
  <section id="capabilities" class="section-padding bg-background relative">
    <div class="container-normal">
      <div class="text-center max-w-3xl mx-auto mb-20">
        <h2
          class="font-heading text-4xl md:text-5xl font-bold text-foreground mb-6"
        >
          Core Capabilities
        </h2>
        <p class="text-xl text-muted-foreground leading-relaxed">
          We offer a comprehensive suite of digital services designed to meet
          the evolving needs of modern businesses.
        </p>
      </div>

      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {
          services.map((service) => (
            <a
              href={service.path}
              class="group relative bg-secondary/5 p-8 rounded-card-lg border border-white/10 hover:border-primary/20 hover:shadow-2xl hover:shadow-primary/5 transition-all duration-300 block overflow-hidden"
            >
              <div class="absolute inset-0 bg-linear-to-br from-primary/5 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none" />

              <div class="mb-8 inline-flex p-4 rounded-2xl bg-primary/10 text-primary group-hover:scale-110 transition-transform duration-500">
                <service.icon className="h-8 w-8" aria-hidden="true" />
              </div>

              <h3 class="font-heading text-2xl font-bold text-foreground mb-4 group-hover:text-primary transition-colors">
                {service.title}
              </h3>

              <p class="text-muted-foreground leading-relaxed mb-8 text-base">
                {service.desc}
              </p>

              <div class="flex flex-wrap gap-2 mt-auto">
                {service.tags.map((tag) => (
                  <span class="px-3 py-1 rounded-full bg-white/5 border border-white/5 text-xs font-medium text-muted-foreground group-hover:text-foreground transition-colors">
                    {tag}
                  </span>
                ))}
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  {/* Our Solutions - Feature Highlight */}
  <section class="section-padding border-t border-border/40 bg-secondary/5">
    <div class="container-normal">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div class="space-y-10">
          <h2
            class="font-heading text-4xl md:text-5xl font-bold text-foreground leading-tight"
          >
            Solutions tailored to <br />
            <span class="text-primary font-serif">your industry.</span>
          </h2>
          <p class="text-xl text-muted-foreground leading-relaxed">
            We understand that every industry has unique challenges. Our team
            has deep expertise in delivering specialized solutions for various
            sectors.
          </p>

          <div class="space-y-8">
            {
              solutions.map((item) => (
                <a href={item.href} class="flex gap-6 group cursor-pointer">
                  <div class="mt-1 p-2 rounded-full bg-primary/10 text-primary h-fit group-hover:bg-primary group-hover:text-primary-foreground transition-colors duration-300">
                    <ArrowRight className="h-5 w-5" aria-hidden="true" />
                  </div>
                  <div>
                    <h3 class="font-heading font-bold text-foreground text-xl mb-2 group-hover:text-primary transition-colors">
                      {item.title}
                    </h3>
                    <p class="text-muted-foreground text-lg">{item.desc}</p>
                  </div>
                </a>
              ))
            }
          </div>
        </div>

        <div class="relative">
          <div
            class="aspect-auto lg:aspect-4/3 rounded-section overflow-hidden bg-background border border-border/50 shadow-2xl relative"
          >
            <div
              class="absolute inset-0 bg-linear-to-br from-primary/5 to-accent/5"
            >
            </div>

            {/* Abstract Visual Grid */}
            <div
              class="grid grid-cols-2 gap-3 lg:gap-6 p-4 lg:p-12 h-full content-center"
            >
              <div
                class="bg-card/50 backdrop-blur-xs rounded-card-lg p-4 lg:p-8 flex flex-col justify-center items-center text-center border border-white/10 hover:border-primary/30 transition-colors duration-500 shadow-lg"
              >
                <Globe
                  className="h-8 w-8 lg:h-12 lg:w-12 text-primary mb-2 lg:mb-4"
                  aria-hidden="true"
                />
                <span class="font-bold text-sm lg:text-lg font-heading"
                  >Global Reach</span
                >
              </div>
              <div
                class="bg-card/50 backdrop-blur-xs rounded-card-lg p-4 lg:p-8 flex flex-col justify-center items-center text-center border border-white/10 hover:border-primary/30 transition-colors duration-500 shadow-lg"
              >
                <ShieldCheck
                  className="h-8 w-8 lg:h-12 lg:w-12 text-primary mb-2 lg:mb-4"
                  aria-hidden="true"
                />
                <span class="font-bold text-sm lg:text-lg font-heading"
                  >Secure</span
                >
              </div>
              <div
                class="bg-card/50 backdrop-blur-xs rounded-card-lg p-4 lg:p-8 flex flex-col justify-center items-center text-center border border-white/10 hover:border-primary/30 transition-colors duration-500 shadow-lg"
              >
                <Zap
                  className="h-8 w-8 lg:h-12 lg:w-12 text-primary mb-2 lg:mb-4"
                  aria-hidden="true"
                />
                <span class="font-bold text-sm lg:text-lg font-heading"
                  >Fast</span
                >
              </div>
              <div
                class="bg-card/50 backdrop-blur-xs rounded-card-lg p-4 lg:p-8 flex flex-col justify-center items-center text-center border border-white/10 hover:border-primary/30 transition-colors duration-500 shadow-lg"
              >
                <Layers
                  className="h-8 w-8 lg:h-12 lg:w-12 text-primary mb-2 lg:mb-4"
                  aria-hidden="true"
                />
                <span class="font-bold text-sm lg:text-lg font-heading"
                  >Scalable</span
                >
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* Technology Stack */}
  <section class="section-padding bg-background border-t border-border/40">
    <div class="container-normal text-center">
      <h2
        class="font-heading text-3xl md:text-4xl font-bold mb-16 text-foreground"
      >
        Powered by modern technology.
      </h2>

      <div
        class="flex flex-wrap justify-center gap-4 md:gap-6 opacity-90 max-w-5xl mx-auto"
      >
        {
          techStack.map((tech) => (
            <div class="flex items-center justify-center px-6 py-3 rounded-full bg-secondary/30 border border-border/50 hover:border-primary/30 hover:bg-primary/5 transition-all duration-300 cursor-default">
              <span class="font-medium text-lg text-muted-foreground hover:text-foreground">
                {tech}
              </span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <CTA
    variant="primary"
    title="Ready to scale?"
    titleHighlight=""
    description="Let's build something amazing together. Contact us today for a free consultation and quote."
    buttonText="Get a Free Quote"
    secondaryButtonText="Call Us Now"
    secondaryButtonHref="tel:+918140734392"
  />
</Layout>
