---
import Layout from "@/layouts/Layout.astro";
import { Schema } from "astro-seo-schema";
import {
  Shield,
  Lock,
  Eye,
  Database,
  Globe,
  Mail,
  Calendar,
  Sparkles,
  Server,
  Cookie,
  Scale,
  RefreshCw,
  Users,
  BarChart3,
  Share2,
} from "lucide-astro";
import BackgroundGrid from "@/components/astro/BackgroundGrid.astro";

const lastUpdated = "December 30, 2025";
const siteUrl = Astro.site || "https://aexaware.com";
---

<Layout
  title="Privacy Policy – Aexaware Infotech"
  description="Learn how Aexaware Infotech collects, uses, and protects your personal information. GDPR compliant privacy practices."
>
  <Fragment slot="head">
    <Schema
      item={{
        "@context": "https://schema.org",
        "@type": "WebPage",
        name: "Privacy Policy",
        description:
          "Learn how Aexaware Infotech collects, uses, and protects your personal information. GDPR compliant privacy practices.",
        url: new URL("/privacy-policy", siteUrl).href,
        dateModified: "2025-12-30",
        publisher: {
          "@type": "Organization",
          name: "Aexaware Infotech",
          url: siteUrl.toString(),
        },
      }}
    />
    <Schema
      item={{
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: [
          {
            "@type": "ListItem",
            position: 1,
            name: "Home",
            item: siteUrl.toString(),
          },
          {
            "@type": "ListItem",
            position: 2,
            name: "Privacy Policy",
          },
        ],
      }}
    />
  </Fragment>
  <!-- Hero Section -->
  <section
    class="relative w-full min-h-dvh flex flex-col justify-center pt-(--navbar-height) pb-16 lg:pb-24 overflow-hidden border-b border-border/40"
  >
    <BackgroundGrid density="sm" mask="top" />
    <div
      class="absolute inset-0 bg-linear-to-b from-primary/5 via-transparent to-transparent -z-10"
    >
    </div>

    <div class="container-normal relative z-10">
      <div class="max-w-4xl mx-auto text-center">
        <div
          class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-primary/20 bg-primary/5 backdrop-blur-xs mb-8"
        >
          <Sparkles className="w-4 h-4 text-primary" />
          <span
            class="text-sm font-semibold text-primary tracking-wide uppercase"
            >Legal</span
          >
        </div>

        <h1
          class="font-heading font-bold text-4xl sm:text-6xl lg:text-8xl tracking-tighter leading-none lg:leading-[0.9] text-foreground mb-8 text-balance"
        >
          Privacy <br />
          <span class="text-primary font-serif">Policy.</span>
        </h1>
        <p
          class="mx-auto mt-8 max-w-2xl text-xl text-muted-foreground leading-relaxed text-pretty"
        >
          We are committed to protecting your privacy and ensuring your personal
          data is handled responsibly and in compliance with GDPR.
        </p>
        <div
          class="mt-8 flex items-center justify-center gap-2 text-sm text-muted-foreground"
        >
          <Calendar className="w-4 h-4" />
          <span>Effective Date: {lastUpdated}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Content Section -->
  <section class="section-padding bg-background">
    <div class="container-normal">
      <!-- Introduction - Who We Are -->
      <div
        class="p-8 rounded-section bg-secondary/30 border border-border/50 mb-12"
      >
        <div class="flex items-start gap-4">
          <div class="p-3 rounded-xl bg-primary/10 text-primary shrink-0">
            <Users className="w-6 h-6" />
          </div>
          <div>
            <h2 class="text-xl font-bold text-foreground mt-0 mb-2">
              1. Who We Are
            </h2>
            <p class="text-muted-foreground mb-4">
              Aexaware ("we", "our", or "us") is an IT agency based in Vadodara,
              India. We provide services including web development, app
              development, and digital solutions for clients worldwide.
            </p>
            <p class="text-muted-foreground mb-0">
              We are committed to protecting your privacy and ensuring your
              personal data is handled responsibly and in compliance with the
              General Data Protection Regulation (GDPR).
            </p>
          </div>
        </div>
      </div>

      <div class="grid gap-8 lg:grid-cols-2">
        <!-- Section 2 - What Data We Collect -->
        <div class="p-8 rounded-card-lg bg-card border border-border/50">
          <div class="flex items-center gap-3 mb-6">
            <div class="p-2 rounded-lg bg-primary/10 text-primary">
              <Database className="w-5 h-5" />
            </div>
            <h2 class="text-xl font-heading font-bold text-foreground m-0">
              2. What Data We Collect
            </h2>
          </div>

          <div class="space-y-4 text-muted-foreground">
            <p>
              We keep data collection to a minimum. The only personal
              information we collect is submitted by users voluntarily through
              the contact form and newsletter signup.
            </p>

            <div
              class="p-4 rounded-card bg-secondary/30 border border-border/50"
            >
              <h4 class="font-semibold text-foreground mb-3">
                Information You Provide:
              </h4>
              <ul class="text-sm space-y-2 mb-0 list-none pl-0">
                <li class="flex items-center gap-2">
                  <span class="text-primary">•</span>Name
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-primary">•</span>Email Address
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-primary">•</span>Phone Number (optional)
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-primary">•</span>Message Subject & Content
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-primary">•</span>Newsletter sign-up (email
                  only)
                </li>
              </ul>
            </div>
            <p class="text-sm italic">
              We do not collect or process sensitive personal data.
            </p>
          </div>
        </div>

        <!-- Section 3 - How We Use Your Data -->
        <div class="p-8 rounded-card-lg bg-card border border-border/50">
          <div class="flex items-center gap-3 mb-6">
            <div class="p-2 rounded-lg bg-primary/10 text-primary">
              <Eye className="w-5 h-5" />
            </div>
            <h2 class="text-xl font-heading font-bold text-foreground m-0">
              3. How We Use Your Data
            </h2>
          </div>

          <div class="space-y-4 text-muted-foreground">
            <p>We process your data only for the following purposes:</p>
            <ul class="space-y-2 list-none pl-0">
              <li class="flex items-start gap-2">
                <span class="text-primary">•</span><span
                  >Responding to your inquiries</span
                >
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary">•</span><span
                  >Providing customer support</span
                >
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary">•</span><span
                  >Sending newsletters or updates (if you've opted in)</span
                >
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary">•</span><span
                  >Improving website performance (via analytics)</span
                >
              </li>
            </ul>
          </div>
        </div>

        <!-- Section 4 - Analytics & Tracking -->
        <div class="p-8 rounded-card-lg bg-card border border-border/50">
          <div class="flex items-center gap-3 mb-6">
            <div class="p-2 rounded-lg bg-success/10 text-success">
              <BarChart3 className="w-5 h-5" />
            </div>
            <h2 class="text-xl font-heading font-bold text-foreground m-0">
              4. Analytics & Tracking
            </h2>
          </div>

          <div class="space-y-4 text-muted-foreground">
            <p>
              We use <strong class="text-foreground">Umami Analytics</strong>, a
              privacy-focused analytics platform.
            </p>
            <div
              class="p-4 rounded-card bg-success/5 border border-success/20"
            >
              <p class="text-sm mb-0">
                ✓ Umami does not use cookies<br />
                ✓ Does not collect personally identifiable information<br />
                ✓ Privacy-friendly and GDPR compliant
              </p>
            </div>
          </div>
        </div>

        <!-- Section 5 - Data Sharing & Third Parties -->
        <div class="p-8 rounded-card-lg bg-card border border-border/50">
          <div class="flex items-center gap-3 mb-6">
            <div class="p-2 rounded-lg bg-warning/10 text-warning">
              <Share2 className="w-5 h-5" />
            </div>
            <h2 class="text-xl font-heading font-bold text-foreground m-0">
              5. Data Sharing & Third Parties
            </h2>
          </div>

          <div class="space-y-4 text-muted-foreground">
            <p>
              We do not share your personal data with any third parties for
              marketing or advertising.
            </p>
            <p>However, we use the following infrastructure providers:</p>
            <ul class="space-y-2 list-none pl-0 text-sm">
              <li class="flex items-start gap-2">
                <span class="text-primary font-bold">Cloudflare</span> – Reverse proxy
                for protection and performance
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary font-bold">Self-hosted VPS</span> – Website
                and email on our own servers
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary font-bold">Listmonk</span> – Self-hosted
                mailing list platform (by Zerodha)
              </li>
            </ul>
            <p class="text-sm italic">
              These providers are chosen for their strong privacy and security
              practices.
            </p>
          </div>
        </div>

        <!-- Section 6 - Legal Basis (GDPR) -->
        <div class="p-8 rounded-card-lg bg-card border border-border/50">
          <div class="flex items-center gap-3 mb-6">
            <div class="p-2 rounded-lg bg-info/10 text-info">
              <Scale className="w-5 h-5" />
            </div>
            <h2 class="text-xl font-heading font-bold text-foreground m-0">
              6. Legal Basis for Processing (GDPR)
            </h2>
          </div>

          <div class="space-y-4 text-muted-foreground">
            <p>
              Under GDPR, we rely on the following legal bases for processing
              your personal data:
            </p>
            <ul class="space-y-2 list-none pl-0">
              <li class="flex items-start gap-2">
                <span class="text-primary">•</span><span
                  ><strong class="text-foreground">Consent</strong> – When you voluntarily
                  contact us or sign up for our newsletter</span
                >
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary">•</span><span
                  ><strong class="text-foreground">Legitimate Interest</strong> –
                  For improving website performance and protecting against abuse</span
                >
              </li>
            </ul>
          </div>
        </div>

        <!-- Section 7 - User Rights Under GDPR -->
        <div class="p-8 rounded-card-lg bg-card border border-border/50">
          <div class="flex items-center gap-3 mb-6">
            <div class="p-2 rounded-lg bg-rose-500/10 text-rose-500">
              <Shield className="w-5 h-5" />
            </div>
            <h2 class="text-xl font-heading font-bold text-foreground m-0">
              7. User Rights Under GDPR
            </h2>
          </div>

          <div class="space-y-4 text-muted-foreground">
            <p>
              If you are located in the European Economic Area (EEA), you have
              the following rights:
            </p>
            <ul class="space-y-2 list-none pl-0">
              <li class="flex items-start gap-2">
                <span class="text-primary">•</span><span
                  ><strong class="text-foreground">Access</strong> – Request a copy
                  of your personal data</span
                >
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary">•</span><span
                  ><strong class="text-foreground">Correction</strong> – Request correction
                  of inaccurate data</span
                >
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary">•</span><span
                  ><strong class="text-foreground">Deletion</strong> – Request deletion
                  of your personal data</span
                >
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary">•</span><span
                  ><strong class="text-foreground">Objection</strong> – Object to
                  processing of your data</span
                >
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary">•</span><span
                  ><strong class="text-foreground">Withdraw Consent</strong> – Unsubscribe
                  at any time</span
                >
              </li>
            </ul>
            <p class="text-sm">
              To exercise any of these rights, email us at <a
                href="mailto:contact@aexaware.com"
                class="text-primary hover:underline">contact@aexaware.com</a
              >
            </p>
          </div>
        </div>

        <!-- Section 8 - Security Measures -->
        <div class="p-8 rounded-card-lg bg-card border border-border/50">
          <div class="flex items-center gap-3 mb-6">
            <div class="p-2 rounded-lg bg-primary/10 text-primary">
              <Lock className="w-5 h-5" />
            </div>
            <h2 class="text-xl font-heading font-bold text-foreground m-0">
              8. Security Measures
            </h2>
          </div>

          <div class="space-y-4 text-muted-foreground">
            <p>
              We take your privacy seriously and implement the following
              measures:
            </p>
            <ul class="space-y-2 list-none pl-0">
              <li class="flex items-start gap-2">
                <span class="text-primary">•</span><span
                  >HTTPS encryption (SSL) across the entire site</span
                >
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary">•</span><span
                  >Reverse proxy and DDoS protection via Cloudflare</span
                >
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary">•</span><span
                  >Hosting on secure self-managed VPS</span
                >
              </li>
            </ul>
          </div>
        </div>

        <!-- Section 9 - Data Retention -->
        <div class="p-8 rounded-card-lg bg-card border border-border/50">
          <div class="flex items-center gap-3 mb-6">
            <div class="p-2 rounded-lg bg-warning/10 text-warning">
              <Server className="w-5 h-5" />
            </div>
            <h2 class="text-xl font-heading font-bold text-foreground m-0">
              9. Data Retention
            </h2>
          </div>

          <div class="space-y-4 text-muted-foreground">
            <p>
              We only retain personal data as long as necessary for the purposes
              described above.
            </p>
            <ul class="space-y-2 list-none pl-0">
              <li class="flex items-start gap-2">
                <span class="text-primary">•</span><span
                  ><strong class="text-foreground"
                    >Contact form submissions:</strong
                  > Retained until your inquiry is resolved</span
                >
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary">•</span><span
                  ><strong class="text-foreground"
                    >Newsletter subscriptions:</strong
                  > Retained until you unsubscribe</span
                >
              </li>
            </ul>
            <p class="text-sm italic">
              We do not store unnecessary or unused personal data.
            </p>
          </div>
        </div>

        <!-- Section 10 - Cookies -->
        <div class="p-8 rounded-card-lg bg-card border border-border/50">
          <div class="flex items-center gap-3 mb-6">
            <div class="p-2 rounded-lg bg-warning/10 text-warning">
              <Cookie className="w-5 h-5" />
            </div>
            <h2 class="text-xl font-heading font-bold text-foreground m-0">
              10. Cookies
            </h2>
          </div>

          <div class="space-y-4 text-muted-foreground">
            <div
              class="p-4 rounded-card bg-success/5 border border-success/20"
            >
              <p class="font-semibold text-foreground mb-2">
                🍪 Cookie-Free Website
              </p>
              <p class="text-sm mb-0">
                We do not use cookies or tracking scripts for marketing or
                behavioral profiling. Umami Analytics is cookieless and
                privacy-friendly.
              </p>
            </div>
          </div>
        </div>

        <!-- Section 11 - International Transfers -->
        <div class="p-8 rounded-card-lg bg-card border border-border/50">
          <div class="flex items-center gap-3 mb-6">
            <div class="p-2 rounded-lg bg-success/10 text-success">
              <Globe className="w-5 h-5" />
            </div>
            <h2 class="text-xl font-heading font-bold text-foreground m-0">
              11. International Transfers
            </h2>
          </div>

          <div class="space-y-4 text-muted-foreground">
            <p>
              Our servers are hosted in a secure environment under our direct
              control. We do not transfer personal data outside of the
              jurisdictions in which we operate without ensuring appropriate
              safeguards are in place.
            </p>
          </div>
        </div>

        <!-- Section 12 - Updates to This Policy -->
        <div class="p-8 rounded-card-lg bg-card border border-border/50">
          <div class="flex items-center gap-3 mb-6">
            <div class="p-2 rounded-lg bg-primary/10 text-primary">
              <RefreshCw className="w-5 h-5" />
            </div>
            <h2 class="text-xl font-heading font-bold text-foreground m-0">
              12. Updates to This Policy
            </h2>
          </div>

          <div class="space-y-4 text-muted-foreground">
            <p>
              We may update this Privacy Policy from time to time. If you are
              subscribed to our newsletter, we will notify you via email when
              significant changes occur.
            </p>
            <p>The latest version will always be available on our website.</p>
          </div>
        </div>
      </div>

      <!-- Contact Section -->
      <div
        class="mt-12 p-8 rounded-section bg-linear-to-br from-primary/5 to-accent/5 border border-primary/20"
      >
        <div class="flex items-start gap-4">
          <div class="p-3 rounded-xl bg-primary/10 text-primary shrink-0">
            <Mail className="w-6 h-6" />
          </div>
          <div>
            <h2 class="text-xl font-bold text-foreground mt-0 mb-2">
              13. Contact Us
            </h2>
            <p class="text-muted-foreground mb-4">
              If you have any questions about this Privacy Policy or how we
              handle your data, feel free to contact us:
            </p>
            <div class="flex flex-wrap gap-6 text-sm">
              <p class="mb-0">
                <strong class="text-foreground">📧 Email:</strong>
                <a
                  href="mailto:contact@aexaware.com"
                  class="text-primary hover:underline">contact@aexaware.com</a
                >
              </p>
              <p class="mb-0">
                <strong class="text-foreground">📞 Phone:</strong>
                <a href="tel:+918140734392" class="text-primary hover:underline"
                  >+91 8140734392</a
                >
              </p>
              <p class="mb-0">
                <strong class="text-foreground">📍 Address:</strong> Vadodara, Gujarat,
                India
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
