---
import Layout from '@/layouts/Layout.astro';
import { Home, Search } from "lucide-astro";
---

<Layout 
  title="Page Not Found – Aexaware Infotech" 
  description="The page you are looking for does not exist."
>
  {/* FIX: Use min-h-[100dvh] for mobile viewport stability */}
  <div class="relative min-h-[100dvh] w-full flex flex-col items-center justify-center py-20 overflow-hidden">
    
    {/* Modern Grid Background */}
    {/* FIX: Semantic Grid Background */}
    <div class="absolute inset-0 bg-[linear-gradient(to_right,hsl(var(--foreground)/0.03)_1px,transparent_1px),linear-gradient(to_bottom,hsl(var(--foreground)/0.03)_1px,transparent_1px)] bg-[size:14px_24px] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_50%,#000_70%,transparent_100%)] pointer-events-none" />
    <div class="absolute inset-0 bg-gradient-to-b from-primary/5 via-transparent to-transparent -z-10" />
    
    <div class="container-normal relative z-10 text-center">
      <div class="space-y-2 mb-8 animate-in slide-in-from-bottom-5 duration-700 fade-in">
         <div class="inline-block px-4 py-1.5 rounded-full bg-destructive/10 text-destructive text-sm font-bold uppercase tracking-wider border border-destructive/20 mb-4">
            Error 404
        </div>
        {/* FIX: Use font-heading for brand consistency */}
        <h1 class="font-heading text-8xl md:text-9xl font-bold text-foreground tracking-tighter leading-none select-none">
          Lost?
        </h1>
      </div>
      
      <div class="max-w-md mx-auto space-y-8 animate-in slide-in-from-bottom-10 duration-1000 fade-in delay-200">
        <p class="text-xl text-muted-foreground leading-relaxed">
           The page you are looking for doesn't exist or has been moved. Don't worry, you can easily find your way back.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="/" class="inline-flex items-center justify-center h-12 rounded-full px-8 text-base font-medium bg-primary text-primary-foreground hover:bg-primary/90 transition-colors shadow-lg shadow-primary/20 hover:shadow-primary/40 w-full sm:w-auto hover:-translate-y-0.5 duration-300">
            <Home className="mr-2 w-4 h-4" />
            Back to Home
          </a>
          <a href="/services" class="inline-flex items-center justify-center h-12 rounded-full px-8 text-base font-medium border border-white/10 bg-secondary/50 hover:bg-secondary hover:text-foreground transition-all w-full sm:w-auto hover:-translate-y-0.5 duration-300">
            <Search className="mr-2 w-4 h-4" />
            Explore Services
          </a>
        </div>
      </div>
      
       {/* Decorative Elements */}
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-primary/5 rounded-full blur-[100px] -z-10 pointer-events-none" />
    </div>
  </div>
</Layout>