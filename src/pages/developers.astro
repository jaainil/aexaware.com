---
import Layout from '@/layouts/Layout.astro';
import { 
  Key, 
  Terminal, 
  Code2, 
  Bot, 
  FileCode, 
  Sparkles, 
  ShieldCheck, 
  Zap, 
  ArrowRight, 
  ExternalLink,
  BookOpen,
  Webhook
} from 'lucide-astro';
import BackgroundGrid from '@/components/home/BackgroundGrid.astro';
import CTA from '@/components/home/CTA.astro';
import DeveloperSandbox from '@/components/developers/DeveloperSandbox';

const quickstarts = [
  {
    step: "01",
    title: "cURL Quickstart",
    description: "Inspect the machine-readable OpenAPI spec or LLM context in under 30 seconds.",
    code: `curl -sL https://aexaware.com/openapi.json | jq .`,
    lang: "bash"
  },
  {
    step: "02",
    title: "TypeScript / Node.js",
    description: "Fetch structured endpoints using standard fetch with typed payloads.",
    code: `const res = await fetch("https://aexaware.com/openapi.json");
const spec = await res.json();
console.log(spec.info.title);`,
    lang: "typescript"
  },
  {
    step: "03",
    title: "Python Integration",
    description: "Ingest token-efficient markdown context directly into LangChain or LlamaIndex.",
    code: `import requests
ctx = requests.get("https://aexaware.com/llms.txt").text
print(ctx[:200])`,
    lang: "python"
  },
  {
    step: "04",
    title: "MCP Agent Tooling",
    description: "Connect Claude Desktop, ChatGPT, or Cursor to Aexaware tools in 60 seconds.",
    code: `{
  "mcpServers": {
    "aexaware": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-fetch", "https://aexaware.com/.well-known/mcp/server-card.json"]
    }
  }
}`,
    lang: "json"
  }
];

const docLinks = [
  {
    title: "OpenAPI Specification",
    desc: "Machine-readable OpenAPI 3.1.0 JSON & YAML definitions.",
    href: "/docs/openapi",
    icon: FileCode,
    badge: "OpenAPI 3.1"
  },
  {
    title: "Authentication & Permissions",
    desc: "Bearer tokens, OAuth 2.0 metadata, and security guidelines.",
    href: "/docs/auth",
    icon: Key,
    badge: "OAuth 2.0"
  },
  {
    title: "Webhooks & Realtime Events",
    desc: "Event schemas, retries, and HMAC-SHA256 signature verification.",
    href: "/docs/webhooks",
    icon: Webhook,
    badge: "Webhooks"
  },
  {
    title: "Model Context Protocol (MCP)",
    desc: "Claude Desktop configuration and registered agent tool registry.",
    href: "/docs/mcp",
    icon: Bot,
    badge: "MCP Server"
  }
];
---

<Layout
  title="Aexaware Infotech Developer Portal - API Keys, Documentation & Sandbox"
  description="Official developer portal for Aexaware Infotech. Access sandbox API keys, quickstart guides, interactive API playground, and MCP server tools."
  tags={["Aexaware developer portal", "Aexaware API keys", "Aexaware sandbox", "Aexaware quickstart", "Aexaware MCP tools", "OpenAPI spec"]}
>
  <div class="relative w-full bg-background min-h-dvh pt-32 pb-24 overflow-hidden border-b border-border/40">
    <BackgroundGrid density="md" mask="center" />

    {/* Ambient Glow */}
    <div
      class="pointer-events-none absolute top-0 left-1/2 -translate-x-1/2 -z-10 h-[550px] w-[1100px] rounded-full bg-primary/10 blur-3xl"
      aria-hidden="true"
    >
    </div>

    <div class="container-normal relative z-10">
      <!-- Portal Header -->
      <div class="max-w-3xl mb-16">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-primary/20 bg-primary/5 text-primary text-xs font-semibold uppercase tracking-wider mb-6 backdrop-blur-xs">
          <Sparkles class="w-3.5 h-3.5" />
          Developer Portal & Sandbox
        </div>

        <h1 class="font-heading font-bold text-4xl sm:text-5xl md:text-6xl lg:text-7xl text-foreground tracking-tight mb-6">
          Build & Integrate with <span class="text-primary font-serif">Aexaware</span>
        </h1>

        <p class="text-xl text-muted-foreground leading-relaxed">
          The central hub for engineers, architects, and autonomous AI agents. Test endpoints live in the interactive sandbox, generate sandbox API keys, and follow step-by-step quickstarts.
        </p>

        <div class="flex flex-wrap gap-4 mt-8">
          <a
            href="#sandbox"
            class="inline-flex items-center justify-center rounded-full px-8 h-12 text-sm font-semibold bg-primary text-primary-foreground hover:bg-primary/90 transition-all shadow-lg hover:shadow-primary/25 hover:scale-105 duration-200"
          >
            Launch Interactive Sandbox
          </a>
          <a
            href="#quickstarts"
            class="inline-flex items-center justify-center rounded-full px-8 h-12 text-sm font-semibold border border-border/60 bg-background/50 hover:bg-secondary text-foreground transition-all backdrop-blur-xs"
          >
            Explore Quickstarts
          </a>
        </div>
      </div>

      <!-- 1. Interactive Sandbox Environment -->
      <section id="sandbox" class="mb-24 scroll-mt-28">
        <div class="flex items-center gap-3 mb-8">
          <div class="p-2.5 rounded-xl bg-primary/10 text-primary">
            <Terminal class="w-6 h-6" />
          </div>
          <div>
            <h2 class="font-heading font-bold text-3xl text-foreground">
              Interactive API Sandbox
            </h2>
            <p class="text-muted-foreground text-sm">Generate temporary test keys and simulate live requests</p>
          </div>
        </div>

        <DeveloperSandbox client:load />
      </section>

      <!-- 2. Step-by-Step Quickstart Guides -->
      <section id="quickstarts" class="mb-24 scroll-mt-28">
        <div class="flex items-center gap-3 mb-8">
          <div class="p-2.5 rounded-xl bg-primary/10 text-primary">
            <Zap class="w-6 h-6" />
          </div>
          <div>
            <h2 class="font-heading font-bold text-3xl text-foreground">
              Developer Quickstart Guides
            </h2>
            <p class="text-muted-foreground text-sm">Integrate Aexaware APIs and agent resources in minutes</p>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {quickstarts.map((qs) => (
            <div class="bg-card/60 backdrop-blur-xs border border-border/50 rounded-card-lg p-8 hover:border-primary/40 transition-all duration-300 hover:shadow-xl flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between mb-4">
                  <span class="text-3xl font-bold font-serif text-primary/40">{qs.step}</span>
                  <span class="text-xs font-mono px-3 py-1 bg-secondary/80 rounded-full border border-border/50 text-muted-foreground uppercase">
                    {qs.lang}
                  </span>
                </div>

                <h3 class="font-heading font-bold text-xl text-foreground mb-2">
                  {qs.title}
                </h3>
                <p class="text-sm text-muted-foreground mb-6 leading-relaxed">
                  {qs.description}
                </p>
              </div>

              <div class="bg-secondary/40 border border-border/50 rounded-card p-4 font-mono text-xs text-foreground overflow-x-auto">
                <pre class="whitespace-pre"><code>{qs.code}</code></pre>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- 3. API Keys & Authentication Policy -->
      <section id="api-keys" class="mb-24 scroll-mt-28">
        <div class="flex items-center gap-3 mb-8">
          <div class="p-2.5 rounded-xl bg-primary/10 text-primary">
            <ShieldCheck class="w-6 h-6" />
          </div>
          <div>
            <h2 class="font-heading font-bold text-3xl text-foreground">
              API Keys & Authentication Standards
            </h2>
            <p class="text-muted-foreground text-sm">Key provisioning, environment separation, and rate limits</p>
          </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
          <div class="p-6 bg-card/60 backdrop-blur-xs border border-border/40 rounded-card-lg space-y-3">
            <h3 class="font-heading font-semibold text-lg text-foreground">1. Public Open Discovery</h3>
            <p class="text-sm text-muted-foreground leading-relaxed">
              OpenAPI specifications, LLMs.txt context, RSS feeds, and Linkset catalogs do not require API keys or registration.
            </p>
            <div class="font-mono text-xs text-primary bg-primary/10 p-2.5 rounded-lg">
              <code>Rate Limit: 120 req / min</code>
            </div>
          </div>

          <div class="p-6 bg-card/60 backdrop-blur-xs border border-border/40 rounded-card-lg space-y-3">
            <h3 class="font-heading font-semibold text-lg text-foreground">2. Sandbox Testing Keys</h3>
            <p class="text-sm text-muted-foreground leading-relaxed">
              Ephemeral keys prefixed with <code class="text-foreground">aex_sandbox_...</code> allow developers to simulate write actions and inquiry submissions.
            </p>
            <div class="font-mono text-xs text-primary bg-primary/10 p-2.5 rounded-lg">
              <code>Rate Limit: 60 req / min</code>
            </div>
          </div>

          <div class="p-6 bg-card/60 backdrop-blur-xs border border-border/40 rounded-card-lg space-y-3">
            <h3 class="font-heading font-semibold text-lg text-foreground">3. Production Partner Keys</h3>
            <p class="text-sm text-muted-foreground leading-relaxed">
              Issued directly to enterprise clients and integration partners with dedicated SLA and custom quotas.
            </p>
            <div class="font-mono text-xs text-primary bg-primary/10 p-2.5 rounded-lg">
              <code>Custom Enterprise Quotas</code>
            </div>
          </div>
        </div>
      </section>

      <!-- 4. Documentation Resources Grid -->
      <section id="documentation" class="mb-20 scroll-mt-28">
        <div class="flex items-center gap-3 mb-8">
          <div class="p-2.5 rounded-xl bg-primary/10 text-primary">
            <BookOpen class="w-6 h-6" />
          </div>
          <div>
            <h2 class="font-heading font-bold text-3xl text-foreground">
              Technical Documentation Guides
            </h2>
            <p class="text-muted-foreground text-sm">Deep-dive guides on OpenAPI, authentication, webhooks, and MCP</p>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {docLinks.map((doc) => (
            <a
              href={doc.href}
              class="group p-6 bg-card/60 backdrop-blur-xs border border-border/50 rounded-card-lg hover:border-primary/50 transition-all hover:shadow-xl flex flex-col justify-between"
            >
              <div>
                <div class="flex items-center justify-between mb-4">
                  <div class="p-2 rounded-xl bg-primary/10 text-primary group-hover:bg-primary group-hover:text-primary-foreground transition-colors">
                    <doc.icon class="w-5 h-5" />
                  </div>
                  <span class="text-[11px] font-semibold px-2.5 py-0.5 rounded-full bg-secondary border border-border/60 text-muted-foreground">
                    {doc.badge}
                  </span>
                </div>

                <h3 class="font-heading font-bold text-lg text-foreground mb-2 group-hover:text-primary transition-colors">
                  {doc.title}
                </h3>
                <p class="text-xs text-muted-foreground leading-relaxed mb-6">
                  {doc.desc}
                </p>
              </div>

              <div class="inline-flex items-center text-xs font-semibold text-primary group-hover:translate-x-1 transition-transform">
                Read Guide <ArrowRight class="ml-1 w-3.5 h-3.5" />
              </div>
            </a>
          ))}
        </div>
      </section>
    </div>
  </div>

  <CTA
    title="Ready to Build Custom Integrations?"
    titleHighlight="Talk to Our Engineers."
    description="We collaborate with technical teams to architect high-throughput APIs, custom MCP servers, and cloud infrastructure."
    buttonText="Schedule Technical Consultation"
    buttonHref="https://cal.com/aexaware-infotech"
    secondaryButtonText="Explore All Services"
    secondaryButtonHref="/services"
  />
</Layout>
