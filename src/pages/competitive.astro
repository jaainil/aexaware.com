<script>
  // Filter bar — show/hide competitor cards by tag
  const filterBtns = document.querySelectorAll<HTMLButtonElement>(".filter-btn");
  const cards = document.querySelectorAll<HTMLElement>(".competitor-card");
  const groupVadodara = document.getElementById("cards-vadodara")?.parentElement;
  const groupGujarat = document.getElementById("cards-gujarat")?.parentElement;

  filterBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      const filter = btn.dataset.filter ?? "all";

      // Update active button styles
      filterBtns.forEach((b) => {
        b.classList.remove("bg-primary", "text-primary-foreground", "border-primary");
        b.classList.add("bg-background", "text-muted-foreground", "border-border/50");
      });
      btn.classList.add("bg-primary", "text-primary-foreground", "border-primary");
      btn.classList.remove("bg-background", "text-muted-foreground", "border-border/50");

      // Show/hide cards
      cards.forEach((card) => {
        const tags = card.dataset.tags ?? "";
        if (filter === "all" || tags.includes(filter)) {
          card.style.display = "";
        } else {
          card.style.display = "none";
        }
      });
    });
  });
</script>