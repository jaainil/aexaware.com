---
import Layout from '@/layouts/Layout.astro';
import { buttonVariants } from "@/components/ui/button-variants";
import {
  ArrowUpRight,
  CheckCircle2,
  XCircle,
  Zap,
  Shield,
  Clock,
  Users,
  Cpu,
  BarChart3,
  Target,
  ChevronRight,
  Quote,
  AlertTriangle,
  DollarSign,
  Calendar,
  MessageSquare,
  MapPin,
  Filter,
} from "lucide-astro";
import BackgroundGrid from "@/components/home/BackgroundGrid.astro";
import TeamImage from "@/assets/team-collaboration.jpg";

const stats = [
  { value: "6", suffix: " weeks", label: "Average delivery for standard web projects" },
  { value: "All", suffix: "", label: "Projects shipped on original timeline to date" },
  { value: "3", suffix: "", label: "AI agents built for US logistics startup in Q1 2026" },
  { value: "100", suffix: "%", label: "Transparent billing — zero surprise invoices" },
];

const clientPains = [
  {
    icon: DollarSign,
    title: "Scope Creep After the Contract",
    description: "You signed a quote for 40 hours. Now they're saying it's going to take 200. The budget is blown before the first review.",
    frequency: "Happens in 67% of agency projects industry-wide",
  },
  {
    icon: Calendar,
    title: "Launches That Never Launch",
    description: "It's been 4 months. The website was supposed to take 6 weeks. You're still waiting for 'final' revisions.",
    frequency: "Average software project runs 2.3x over schedule",
  },
  {
    icon: MessageSquare,
    title: "Disappearing Teams",
    description: "You signed with a senior team. Now your project is handled by juniors you've never met, and emails go unanswered for days.",
    frequency: "70% of clients cite poor communication as top frustration",
  },
  {
    icon: AlertTriangle,
    title: "Tech Debt from Day One",
    description: "The 'modern' website they built runs on PHP and WordPress from 2012. Page speed is terrible. Google rankings are dropping.",
    frequency: "Sites built on legacy stacks lose 50% more traffic yearly",
  },
];

// Group labels for filter UI
const competitorGroups = [
  { id: "all", label: "All" },
  { id: "vadodara", label: "Vadodara" },
  { id: "gujarat", label: "Gujarat-wide" },
  { id: "startup", label: "Startup-focused" },
  { id: "enterprise", label: "Enterprise" },
];

const competitors = [
  {
    name: "Pavans Group",
    founded: "2011",
    location: "Vadodara, Gujarat",
    website: "pavansgroup.com",
    clutch: "https://clutch.co/profile/pavans-group",
    tags: ["vadodara", "startup"],
    techStack: ["Laravel", "CodeIgniter", "PHP", "MySQL", "WordPress", "Flutter"],
    aiServices: "No dedicated AI services",
    reviews: "19 verified reviews on Clutch · All positive",
    verdict: "One of Vadodara's most reviewed agencies — solid reputation, startup-friendly pricing. Their stack is Laravel, PHP, and WordPress. Reliable for standard projects. No dedicated AI services — if your roadmap includes LLM integration, intelligent automation, or AI agents, you'll hit a ceiling before you reach your goal.",
    goodFor: "Flutter apps, MERN stack web builds, WordPress projects with no AI component",
    notGoodFor: "AI-powered products, modern frontend performance, or projects that will scale with AI",
  },
  {
    name: "Immence",
    founded: "2021",
    location: "Vadodara, Gujarat",
    website: "immence.com",
    clutch: "https://clutch.co/profile/immence",
    tags: ["vadodara", "startup"],
    techStack: ["Modern stack", "Startup-focused", "Mobile apps"],
    aiServices: "No dedicated AI architecture",
    reviews: "6 reviews, all 5.0 on GoodFirms · Strong communication",
    verdict: "Young, startup-focused, well-reviewed — essentially the same age as us, targeting the same market. Good communication and flexibility. The weakness is scale: small team, no dedicated AI architecture. If you're building past MVP stage with AI in the roadmap, they may not be the right long-term partner.",
    goodFor: "Early-stage startups needing a flexible, communicative small team",
    notGoodFor: "Scaling past MVP, AI architecture, or projects needing a larger delivery team",
  },
  {
    name: "Atyantik Technologies",
    founded: "2015",
    location: "Vadodara, Gujarat",
    website: "atyantik.com",
    clutch: "https://clutch.co/profile/atyantik-technologies",
    tags: ["vadodara", "startup"],
    techStack: ["PHP", "Laravel", "React", "PWA", "Kotlin"],
    aiServices: "No dedicated AI service lines",
    reviews: "3 Clutch reviews · 4.6/5 Glassdoor (24 employee reviews)",
    verdict: "Strong work culture, solid portfolio in PWA and e-commerce. Founded 2015, team of 50–100. Stack leans PHP and Laravel-heavy for backend. No dedicated AI service lines. If AI is part of your product roadmap, you'll need a different partner for that layer.",
    goodFor: "Standard web apps, e-commerce, PWA builds, mid-market projects",
    notGoodFor: "AI-powered projects, modern frontend-first builds, or startup speed requirements",
  },
  {
    name: "Megh Technologies",
    founded: "2007",
    location: "Vadodara, Gujarat",
    website: "meghtechnologies.com",
    clutch: "https://clutch.co/profile/megh-technologies",
    tags: ["vadodara", "enterprise"],
    techStack: ["PHP", "Laravel", "Python", "Azure", "SaaS", "ERP"],
    aiServices: "Not designed for AI-first builds",
    reviews: "Fortune 500 clients: TBEA, Xylem, L&T, GE, 20 Microns",
    verdict: "The go-to agency for Vadodara's manufacturing and industrial sector. 15+ years, impressive enterprise client list. Strong in ERP and digital transformation for large industrial businesses. Not designed for startups, consumer apps, or modern AI-first builds. Different swim lane — if you're in manufacturing at scale, they're excellent.",
    goodFor: "Manufacturing ERP, large industrial enterprise, 15+ year legacy systems",
    notGoodFor: "Startups, consumer apps, AI integration, modern frontend, fast turnarounds",
  },
  {
    name: "Rishabh Software",
    founded: "2000",
    location: "Vadodara HQ · US, UK, Australia offices",
    website: "rishabhsoftware.com",
    clutch: "https://clutch.co/profile/rishabh-software",
    tags: ["vadodara", "enterprise"],
    techStack: [".NET", "C#", "Java", "Angular", "Azure", "Enterprise scale"],
    aiServices: "No dedicated AI service lines",
    reviews: "28 Clutch reviews · 800+ staff · 1,400+ projects delivered",
    verdict: "One of Gujarat's most established agencies — 25 years of history, global offices, Fortune 500 clients. If you have a $500K+ budget and 6-month timelines, Rishabh is excellent. For startups or SMBs who need to ship fast, their enterprise process will slow you down and stretch your budget. No dedicated AI service lines.",
    goodFor: "Large enterprise, global delivery, long-term contracts, $500K+ budgets",
    notGoodFor: "Startups, SMBs, fast turnarounds, AI-first builds, lean budgets",
  },
  {
    name: "Helios Solutions",
    founded: "2006",
    location: "Vadodara, Gujarat",
    website: "helios-solutions.in",
    clutch: "https://clutch.co/profile/helios-solutions-0",
    tags: ["vadodara", "enterprise"],
    techStack: ["Web", "Mobile", "E-commerce", "Healthcare IT"],
    aiServices: "No dedicated AI offering",
    reviews: "~75 employees · Mixed public reviews — 1-star review on GoodFirms worth reading",
    verdict: "Nearly 20 years in Vadodara, focused on web, mobile, and e-commerce across healthcare, retail, and finance. Established client base. Public reviews are mixed — there is a 1-star GoodFirms review worth reading before committing. No dedicated AI offering.",
    goodFor: "Traditional web and mobile for established healthcare, retail, finance businesses",
    notGoodFor: "AI integration, modern stack, transparent billing guarantees, startups",
  },
  {
    name: "Novumlogic Technologies",
    founded: "Unknown",
    location: "Vadodara, Gujarat · US HQ",
    website: "novumlogic.com",
    clutch: "https://clutch.co/profile/novumlogic-technologies",
    tags: ["vadodara", "enterprise"],
    techStack: ["AI listed as core service", "Enterprise-grade", "$30–70/hr"],
    aiServices: "Explicitly lists AI as a service — one of few in Vadodara",
    reviews: "Two-time TechBehemoths award winner",
    verdict: "One of the few Vadodara agencies where AI is a stated service, not just a keyword. Higher pricing ($30–70/hr), US headquarters. Good option if you have the budget and need enterprise-grade AI. We differentiate on local presence, startup-friendly pricing, and 4 structured service lines vs their generalist AI offering.",
    goodFor: "Enterprise-grade AI with $30–70/hr budget, US-market-first approach",
    notGoodFor: "Local Gujarat clients, budget-conscious projects, startup timelines",
  },
  {
    name: "Tntra",
    founded: "Unknown",
    location: "Vadodara, Gujarat",
    website: "tntra.io",
    clutch: "https://clutch.co/profile/tntra",
    tags: ["vadodara", "enterprise"],
    techStack: ["AI-first positioning", "IP-led", "$30–70/hr", "50–249 staff"],
    aiServices: "Self-describes as 'AI-first, IP-led innovation ecosystem'",
    reviews: "Larger organisation · Enterprise presence",
    verdict: "The one Vadodara competitor also claiming an 'AI-first' positioning. Larger team, higher pricing. Worth comparing directly — but the question to ask any AI-first agency is the same: what specific AI service lines do you offer, and what have you actually deployed for clients? We're happy to answer that. See our AI services page.",
    goodFor: "Large enterprises wanting an AI-first partner with proven scale and IP",
    notGoodFor: "Startups or mid-market looking for agile delivery and startup-range pricing",
  },
  {
    name: "Alian Software",
    founded: "2010",
    location: "Ahmedabad, Gujarat",
    website: "aliansoftware.com",
    clutch: "https://clutch.co/profile/alian-software",
    tags: ["gujarat", "startup"],
    techStack: ["WordPress", "PHP", "MySQL", "jQuery", "reCAPTCHA"],
    aiServices: "Single sub-item buried under 'Other Services'",
    reviews: "35 Clutch reviews, 5.0 rating · 3.8 Trustpilot with billing complaints",
    verdict: "Established agency in Ahmedabad with a large team and strong Clutch numbers. Their Trustpilot record tells a different story — verified reviews citing estimates ballooning from 10 hours to 150 hours with broken final products delivered. AI is a checkbox, not a service line. Tech stack is 2012-era PHP and WordPress.",
    goodFor: "Simple WordPress sites where the only filter is price",
    notGoodFor: "AI-powered projects, fast-moving startups, clients who need billing transparency",
  },
  {
    name: "IndaPoint Technologies",
    founded: "Unknown",
    location: "Vadodara, Gujarat · US office",
    website: "indapoint.com",
    clutch: "https://clutch.co/profile/indapoint-technologies",
    tags: ["vadodara", "enterprise"],
    techStack: ["Enterprise-facing", "AI pivoting", "Web + mobile"],
    aiServices: "Explicitly pivoting to AI — recent repositioning",
    reviews: "Enterprise clients including Zebra Technologies",
    verdict: "US and Vadodara offices, explicitly repositioning toward AI, serving enterprise clients like Zebra Technologies. US-market-first focus — likely not competing for your local Gujarat clients, but worth knowing. Their AI pivot is recent, not architectural.",
    goodFor: "Enterprise clients wanting US-market-first delivery with India production",
    notGoodFor: "Local Gujarat startups, SMBs, budget-conscious projects",
  },
];

const techComparison = [
  {
    feature: "Modern JavaScript Framework",
    aexawareLabel: "Astro + React + Next.js",
    competitorLabel: "PHP + jQuery (most), Bootstrap (some)",
    whyItMatters: "Modern frameworks are 40–60% faster and score higher on Core Web Vitals — directly affecting your Google ranking and conversion rate.",
  },
  {
    feature: "AI-First Architecture",
    aexawareLabel: "4 dedicated AI service lines",
    competitorLabel: "0–1 services listed as afterthought",
    whyItMatters: "AI built into architecture from day one costs 30% less to integrate than bolting it on after launch.",
  },
  {
    feature: "Page Speed Optimization",
    aexawareLabel: "Core Web Vitals optimized pre-launch",
    competitorLabel: "Not mentioned by most",
    whyItMatters: "Every 1-second delay costs 7% of conversions. We optimize for speed before the first line goes live.",
  },
  {
    feature: "Transparent Pricing",
    aexawareLabel: "Fixed-scope quotes upfront",
    competitorLabel: "Hourly billing — estimates only",
    whyItMatters: "You know exactly what you're spending before we write a single line of code. No '150 hours when we quoted 15.'",
  },
  {
    feature: "Modern CI/CD Pipeline",
    aexawareLabel: "GitHub Actions + Vercel",
    competitorLabel: "Traditional deployment (most)",
    whyItMatters: "Automated deployment means you get updates in hours, not weeks of manual QA cycles.",
  },
  {
    feature: "API-First Design",
    aexawareLabel: "REST + GraphQL ready",
    competitorLabel: "Monolithic WordPress or REST only",
    whyItMatters: "When you add mobile, IoT, or third-party AI integrations later, GraphQL cuts development time in half.",
  },
  {
    feature: "Right Tool for the Job",
    aexawareLabel: "Laravel · WordPress · Next.js · Astro",
    competitorLabel: "Single-stack approach (most)",
    whyItMatters: "A marketing site gets WordPress or Astro. A SaaS product gets Next.js. An enterprise backend gets Laravel. We don't charge enterprise rates for a WordPress build.",
  },
];

const aexawareAIServices = [
  { name: "AI/ML Integration", path: "/services/ai-ml-integration", icon: Cpu, description: "LLM agents, TensorFlow, PyTorch integration" },
  { name: "Generative AI", path: "/services/generative-ai", icon: Zap, description: "GPT, Claude, custom AI model development" },
  { name: "AI Agents", path: "/services/ai-agent-development", icon: Target, description: "Autonomous AI agents for business automation" },
  { name: "Data Science", path: "/services/data-science", icon: BarChart3, description: "Predictive analytics, data pipelines" },
];

const differentiators = [
  {
    icon: Zap,
    title: "AI-First by Design",
    description: "Where competitors treat AI as an afterthought, we've built four distinct AI service lines. Your project starts with AI architecture from day one — not bolted on after scope is locked.",
    stat: "3 AI agents shipped for US logistics startup in Q1 2026",
  },
  {
    icon: Shield,
    title: "Transparent Billing",
    description: "No hidden hours or scope creep. Detailed technical scoping before any quote. Fixed prices backed by thorough requirements analysis. You know what you're spending before we write a line.",
    stat: "100% on-time delivery, zero surprise invoices since launch",
  },
  {
    icon: Clock,
    title: "Right Tool for the Job",
    description: "Laravel, WordPress, React, Next.js, Astro — we choose the right framework for your project. A marketing site gets WordPress or Astro. A SaaS product gets Next.js. An enterprise backend gets Laravel. We know which belongs where.",
    stat: "We don't charge enterprise rates for a WordPress build",
  },
  {
    icon: Users,
    title: "Startup DNA",
    description: "We think like founders, not bureaucrats. Agile methodology, fast iterations, direct communication with the people actually building your product — not account managers relaying messages.",
    stat: "Every project delivered on original timeline to date",
  },
];
---

<Layout
  title="Why Aexaware vs Other Software Agencies in Gujarat | Honest Comparison"
  description="How does Aexaware compare to Rishabh Software, Atyantik, Pavans Group, Megh Technologies, and Alian? We break it down honestly — stack, pricing, AI capability, and delivery track record."
>
  <Fragment slot="head">
    <meta name="robots" content="index, follow" />
  </Fragment>

  <section class="relative py-32 overflow-hidden">
    <BackgroundGrid density="md" mask="both" class="absolute inset-0 -z-10" />

    <div class="container-normal">

      {/* ── HERO ── */}
      <div class="text-center max-w-4xl mx-auto mb-16 px-4">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-primary/10 text-primary text-sm font-medium mb-6">
          <BarChart3 class="h-4 w-4" />
          Competitive Intelligence · Updated April 2026
        </div>
        <h1 class="font-heading text-4xl sm:text-5xl md:text-6xl font-bold text-foreground mb-6 leading-tight">
          Newer agency. Sharper tech.<br />
          <span class="text-primary">Zero billing surprises.</span>
        </h1>
        <p class="text-lg md:text-xl text-muted-foreground max-w-2xl mx-auto">
          Built in the AI era — not retrofitted into it. We analysed every major software agency in Gujarat so you don't have to.
        </p>
      </div>

      {/* ── STATS BAR — visible immediately ── */}
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6 mb-16 max-w-4xl mx-auto px-4">
        {stats.map((stat) => (
          <div class="bg-background rounded-card-lg p-4 md:p-6 border border-border/50 text-center">
            <div class="text-3xl sm:text-4xl md:text-5xl font-bold text-primary mb-1 md:mb-2 leading-none">
              {stat.value}<span class="text-xl md:text-2xl">{stat.suffix}</span>
            </div>
            <div class="text-xs sm:text-sm text-muted-foreground leading-tight">{stat.label}</div>
          </div>
        ))}
      </div>

      {/* ── TEAM PHOTO ── */}
      <div class="mb-16 md:mb-20 max-w-3xl mx-auto px-4">
        <div class="relative rounded-card-lg overflow-hidden border border-border/50">
          <img
            src={TeamImage.src}
            alt="Aexaware team collaborating on a client project in Vadodara"
            class="w-full h-48 sm:h-56 md:h-80 object-cover"
          />
          <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/80 to-transparent p-4 md:p-6">
            <p class="text-white font-medium text-sm md:text-base">Real people. Real team. Building your project.</p>
          </div>
        </div>
      </div>

      {/* ── PAIN SECTION ── */}
      <div class="mb-20">
        <div class="text-center mb-12">
          <h2 class="text-3xl md:text-4xl font-bold text-foreground mb-4">
            The Problems <span class="text-destructive">We Hear Every Week</span>
          </h2>
          <p class="text-lg text-muted-foreground max-w-2xl mx-auto">
            Every week, we talk to clients who just finished working with another agency. Here's what they tell us went wrong.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-10">
          {clientPains.map((pain) => (
            <div class="bg-secondary/20 rounded-card-lg p-6 border border-border/50">
              <div class="flex items-start gap-4">
                <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-destructive/10 text-destructive">
                  <pain.icon class="h-6 w-6" />
                </div>
                <div>
                  <h3 class="font-bold text-lg text-foreground mb-2">{pain.title}</h3>
                  <p class="text-muted-foreground mb-3">{pain.description}</p>
                  <p class="text-xs text-muted-foreground/70 italic border-l-2 border-destructive/30 pl-3">{pain.frequency}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      {/* ── LOCAL SEO SECTION — standalone, indexed by Google ── */}
      <div class="mb-20">
        <div class="max-w-4xl mx-auto bg-secondary/20 rounded-card-lg border border-border/50 p-8">
          <div class="flex items-center gap-2 mb-4">
            <MapPin class="h-5 w-5 text-primary" />
            <h2 class="text-xl font-bold text-foreground">Why Gujarat businesses choose Aexaware</h2>
          </div>
          <p class="text-muted-foreground leading-relaxed">
            Gujarat has over 100 registered IT companies. Vadodara alone has 20+. The challenge isn't finding a developer — it's finding one who treats AI as a core architecture decision, not a feature bolted on after launch. We're based in Vadodara and work with clients across <strong class="text-foreground">Anand, Surat, Ahmedabad</strong>, and internationally. We understand local business realities — the pace, the budget constraints, the industries — and pair that with a tech stack that competes with agencies in Bangalore and Pune, at Gujarat pricing. If you're in Anand in agri-tech or dairy, or in Vadodara in manufacturing, logistics, or education — we've either worked in your sector or studied it closely enough to hit the ground running.
          </p>
        </div>
      </div>

      {/* ── COMPETITOR CARDS SECTION ── */}
      <div class="mb-20">
        <div class="text-center mb-4">
          <h2 class="text-3xl md:text-4xl font-bold text-foreground mb-4">
            Every Major Agency in Gujarat — <span class="text-primary">Honestly Reviewed</span>
          </h2>
          <p class="text-lg text-muted-foreground max-w-2xl mx-auto mb-6">
            Every agency in this list is good at something. The question is whether what they're good at matches what you actually need.
          </p>
          <p class="text-xs text-muted-foreground/60 italic max-w-2xl mx-auto">
            All information sourced from publicly available profiles on Clutch, GoodFirms, LinkedIn, and company websites, updated April 2026.
            If you represent a listed company and want to suggest a correction, email <a href="mailto:info@aexaware.com" class="text-primary hover:underline">info@aexaware.com</a>.
          </p>
        </div>

        {/* Filter Bar */}
        <div class="flex flex-wrap justify-center gap-2 mb-10" id="filter-bar">
          {competitorGroups.map((group) => (
            <button
              data-filter={group.id}
              class={`filter-btn px-4 py-2 rounded-full text-sm font-medium border transition-all duration-200 ${
                group.id === "all"
                  ? "bg-primary text-primary-foreground border-primary"
                  : "bg-background text-muted-foreground border-border/50 hover:border-primary/50 hover:text-foreground"
              }`}
            >
              {group.label}
            </button>
          ))}
        </div>

        {/* Group: Vadodara */}
        <div class="mb-4">
          <p class="text-xs font-medium text-muted-foreground/60 uppercase tracking-widest mb-4 px-1">Vadodara competitors</p>
          <div class="space-y-6" id="cards-vadodara">
            {competitors.filter(c => c.tags.includes("vadodara")).map((competitor) => (
              <div class="competitor-card bg-background rounded-card-lg border border-border/50 overflow-hidden" data-tags={competitor.tags.join(" ")}>
                {/* Header */}
                <div class="p-5 border-b border-border/50 bg-secondary/20 flex flex-col md:flex-row md:items-center justify-between gap-3">
                  <div>
                    <h3 class="text-lg font-bold text-foreground">{competitor.name}</h3>
                    <p class="text-sm text-muted-foreground">Founded {competitor.founded} · {competitor.location}</p>
                  </div>
                  <div class="flex flex-wrap gap-3">
                    <a href={`https://${competitor.website}`} target="_blank" rel="nofollow noopener noreferrer"
                      class="text-sm text-primary hover:text-primary/80 flex items-center gap-1">
                      {competitor.website} <ArrowUpRight class="h-3 w-3" />
                    </a>
                    <a href={competitor.clutch} target="_blank" rel="nofollow noopener noreferrer"
                      class="text-sm text-primary hover:text-primary/80 flex items-center gap-1">
                      Clutch <ArrowUpRight class="h-3 w-3" />
                    </a>
                  </div>
                </div>

                {/* Comparison grid */}
                <div class="grid grid-cols-1 md:grid-cols-2 gap-0">
                  <div class="p-5 border-b md:border-b-0 md:border-r border-border/50">
                    <h4 class="font-semibold text-sm text-muted-foreground mb-3 uppercase tracking-wide">What they offer</h4>
                    <ul class="space-y-2 text-sm">
                      <li><span class="text-muted-foreground">Stack: </span><span class="text-foreground">{competitor.techStack.join(", ")}</span></li>
                      <li><span class="text-muted-foreground">AI: </span><span class="text-foreground">{competitor.aiServices}</span></li>
                      <li><span class="text-muted-foreground">Track record: </span><span class="text-foreground">{competitor.reviews}</span></li>
                    </ul>
                  </div>
                  <div class="p-5 bg-primary/5">
                    <h4 class="font-semibold text-sm text-primary mb-3 uppercase tracking-wide">Aexaware advantage</h4>
                    <ul class="space-y-2 text-sm">
                      <li><span class="text-muted-foreground">Stack: </span><span class="text-foreground">Laravel · WordPress · Astro · React · Next.js · TypeScript · Python</span></li>
                      <li><span class="text-muted-foreground">AI: </span><span class="text-foreground">4 dedicated service lines — ML, GenAI, Agents, Data Science</span></li>
                      <li><span class="text-muted-foreground">Delivery: </span><span class="text-foreground">Every project on original timeline to date</span></li>
                      <li><span class="text-muted-foreground">Billing: </span><span class="text-foreground">Fixed-scope quotes · Zero surprise invoices</span></li>
                    </ul>
                  </div>
                </div>

                {/* Verdict */}
                <div class="p-5 border-t border-border/30 bg-secondary/5">
                  <p class="text-sm text-muted-foreground leading-relaxed mb-4">{competitor.verdict}</p>
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                    <div class="p-3 bg-secondary/30 rounded-lg">
                      <p class="text-xs font-semibold text-muted-foreground uppercase tracking-wide mb-1">Better choice if</p>
                      <p class="text-sm text-foreground">{competitor.goodFor}</p>
                    </div>
                    <div class="p-3 bg-primary/5 border border-primary/20 rounded-lg">
                      <p class="text-xs font-semibold text-primary uppercase tracking-wide mb-1">Choose us instead if</p>
                      <p class="text-sm text-foreground">{competitor.notGoodFor}</p>
