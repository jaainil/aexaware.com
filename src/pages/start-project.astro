---
import Layout from '@/layouts/Layout.astro';
import ProjectCalculator from '@/components/ProjectCalculator.astro';
import BackgroundGrid from '@/components/astro/BackgroundGrid.astro';
---

<Layout 
  title="Start Your Project | Aexaware Infotech" 
  description="Get a free estimate for your web, mobile, or AI project. Use our interactive calculator to tell us about your vision."
>
  {/* FIX: Use min-h-[100dvh] for mobile viewport stability */}
  <main class="relative w-full min-h-[100dvh] flex flex-col pt-[var(--navbar-height)] pb-16 lg:pb-24 overflow-hidden">
    
    {/* Modern Grid Background */}
    {/* FIX: Semantic Grid Background for Dark Mode support */}
    <BackgroundGrid density="sm" mask="top" />
    <div class="absolute inset-0 bg-gradient-to-b from-primary/5 via-transparent to-transparent -z-10" />

    {/* Content */}
    <div class="container-normal relative z-10 flex-1 flex flex-col items-center">
      <div class="text-center mb-16 space-y-6 max-w-3xl">
        <div class="inline-block px-4 py-1.5 rounded-full bg-primary/10 text-primary text-sm font-bold uppercase tracking-wider mb-4 border border-primary/20">
            Let's Collaborate
        </div>
        {/* FIX: Use font-heading */}
        <h1 class="font-heading font-bold text-5xl md:text-6xl lg:text-7xl tracking-tighter leading-none lg:leading-[0.9] text-foreground text-balance">
          Let's Build Something <br/> <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-accent">Amazing.</span>
        </h1>
        <p class="text-xl text-muted-foreground leading-relaxed">
          Tell us a little about your project, and we'll help you bring it to life with a custom roadmap and estimate.
        </p>
        <p class="text-base text-muted-foreground">
          Prefer to talk? <a href="https://cal.com/aexaware-infotech" target="_blank" rel="noopener noreferrer" class="text-primary font-medium hover:underline">Book a free consultation call →</a>
        </p>
      </div>

      <div class="w-full">
         <ProjectCalculator />
      </div>
    </div>
  </main>
</Layout>