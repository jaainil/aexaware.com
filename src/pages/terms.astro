---
import Layout from "@/layouts/Layout.astro";
import { Schema } from "astro-seo-schema";
import {
  Scale,
  AlertTriangle,
  Ban,
  CreditCard,
  RefreshCw,
  Mail,
  Calendar,
  Sparkles,
  Globe,
  Users,
  Shield,
  Briefcase,
  Link,
  Server,
  Gavel,
  Code2,
} from "lucide-astro";
import BackgroundGrid from "@/components/home/BackgroundGrid.astro";

const lastUpdated = "December 30, 2025";
const siteUrl = Astro.site || "https://aexaware.com";
---

<Layout
  title="Terms & Conditions – Aexaware Infotech"
  description="Read the terms and conditions governing the use of Aexaware Infotech's services and website."
>
  <Fragment slot="head">
    <Schema
      item={{
        "@context": "https://schema.org",
        "@type": "WebPage",
        name: "Terms & Conditions",
        description:
          "Read the terms and conditions governing the use of Aexaware Infotech's services and website.",
        url: new URL("/terms", siteUrl).href,
        dateModified: "2025-12-30",
        publisher: {
          "@type": "Organization",
          name: "Aexaware Infotech",
          url: siteUrl.toString(),
        },
      }}
    />
    <Schema
      item={{
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: [
          {
            "@type": "ListItem",
            position: 1,
            name: "Home",
            item: siteUrl.toString(),
          },
          {
            "@type": "ListItem",
            position: 2,
            name: "Terms & Conditions",
          },
        ],
      }}
    />
  </Fragment>
  <!-- Hero Section -->
  <section
    class="relative w-full min-h-dvh flex flex-col justify-center pt-(--navbar-height) pb-16 lg:pb-24 overflow-hidden border-b border-border/40"
  >
    <BackgroundGrid density="sm" mask="top" />
    <div
      class="absolute inset-0 bg-linear-to-b from-primary/5 via-transparent to-transparent -z-10"
    >
    </div>

    <div class="container-normal relative z-10">
      <div class="max-w-4xl mx-auto text-center">
        <div
          class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-primary/20 bg-primary/5 backdrop-blur-xs mb-8"
        >
          <Sparkles className="w-4 h-4 text-primary" />
          <span
            class="text-sm font-semibold text-primary tracking-wide uppercase"
            >Legal</span
          >
        </div>

        <h1
          class="font-heading font-bold text-4xl sm:text-6xl lg:text-8xl tracking-tighter leading-none lg:leading-[0.9] text-foreground mb-8 text-balance"
        >
          Terms & <br />
          <span class="text-primary font-serif">Conditions.</span>
        </h1>
        <p
          class="mx-auto mt-8 max-w-2xl text-xl text-muted-foreground leading-relaxed text-pretty"
        >
          By accessing or using this website, you agree to be bound by these
          Terms & Conditions. If you do not agree, please do not use our website
          or services.
        </p>
        <div
          class="mt-8 flex items-center justify-center gap-2 text-sm text-muted-foreground"
        >
          <Calendar className="w-4 h-4" />
          <span>Effective Date: {lastUpdated}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Content Section -->
  <section class="section-padding bg-background">
    <div class="container-normal">
      <!-- Introduction - About Us -->
      <div
        class="p-8 rounded-section bg-secondary/30 border border-border/50 mb-12"
      >
        <div class="flex items-start gap-4">
          <div class="p-3 rounded-xl bg-primary/10 text-primary shrink-0">
            <Users className="w-6 h-6" />
          </div>
          <div>
            <h2 class="text-xl font-bold text-foreground mt-0 mb-2">
              1. About Us
            </h2>
            <p class="text-muted-foreground mb-4">
              Aexaware ("we", "our", or "us") is an IT and software development
              agency based in Vadodara, Gujarat, India, serving clients
              globally.
            </p>
            <p class="text-muted-foreground mb-0">
              We provide web, mobile, cloud, AI, and digital solutions, and
              showcase our work, services, and blogs through this website.
            </p>
          </div>
        </div>
      </div>

      <div class="grid gap-8 lg:grid-cols-2">
        <!-- Section 2 - Purpose of the Website -->
        <div class="p-8 rounded-card-lg bg-card border border-border/50">
          <div class="flex items-center gap-3 mb-6">
            <div class="p-2 rounded-lg bg-primary/10 text-primary">
              <Globe className="w-5 h-5" />
            </div>
            <h2 class="text-xl font-heading font-bold text-foreground m-0">
              2. Purpose of the Website
            </h2>
          </div>

          <div class="space-y-4 text-muted-foreground">
            <p>The website is intended to:</p>
            <ul class="space-y-2 list-none pl-0">
              <li class="flex items-start gap-2">
                <span class="text-primary">•</span><span
                  >Provide information about our services</span
                >
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary">•</span><span
                  >Showcase our portfolio and past projects</span
                >
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary">•</span><span
                  >Publish blogs and technical content</span
                >
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary">•</span><span
                  >Allow users to contact us for inquiries or collaborations</span
                >
              </li>
            </ul>
            <p class="text-sm italic">
              The content on this website is for general informational purposes
              only.
            </p>
          </div>
        </div>

        <!-- Section 3 - Services -->
        <div class="p-8 rounded-card-lg bg-card border border-border/50">
          <div class="flex items-center gap-3 mb-6">
            <div class="p-2 rounded-lg bg-primary/10 text-primary">
              <Briefcase className="w-5 h-5" />
            </div>
            <h2 class="text-xl font-heading font-bold text-foreground m-0">
              3. Services
            </h2>
          </div>

          <div class="space-y-4 text-muted-foreground">
            <p>Aexaware offers services including but not limited to:</p>
            <ul class="space-y-2 list-none pl-0 text-sm">
              <li class="flex items-start gap-2">
                <span class="text-primary">•</span><span>Web Development</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary">•</span><span
                  >Mobile App Development</span
                >
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary">•</span><span>UI/UX Design</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary">•</span><span
                  >Custom Software Solutions</span
                >
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary">•</span><span
                  >E-Commerce Development</span
                >
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary">•</span><span
                  >Cloud & DevOps Services</span
                >
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary">•</span><span
                  >AI & Machine Learning Integration</span
                >
              </li>
            </ul>
            <p class="text-sm italic">
              Service details, scope, timelines, and deliverables are defined
              case-by-case and may be governed by separate written agreements.
            </p>
          </div>
        </div>

        <!-- Section 4 - Geographic Scope -->
        <div class="p-8 rounded-card-lg bg-card border border-border/50">
          <div class="flex items-center gap-3 mb-6">
            <div class="p-2 rounded-lg bg-success/10 text-success">
              <Globe className="w-5 h-5" />
            </div>
            <h2 class="text-xl font-heading font-bold text-foreground m-0">
              4. Geographic Scope
            </h2>
          </div>

          <div class="space-y-4 text-muted-foreground">
            <p>
              While we are based in India, our services are offered to clients
              globally.
            </p>
            <div class="p-4 rounded-card bg-primary/5 border border-primary/20">
              <p class="text-sm mb-0">
                🌍 <strong class="text-foreground">Global Reach:</strong> We serve
                clients across all continents and time zones.
              </p>
            </div>
          </div>
        </div>

        <!-- Section 5 - User Responsibilities -->
        <div class="p-8 rounded-card-lg bg-card border border-border/50">
          <div class="flex items-center gap-3 mb-6">
            <div class="p-2 rounded-lg bg-warning/10 text-warning">
              <Users className="w-5 h-5" />
            </div>
            <h2 class="text-xl font-heading font-bold text-foreground m-0">
              5. User Responsibilities
            </h2>
          </div>

          <div class="space-y-4 text-muted-foreground">
            <p>By using this website, you agree to:</p>
            <ul class="space-y-2 list-none pl-0">
              <li class="flex items-start gap-2">
                <span class="text-primary">•</span><span
                  >Provide accurate and truthful information when submitting
                  forms</span
                >
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary">•</span><span
                  >Use the website only for lawful purposes</span
                >
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary">•</span><span
                  >Not misuse, disrupt, or attempt unauthorized access to the
                  website or its systems</span
                >
              </li>
            </ul>
            <p class="text-sm italic">
              We reserve the right to take appropriate action if misuse is
              detected.
            </p>
          </div>
        </div>

        <!-- Section 6 - Right to Refuse or Terminate Service -->
        <div class="p-8 rounded-card-lg bg-card border border-border/50">
          <div class="flex items-center gap-3 mb-6">
            <div class="p-2 rounded-lg bg-destructive/10 text-destructive">
              <Ban className="w-5 h-5" />
            </div>
            <h2 class="text-xl font-heading font-bold text-foreground m-0">
              6. Right to Refuse or Terminate Service
            </h2>
          </div>

          <div class="space-y-4 text-muted-foreground">
            <p>Aexaware reserves the right to:</p>
            <ul class="space-y-2 list-none pl-0">
              <li class="flex items-start gap-2">
                <span class="text-primary">•</span><span
                  >Refuse service requests</span
                >
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary">•</span><span>Decline projects</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary">•</span><span
                  >Terminate communication or engagement</span
                >
              </li>
            </ul>
            <p class="text-sm">
              This may occur if collaboration is deemed unfeasible,
              inappropriate, or if mutual understanding cannot be achieved.
            </p>
          </div>
        </div>

        <!-- Section 7 - Payments & Pricing -->
        <div class="p-8 rounded-card-lg bg-card border border-border/50">
          <div class="flex items-center gap-3 mb-6">
            <div class="p-2 rounded-lg bg-info/10 text-info">
              <CreditCard className="w-5 h-5" />
            </div>
            <h2 class="text-xl font-heading font-bold text-foreground m-0">
              7. Payments & Pricing
            </h2>
          </div>

          <div class="space-y-4 text-muted-foreground">
            <p>
              We do not accept payments directly through the website. Pricing is
              quotation-based and may be negotiated per project.
            </p>
            <div
              class="p-4 rounded-card bg-secondary/30 border border-border/50"
            >
              <h4 class="font-semibold text-foreground mb-3">
                Typical Payment Structure:
              </h4>
              <ul class="text-sm space-y-2 mb-0 list-none pl-0">
                <li class="flex items-center gap-2">
                  <span class="text-primary font-bold">30%</span> Upfront (project
                  kickoff)
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-primary font-bold">40%</span> During development
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-primary font-bold">20%</span> Before launch
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-primary font-bold">10%</span> After 30 days of
                  post-launch support
                </li>
              </ul>
            </div>
            <p class="text-sm italic">
              Exact payment terms are defined in project proposals or
              agreements.
            </p>
          </div>
        </div>

        <!-- Section 8 - Refund Policy -->
        <div class="p-8 rounded-card-lg bg-card border border-border/50">
          <div class="flex items-center gap-3 mb-6">
            <div class="p-2 rounded-lg bg-destructive/10 text-destructive">
              <RefreshCw className="w-5 h-5" />
            </div>
            <h2 class="text-xl font-heading font-bold text-foreground m-0">
              8. Refund Policy
            </h2>
          </div>

          <div class="space-y-4 text-muted-foreground">
            <div
              class="p-4 rounded-card bg-warning/5 border border-warning/20"
            >
              <p class="font-semibold text-foreground mb-2">
                ⚠️ Non-Refundable Payments
              </p>
              <p class="text-sm mb-0">
                All payments made to Aexaware are non-refundable, unless
                explicitly stated otherwise in a written agreement.
              </p>
            </div>
          </div>
        </div>

        <!-- Section 9 - Intellectual Property -->
        <div class="p-8 rounded-card-lg bg-card border border-border/50">
          <div class="flex items-center gap-3 mb-6">
            <div class="p-2 rounded-lg bg-primary/10 text-primary">
              <Code2 className="w-5 h-5" />
            </div>
            <h2 class="text-xl font-heading font-bold text-foreground m-0">
              9. Intellectual Property
            </h2>
          </div>

          <div class="space-y-4 text-muted-foreground">
            <div class="space-y-3">
              <div
                class="p-3 rounded-card bg-secondary/30 border border-border/50"
              >
                <h4 class="font-semibold text-foreground mb-1 text-sm">
                  Website Content
                </h4>
                <p class="text-sm mb-0">
                  All content — including text, graphics, logos, designs, code,
                  and blog posts — is the intellectual property of Aexaware and
                  may not be copied, reproduced, or reused without written
                  permission.
                </p>
              </div>
              <div
                class="p-3 rounded-card bg-secondary/30 border border-border/50"
              >
                <h4 class="font-semibold text-foreground mb-1 text-sm">
                  Client Work
                </h4>
                <p class="text-sm mb-0">
                  Ownership of project deliverables is transferred to the client
                  only after full payment. Terms may vary depending on the
                  specific project agreement.
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Section 10 - Acceptable Use -->
        <div class="p-8 rounded-card-lg bg-card border border-border/50">
          <div class="flex items-center gap-3 mb-6">
            <div class="p-2 rounded-lg bg-warning/10 text-warning">
              <Shield className="w-5 h-5" />
            </div>
            <h2 class="text-xl font-heading font-bold text-foreground m-0">
              10. Acceptable Use
            </h2>
          </div>

          <div class="space-y-4 text-muted-foreground">
            <p>Users must not:</p>
            <ul class="space-y-2 list-none pl-0">
              <li class="flex items-start gap-2">
                <span class="text-destructive">✕</span><span
                  >Attempt to hack, scrape, or damage the website</span
                >
              </li>
              <li class="flex items-start gap-2">
                <span class="text-destructive">✕</span><span
                  >Upload malicious code or spam contact forms</span
                >
              </li>
              <li class="flex items-start gap-2">
                <span class="text-destructive">✕</span><span
                  >Engage in any activity that disrupts site functionality</span
                >
              </li>
            </ul>
          </div>
        </div>

        <!-- Section 11 - Third-Party Links -->
        <div class="p-8 rounded-card-lg bg-card border border-border/50">
          <div class="flex items-center gap-3 mb-6">
            <div class="p-2 rounded-lg bg-success/10 text-success">
              <Link className="w-5 h-5" />
            </div>
            <h2 class="text-xl font-heading font-bold text-foreground m-0">
              11. Third-Party Links
            </h2>
          </div>

          <div class="space-y-4 text-muted-foreground">
            <p>
              This website may contain links to third-party websites (e.g.,
              client sites, GitHub, social platforms).
            </p>
            <p class="text-sm italic">
              We are not responsible for the content, policies, or practices of
              third-party websites.
            </p>
          </div>
        </div>

        <!-- Section 12 - Disclaimer of Warranties -->
        <div class="p-8 rounded-card-lg bg-card border border-border/50">
          <div class="flex items-center gap-3 mb-6">
            <div class="p-2 rounded-lg bg-warning/10 text-warning">
              <AlertTriangle className="w-5 h-5" />
            </div>
            <h2 class="text-xl font-heading font-bold text-foreground m-0">
              12. Disclaimer of Warranties
            </h2>
          </div>

          <div class="space-y-4 text-muted-foreground">
            <p>
              The website and its content are provided <strong
                class="text-foreground">"as is"</strong
              > and <strong class="text-foreground">"as available"</strong>.
            </p>
            <p>We make no warranties regarding:</p>
            <ul class="space-y-2 list-none pl-0">
              <li class="flex items-start gap-2">
                <span class="text-primary">•</span><span
                  >Accuracy or completeness of content</span
                >
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary">•</span><span
                  >Uninterrupted or error-free operation</span
                >
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary">•</span><span
                  >Suitability of information for specific purposes</span
                >
              </li>
            </ul>
          </div>
        </div>

        <!-- Section 13 - Limitation of Liability -->
        <div class="p-8 rounded-card-lg bg-card border border-border/50">
          <div class="flex items-center gap-3 mb-6">
            <div class="p-2 rounded-lg bg-primary/10 text-primary">
              <Scale className="w-5 h-5" />
            </div>
            <h2 class="text-xl font-heading font-bold text-foreground m-0">
              13. Limitation of Liability
            </h2>
          </div>

          <div class="space-y-4 text-muted-foreground">
            <p>
              To the maximum extent permitted by law, Aexaware shall not be
              liable for:
            </p>
            <ul class="space-y-2 list-none pl-0">
              <li class="flex items-start gap-2">
                <span class="text-primary">•</span><span
                  >Any direct or indirect damages</span
                >
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary">•</span><span
                  >Loss of data, profits, or business opportunities</span
                >
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary">•</span><span
                  >Issues arising from reliance on website content</span
                >
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary">•</span><span
                  >Temporary unavailability or technical issues</span
                >
              </li>
            </ul>
          </div>
        </div>

        <!-- Section 14 - Suspension & Termination -->
        <div class="p-8 rounded-card-lg bg-card border border-border/50">
          <div class="flex items-center gap-3 mb-6">
            <div class="p-2 rounded-lg bg-muted/10 text-muted-foreground">
              <Server className="w-5 h-5" />
            </div>
            <h2 class="text-xl font-heading font-bold text-foreground m-0">
              14. Suspension & Termination
            </h2>
          </div>

          <div class="space-y-4 text-muted-foreground">
            <p>
              We reserve the right to suspend or block access to the website
              without prior notice if these Terms are violated.
            </p>
          </div>
        </div>

        <!-- Section 15 - Governing Law & Jurisdiction -->
        <div class="p-8 rounded-card-lg bg-card border border-border/50">
          <div class="flex items-center gap-3 mb-6">
            <div class="p-2 rounded-lg bg-primary/10 text-primary">
              <Gavel className="w-5 h-5" />
            </div>
            <h2 class="text-xl font-heading font-bold text-foreground m-0">
              15. Governing Law & Jurisdiction
            </h2>
          </div>

          <div class="space-y-4 text-muted-foreground">
            <p>These Terms & Conditions are governed by the laws of India.</p>
            <p>
              Any disputes shall be subject to the jurisdiction of courts in
              Gujarat, India.
            </p>
          </div>
        </div>

        <!-- Section 16 - Changes to These Terms -->
        <div class="p-8 rounded-card-lg bg-card border border-border/50">
          <div class="flex items-center gap-3 mb-6">
            <div class="p-2 rounded-lg bg-success/10 text-success">
              <RefreshCw className="w-5 h-5" />
            </div>
            <h2 class="text-xl font-heading font-bold text-foreground m-0">
              16. Changes to These Terms
            </h2>
          </div>

          <div class="space-y-4 text-muted-foreground">
            <p>We may update these Terms & Conditions at any time.</p>
            <p>
              Updates will be posted on this page, and continued use of the
              website constitutes acceptance of the revised terms.
            </p>
          </div>
        </div>
      </div>

      <!-- Contact Section -->
      <div
        class="mt-12 p-8 rounded-section bg-linear-to-br from-primary/5 to-accent/5 border border-primary/20"
      >
        <div class="flex items-start gap-4">
          <div class="p-3 rounded-xl bg-primary/10 text-primary shrink-0">
            <Mail className="w-6 h-6" />
          </div>
          <div>
            <h2 class="text-xl font-bold text-foreground mt-0 mb-2">
              17. Contact Information
            </h2>
            <p class="text-muted-foreground mb-4">
              If you have questions about these Terms & Conditions, you can
              contact us at:
            </p>
            <div class="flex flex-wrap gap-6 text-sm">
              <p class="mb-0">
                <strong class="text-foreground">📧 Email:</strong>
                <a
                  href="mailto:contact@aexaware.com"
                  class="text-primary hover:underline">contact@aexaware.com</a
                >
              </p>
              <p class="mb-0">
                <strong class="text-foreground">📞 Phone:</strong>
                <a href="tel:+918140734392" class="text-primary hover:underline"
                  >+91 8140734392</a
                >
              </p>
              <p class="mb-0">
                <strong class="text-foreground">📍 Address:</strong> Vadodara, Gujarat,
                India
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
