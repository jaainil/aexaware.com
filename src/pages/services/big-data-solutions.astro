    iconColor: "text-destructive",
  },
  {
    id: "06",
    icon: Cpu,
    title: "Data Warehouse",
    desc: "High-performance analytical databases. Snowflake, BigQuery, Redshift, and custom solutions.",
    gradient: "from-info/20 to-info/20",
    iconColor: "text-info",
  },
];

const whyChooseUs = [
  {
    title: "Modern Architecture",
    desc: "Latest big data technologies for performance and scalability.",
  },
  {
    title: "Cost Optimization",
    desc: "Reduce data infrastructure costs by 40-60% with efficient design.",
  },
  {
    title: "Any Scale",
    desc: "Handle gigabytes to petabytes with the same expertise.",
  },
  {
    title: "Cloud-Native",
    desc: "Fully managed services that eliminate operational overhead.",
  },
  {
    title: "Real-Time Ready",
    desc: "Architecture built for both batch and streaming workloads.",
  },
  {
    title: "Enterprise Security",
    desc: "Encryption, access control, and compliance built in.",
