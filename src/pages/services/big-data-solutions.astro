---
import ServicePageLayout from "@/layouts/ServicePageLayout.astro";
import { Database, Server, Zap, Shield, Globe, Cpu, BarChart, PieChart, Monitor } from "lucide-astro";

const services = [
  {
    id: "01",
    icon: Database,
    title: "Data Lake & Warehouse",
    desc: "Scalable data lakes for raw data storage and high-performance analytical warehouses with Snowflake, BigQuery, and Redshift.",
    gradient: "from-primary/20 to-info/20",
    iconColor: "text-primary",
  },
  {
    id: "02",
    icon: Server,
    title: "ETL/ELT Pipelines",
    desc: "Automated data pipelines that extract, transform, and load data from any source to any destination. Batch and streaming ingestion.",
    gradient: "from-success/20 to-success/20",
    iconColor: "text-success",
  },
  {
    id: "03",
    icon: Zap,
    title: "Stream Processing",
    desc: "Real-time data processing for instant insights. Process millions of events per second with Apache Kafka and low-latency streaming.",
    gradient: "from-warning/20 to-warning/20",
    iconColor: "text-warning",
  },
  {
    id: "04",
    icon: BarChart,
    title: "Interactive Dashboards",
    desc: "Real-time BI dashboards with Tableau, Power BI, and Looker. Drill-down capabilities and customizable views for every stakeholder.",
    gradient: "from-primary/20 to-primary/20",
    iconColor: "text-primary",
  },
  {
    id: "05",
    icon: PieChart,
    title: "Business Intelligence",
    desc: "Executive dashboards, performance analytics, sales reporting, and market intelligence. Self-service BI that empowers non-technical users.",
    gradient: "from-info/20 to-info/20",
    iconColor: "text-info",
  },
  {
    id: "06",
    icon: Monitor,
    title: "Custom Visualizations",
    desc: "Unique visualizations with D3.js, ECharts, and Chart.js. Geographic maps, trend animations, and embeddable interactive graphics.",
    gradient: "from-destructive/20 to-destructive/20",
    iconColor: "text-destructive",
  },
  {
    id: "07",
    icon: Shield,
    title: "Data Governance & Quality",
    desc: "Data quality, lineage tracking, and compliance automation. Ensure your data is accurate, secure, auditable, and GDPR/HIPAA ready.",
    gradient: "from-success/20 to-success/20",
    iconColor: "text-success",
  },
  {
    id: "08",
    icon: Globe,
    title: "Cloud Data Platform",
    desc: "Modern data infrastructure on AWS, Azure, or GCP. Managed services that scale automatically with cost optimization built in.",
    gradient: "from-warning/20 to-warning/20",
    iconColor: "text-warning",
  },
];

const whyChooseUs = [
  {
    title: "Modern Architecture",
    desc: "Latest big data technologies for performance and scalability at any volume.",
  },
  {
    title: "Cost Optimization",
    desc: "Reduce data infrastructure costs by 40-60% with efficient design.",
  },
  {
    title: "Self-Service BI",
    desc: "Empower teams to explore data without depending on IT or analysts.",
  },
  {
    title: "Real-Time Ready",
    desc: "Architecture built for both batch and streaming workloads.",
  },
  {
    title: "Design Excellence",
    desc: "Visualizations that are both beautiful and effective at communicating insights.",
  },
  {
    title: "Enterprise Security",
    desc: "Encryption, access control, role-based permissions, and compliance built in.",
  },
];

const techStack = [
  "Apache Spark",
  "Airflow",
  "Apache Kafka",
  "Snowflake",
  "Databricks",
  "dbt",
  "Tableau",
  "Power BI",
  "Looker",
  "D3.js",
  "AWS",
  "Azure",
  "GCP",
  "Metabase",
];

const faqs = [
  {
    question: "What is a data lake and do I need one?",
    answer: "A data lake stores raw data in its native format, unlike structured data warehouses. You need one if you have diverse data sources (logs, sensors, social media), want to enable advanced analytics, or need to preserve data for future use cases. We often implement a lakehouse architecture that combines both.",
  },
  {
    question: "Which BI tool is right for our business?",
    answer: "The best tool depends on your needs: Tableau excels at visualization, Power BI offers excellent Microsoft integration, Looker is great for embedded analytics, and Metabase is ideal for self-service. We help you choose based on your requirements, budget, and existing tools.",
  },
  {
    question: "Can visualizations be embedded in our applications?",
    answer: "Yes, we embed dashboards and visualizations in web apps, mobile apps, and portals. We use APIs, embed codes, D3.js, and ECharts for deep integration with your existing products.",
  },
  {
    question: "How long does big data implementation take?",
    answer: "Basic data infrastructure and dashboards take 2-3 months, while enterprise-scale implementations take 6-12 months. We provide phased implementations so you can start seeing value quickly.",
  },
  {
    question: "Can you migrate our existing data to the cloud?",
    answer: "Yes, we have extensive experience migrating on-premise data infrastructure to AWS, Azure, or GCP. We minimize downtime and ensure data integrity throughout the migration.",
  },
  {
    question: "How do you ensure data security?",
    answer: "We implement encryption at rest and in transit, fine-grained access controls, audit logging, VPC isolation, and compliance with GDPR, HIPAA, and SOC 2 requirements.",
  },
];
---

<ServicePageLayout
  title="Data Engineering & Intelligence"
  description="Enterprise data engineering, big data architecture, business intelligence, and data visualization. Data lakes, ETL pipelines, interactive dashboards, and custom visualizations."
  heroBadge="Data Engineering & BI"
  heroTitle="Data at"
  heroSubtitle="Scale."
  heroDescription="From data lakes and ETL pipelines to interactive dashboards and business intelligence — we build the complete data infrastructure that powers data-driven enterprises and makes insights accessible to everyone."
  introTitle="Build, Process, Visualize"
  introText="Modern businesses generate more data than ever before. But data is only as good as your ability to capture, process, and understand it. Our data engineering services build scalable infrastructure that handles any volume, while our visualization and BI capabilities transform complex datasets into clear, compelling insights that drive action. From executive dashboards to real-time streaming analytics, we create the complete data stack that grows with your business."
  servicesTitle="Data Engineering & BI Services"
  servicesDescription="Infrastructure for the data age — from pipelines to dashboards."
  services={services}
  whyChooseUs={whyChooseUs}
  whyChooseTitle="Why Choose Aexaware for Data Engineering"
  whyChooseDescription="Enterprise-grade data engineering with stunning visualization."
  techStack={techStack}
  faqs={faqs}
/>
