---

<ServicePageLayout
  title="Big Data Solutions"
  description="Enterprise big data architecture and engineering. Data lakes, ETL pipelines, and scalable data infrastructure."
  heroBadge="Big Data"
  heroTitle="Data at"
  heroSubtitle="Scale."
  heroDescription="Big data solutions that handle any volume, velocity, and variety. From data lakes to real-time analytics, we build the infrastructure that powers data-driven enterprises."
  introTitle="Big Data, Big Results"
  introText="Modern businesses generate more data than ever before. Our big data solutions help you capture, process, and derive value from all your data - structured and unstructured, batch and streaming. We design and implement scalable architectures that grow with your business while keeping costs under control."
  servicesTitle="Big Data Services"
  servicesDescription="Infrastructure for the data age."
  services={services}
  whyChooseUs={whyChooseUs}
  whyChooseTitle="Why Choose Aexaware for Big Data"
  whyChooseDescription="Enterprise-grade big data engineering."
  techStack={techStack}
  faqs={faqs}
/>
