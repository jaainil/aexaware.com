---
import ServicePageLayout from "@/layouts/ServicePageLayout.astro";
import { Brain, Network, Eye, Cpu, Layers, Sparkles } from "lucide-astro";

const services = [
  {
    id: "01",
    icon: Brain,
    title: "Neural Network Design",
    desc: "Custom neural architectures for your specific problems. From CNNs to Transformers, we design networks that perform.",
    gradient: "from-primary/20 to-info/20",
    iconColor: "text-primary",
  },
  {
    id: "02",
    icon: Network,
    title: "Deep Learning Models",
    desc: "State-of-the-art models for image, text, and audio processing. Classification, generation, and prediction at superhuman levels.",
    gradient: "from-success/20 to-success/20",
    iconColor: "text-success",
  },
  {
    id: "03",
    icon: Eye,
    title: "Computer Vision",
    desc: "Advanced vision systems for object detection, facial recognition, scene understanding, and visual inspection.",
    gradient: "from-warning/20 to-warning/20",
    iconColor: "text-warning",
  },
  {
    id: "04",
    icon: Layers,
    title: "NLP & Text AI",
    desc: "Deep learning for text classification, sentiment analysis, language translation, and text generation.",
    gradient: "from-primary/20 to-primary/20",
    iconColor: "text-primary",
  },
  {
    id: "05",
    icon: Cpu,
    title: "Speech Recognition",
    desc: "Voice-to-text systems, speaker identification, and audio classification using deep learning.",
    gradient: "from-destructive/20 to-destructive/20",
    iconColor: "text-destructive",
  },
  {
    id: "06",
    icon: Sparkles,
    title: "Reinforcement Learning",
    desc: "AI that learns through interaction. Robotics control, game AI, and autonomous decision systems.",
    gradient: "from-info/20 to-info/20",
    iconColor: "text-info",
  },
];

const whyChooseUs = [
  {
    title: "Expert Team",
    desc: "PhD-level deep learning engineers with research and production experience.",
  },
  {
    title: "Research-Backed",
    desc: "Latest architectures and techniques from top AI research.",
  },
  {
    title: "GPU Optimization",
    desc: "Optimized models for fast inference on edge devices and cloud.",
  },
  {
    title: "Transfer Learning",
    desc: "Leverage pre-trained models to reduce development time and cost.",
  },
  {
    title: "End-to-End",
    desc: "From data collection to deployment and monitoring.",
  },
  {
    title: "Scalable Solutions",
    desc: "Models that grow with your business needs.",
  },
];

const techStack = [
  "Python",
  "TensorFlow",
  "PyTorch",
  "Keras",
  "OpenCV",
  " Hugging Face",
  "NVIDIA CUDA",
  "AWS SageMaker",
  "Google Cloud AI",
];

const faqs = [
  {
    question: "When should I use deep learning vs. traditional ML?",
    answer: "Deep learning excels with complex patterns in unstructured data (images, text, audio) and large datasets. Traditional ML works better for structured data with smaller datasets where interpretability is important. We help you choose the right approach.",
  },
  {
    question: "How much data is needed for deep learning models?",
    answer: "It depends on complexity. Simple tasks may need thousands of samples, while complex tasks like image recognition need millions. We use transfer learning to reduce data requirements and can help implement data collection strategies.",
  },
  {
    question: "Can deep learning models run on edge devices?",
    answer: "Yes, we optimize models for edge deployment using techniques like quantization, pruning, and knowledge distillation. Our models can run efficiently on mobile devices, IoT hardware, and embedded systems.",
  },
  {
    question: "What industries benefit most from deep learning?",
    answer: "Healthcare (medical imaging), automotive (autonomous driving), finance (fraud detection), retail (computer vision), and manufacturing (quality inspection) see the highest benefits from deep learning solutions.",
  },
];
---

<ServicePageLayout
  title="Deep Learning Services"
  description="Advanced deep learning solutions for complex AI challenges. Neural networks, computer vision, NLP, and custom AI models."
  heroBadge="Deep Learning"
  heroTitle="Beyond"
  heroSubtitle="ML."
  heroDescription="Push the boundaries of AI with deep learning. From neural networks to computer vision, we build models that achieve superhuman performance."
  introTitle="The Power of Deep Learning"
  introText="Deep learning enables AI to achieve unprecedented accuracy on complex tasks. Whether you need image recognition that beats human performance, natural language understanding, or autonomous systems, deep learning provides the power you need. Our team combines cutting-edge research with practical engineering to deliver production-ready deep learning solutions."
  servicesTitle="Deep Learning Services"
  servicesDescription="Advanced AI for complex challenges."
  services={services}
  whyChooseUs={whyChooseUs}
  whyChooseTitle="Why Choose Aexaware for Deep Learning"
  whyChooseDescription="Research-grade deep learning with production-ready engineering."
  techStack={techStack}
  faqs={faqs}
/>
