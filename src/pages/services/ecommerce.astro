---
import ServicePageLayout from "@/layouts/ServicePageLayout.astro";
import {
  ShoppingCart,
  CreditCard,
  Package,
  TrendingUp,
  Globe,
  Smartphone,
} from "lucide-astro";

const services = [
  {
    id: "01",
    icon: ShoppingCart,
    title: "Custom E-commerce Development",
    desc: "Bespoke online stores built from the ground up. Unique designs, custom features, and seamless integrations tailored to your business.",
    gradient: "from-success/20 to-success/20",
    iconColor: "text-success",
  },
  {
    id: "02",
    icon: Globe,
    title: "Shopify & WooCommerce",
    desc: "Expert development on the world's leading e-commerce platforms. Custom themes, apps, and integrations that extend functionality.",
    gradient: "from-primary/20 to-primary/20",
    iconColor: "text-primary",
  },
  {
    id: "03",
    icon: CreditCard,
    title: "Payment Integration",
    desc: "Secure payment processing with Stripe, PayPal, Razorpay, and more. Multiple currencies, subscriptions, and flexible checkout experiences.",
    gradient: "from-primary/20 to-primary/20",
    iconColor: "text-primary",
  },
  {
    id: "04",
    icon: Package,
    title: "Inventory Management",
    desc: "Real-time inventory tracking, multi-warehouse support, and automated reordering. Keep stock optimized and customers happy.",
    gradient: "from-warning/20 to-warning/20",
    iconColor: "text-warning",
  },
  {
    id: "05",
    icon: TrendingUp,
    title: "Conversion Optimization",
    desc: "A/B testing, analytics, and UX improvements to increase sales. Turn more visitors into customers with data-driven optimizations.",
    gradient: "from-success/20 to-info/20",
    iconColor: "text-success",
  },
  {
    id: "06",
    icon: Smartphone,
    title: "Mobile Commerce",
    desc: "Mobile-first shopping experiences and native shopping apps. Reach customers wherever they are with seamless mobile purchasing.",
    gradient: "from-destructive/20 to-destructive/20",
    iconColor: "text-destructive",
  },
];

const whyChooseUs = [
  {
    title: "Conversion Focused",
    desc: "Every design decision is made to maximize sales and reduce cart abandonment.",
  },
  {
    title: "Scalable Architecture",
    desc: "Handle traffic spikes during sales events without breaking a sweat.",
  },
  {
    title: "Secure Transactions",
    desc: "PCI-compliant payment processing and robust security measures.",
  },
  {
    title: "SEO Optimized",
    desc: "Built for search engines to help customers find your products.",
  },
  {
    title: "Fast Performance",
    desc: "Speed matters for conversions. We optimize for sub-second load times.",
  },
  {
    title: "Ongoing Support",
    desc: "Continuous monitoring, updates, and improvements to keep your store thriving.",
  },
];

const techStack = [
  "Shopify",
  "WooCommerce",
  "Next.js",
  "Stripe",
  "PayPal",
  "Razorpay",
  "Medusa",
  "Tailwind CSS",
  "PostgreSQL",
];
---

<ServicePageLayout
  title="E-commerce Development"
  description="High-converting e-commerce solutions. Custom stores, Shopify, WooCommerce, payment integration, and inventory management."
  heroBadge="E-commerce"
  heroTitle="Sell More."
  heroSubtitle="Grow Faster."
  heroDescription="Secure online stores with payment integration, inventory management, and responsive design. We build e-commerce experiences that convert visitors into customers and customers into loyal advocates."
  introTitle="E-commerce That Converts"
  introText="In e-commerce, every detail matters. From page load speed to checkout flow, small improvements can mean thousands in additional revenue. We obsess over these details so you don't have to. Whether you're launching your first online store or scaling an established business, we provide the technical expertise and e-commerce strategy to help you succeed in a competitive digital marketplace."
  servicesTitle="E-commerce Services"
  servicesDescription="End-to-end e-commerce solutions from store development to optimization."
  services={services}
  whyChooseUs={whyChooseUs}
  whyChooseTitle="Why Choose Aexaware for E-commerce"
  whyChooseDescription="E-commerce expertise that drives revenue growth."
  techStack={techStack}
/>
