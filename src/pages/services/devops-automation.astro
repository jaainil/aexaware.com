---
import ServicePageLayout from "@/layouts/ServicePageLayout.astro";
import { Settings, Zap, RefreshCw, Shield, Clock, Layers } from "lucide-astro";

const services = [
  {
    id: "01",
    icon: Settings,
    title: "Infrastructure Automation",
    desc: "Automate infrastructure provisioning with Terraform and CloudFormation. Reproducible environments in minutes.",
    gradient: "from-primary/20 to-info/20",
    iconColor: "text-primary",
  },
  {
    id: "02",
    icon: RefreshCw,
    title: "CI/CD Pipelines",
    desc: "Automated build, test, and deployment pipelines. From code commit to production in minutes.",
    gradient: "from-success/20 to-success/20",
    iconColor: "text-success",
  },
  {
    id: "03",
    icon: Zap,
    title: "Configuration Management",
    desc: "Automate server configuration with Ansible, Chef, or Puppet. Consistent environments at scale.",
    gradient: "from-warning/20 to-warning/20",
    iconColor: "text-warning",
  },
  {
    id: "04",
    icon: Shield,
    title: "Security Automation",
    desc: "Automated security scanning, compliance checks, and vulnerability management.",
    gradient: "from-primary/20 to-primary/20",
    iconColor: "text-primary",
  },
  {
    id: "05",
    icon: Clock,
    title: "Release Automation",
    desc: "One-click deployments with rollback capabilities. Blue-green and canary deployments.",
    gradient: "from-destructive/20 to-destructive/20",
    iconColor: "text-destructive",
  },
  {
    id: "06",
    icon: Layers,
    title: "Container Orchestration",
    desc: "Kubernetes management and orchestration. Auto-scaling, service mesh, and observability.",
    gradient: "from-info/20 to-info/20",
    iconColor: "text-info",
  },
];

const whyChooseUs = [
  {
    title: "Faster Releases",
    desc: "Reduce deployment time from days to minutes.",
  },
  {
    title: "Fewer Errors",
    desc: "Automate away human error from repetitive tasks.",
  },
  {
    title: "Consistent Results",
    desc: "Same environment every time, everywhere.",
  },
  {
    title: "Cost Savings",
    desc: "Reduce operational costs by up to 40% with automation.",
  },
  {
    title: "Better Collaboration",
    desc: "Break down silos between development and operations.",
  },
  {
    title: "Scalable Processes",
    desc: "Processes that work for 1 app or 100.",
  },
];

const techStack = [
  "Terraform",
  "Ansible",
  "Jenkins",
  "GitHub Actions",
  "GitLab CI",
  "Kubernetes",
  "Docker",
  "AWS",
  "Azure",
];

const faqs = [
  {
    question: "What processes should we automate first?",
    answer: "We prioritize based on frequency and impact: infrastructure provisioning, build processes, testing, deployments, and monitoring. High-frequency tasks with manual effort are top candidates.",
  },
  {
    question: "How long does automation implementation take?",
    answer: "Basic automation takes 2-4 weeks, comprehensive frameworks take 2-4 months. We deliver incremental automation so you see benefits early.",
  },
  {
    question: "Can automation work with our existing tools?",
    answer: "Yes, we integrate with Jenkins, GitHub Actions, GitLab, Azure DevOps, and more. We work with your existing toolchain and add automation layers.",
  },
  {
    question: "How do you handle automation failures?",
    answer: "We implement proper error handling, rollback mechanisms, and alerting. Automated tests validate changes before production deployment.",
  },
];
---

<ServicePageLayout
  title="DevOps Automation Services"
  description="Automate your entire software delivery pipeline. Infrastructure as code, CI/CD, and configuration management."
  heroBadge="DevOps Automation"
  heroTitle="Automate"
  heroSubtitle="Everything."
  heroDescription="DevOps automation that eliminates manual work. From infrastructure to deployment, automate every step of your delivery pipeline."
  introTitle="Automation First"
  introText="Manual processes slow you down and introduce errors. Our DevOps automation services replace repetitive tasks with efficient, reliable automation. We build comprehensive automation frameworks that handle everything from infrastructure provisioning to deployment, monitoring, and scaling. Focus on building great software while automation takes care of the rest."
  servicesTitle="Automation Services"
  servicesDescription="Work smarter, not harder."
  services={services}
  whyChooseUs={whyChooseUs}
  whyChooseTitle="Why Choose Aexaware for DevOps Automation"
  whyChooseDescription="Enterprise-grade automation for modern teams."
  techStack={techStack}
  faqs={faqs}
/>
