---
import ServicePageLayout from "@/layouts/ServicePageLayout.astro";
import { Briefcase, TrendingUp, PieChart, BarChart, Target, Zap } from "lucide-astro";

const services = [
  {
    id: "01",
    icon: Briefcase,
    title: "Strategic Dashboards",
    desc: "Executive dashboards that provide at-a-glance insights for strategic decision-making. KPIs, metrics, and KPIs tracked in real-time.",
    gradient: "from-primary/20 to-info/20",
    iconColor: "text-primary",
  },
  {
    id: "02",
    icon: TrendingUp,
    title: "Performance Analytics",
    desc: "Track and analyze business performance across all departments. Identify trends and opportunities for improvement.",
    gradient: "from-success/20 to-success/20",
    iconColor: "text-success",
  },
  {
    id: "03",
    icon: PieChart,
    title: "Market Intelligence",
    desc: "Understand market trends, competitor analysis, and growth opportunities with data-driven insights.",
    gradient: "from-warning/20 to-warning/20",
    iconColor: "text-warning",
  },
  {
    id: "04",
    icon: BarChart,
    title: "Sales Analytics",
    desc: "Track sales performance, forecast revenue, and identify best-performing products and teams.",
    gradient: "from-primary/20 to-primary/20",
    iconColor: "text-primary",
  },
  {
    id: "05",
    icon: Target,
    title: "Customer Intelligence",
    desc: "360-degree customer view with segmentation, lifetime value, and churn analysis.",
    gradient: "from-destructive/20 to-destructive/20",
    iconColor: "text-destructive",
  },
  {
    id: "06",
    icon: Zap,
    title: "Real-Time Reporting",
    desc: "Live data updates and automated reports delivered to stakeholders on schedule.",
    gradient: "from-info/20 to-info/20",
    iconColor: "text-info",
  },
];

const whyChooseUs = [
  {
    title: "Self-Service BI",
    desc: "Empower teams to explore data without depending on IT or analysts.",
  },
  {
    title: "Any Data Source",
    desc: "Connect to databases, APIs, cloud services, and files seamlessly.",
  },
  {
    title: "Enterprise Security",
    desc: "Role-based access control and data encryption at rest and in transit.",
  },
  {
    title: "Scalable Platform",
    desc: "Handle growing data volumes without performance degradation.",
  },
  {
    title: "Mobile Access",
    desc: "Access dashboards and reports from any device, anywhere.",
  },
  {
    title: "Quick Implementation",
    desc: "Get up and running in weeks, not months.",
  },
];

const techStack = [
  "Tableau",
  "Power BI",
  "Looker",
  "Snowflake",
  "AWS QuickSight",
  "Python",
  "SQL",
  "Domo",
  "Metabase",
];

const faqs = [
  {
    question: "Which BI tool is right for our business?",
    answer: "The best tool depends on your needs: Tableau excels at visualization, Power BI offers excellent Microsoft integration, Looker is great for embedded analytics, and Metabase is ideal for self-service. We help you choose based on your requirements, budget, and existing tools.",
  },
  {
    question: "How long does BI implementation take?",
    answer: "Basic dashboards take 2-4 weeks, while enterprise implementations with multiple data sources take 2-4 months. We prioritize high-value dashboards so you can start benefiting quickly.",
  },
  {
    question: "Can you integrate BI with our existing systems?",
    answer: "Yes, we connect to databases, ERPs (SAP, Oracle), CRMs (Salesforce), marketing platforms, and custom APIs. We build a unified data layer for comprehensive analytics.",
  },
  {
    question: "Do you provide BI training?",
    answer: "Yes, we offer training for administrators, developers, and end users. We also create documentation and self-service guides to help your team use BI effectively.",
  },
];
---

<ServicePageLayout
  title="Business Intelligence Services"
  description="Enterprise business intelligence solutions. Dashboards, reporting, and analytics that drive informed decision-making."
  heroBadge="BI Solutions"
  heroTitle="Intelligence"
  heroSubtitle="Business."
  heroDescription="Transform raw data into actionable business intelligence. Interactive dashboards and reports that give leaders the insights they need."
  introTitle="Data-Driven Decisions"
  introText="Business intelligence transforms how organizations make decisions. Our BI solutions provide real-time insights into every aspect of your business - from sales and marketing to operations and finance. We build intuitive dashboards and reports that empower everyone from executives to analysts to make data-driven decisions with confidence."
  servicesTitle="BI Services"
  servicesDescription="Insights that power growth."
  services={services}
  whyChooseUs={whyChooseUs}
  whyChooseTitle="Why Choose Aexaware for BI"
  whyChooseDescription="Enterprise BI solutions tailored to your business."
  techStack={techStack}
  faqs={faqs}
/>
