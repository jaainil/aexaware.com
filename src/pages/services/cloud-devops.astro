---
import ServicePageLayout from "@/layouts/ServicePageLayout.astro";
import {
  Cloud,
  Container,
  GitBranch,
  Shield,
  Gauge,
  Server,
  Compass,
  Zap,
  Globe,
} from "lucide-astro";

const services = [
  {
    id: "01",
    icon: Cloud,
    title: "Cloud Architecture & Migration",
    desc: "Design and implement cloud infrastructure on AWS, Azure, or GCP. Scalable, secure, cost-optimized architectures with phased migration strategies.",
    gradient: "from-primary/20 to-info/20",
    iconColor: "text-primary",
  },
  {
    id: "02",
    icon: Container,
    title: "Containerization & Orchestration",
    desc: "Docker and Kubernetes expertise for microservices architecture. Auto-scaling, service mesh, high availability, and container orchestration.",
    gradient: "from-primary/20 to-primary/20",
    iconColor: "text-primary",
  },
  {
    id: "03",
    icon: GitBranch,
    title: "CI/CD Pipelines",
    desc: "Automated build, test, and deployment pipelines with GitHub Actions, Jenkins, or GitLab CI. Blue-green and canary deployments with rollback.",
    gradient: "from-success/20 to-success/20",
    iconColor: "text-success",
  },
  {
    id: "04",
    icon: Server,
    title: "Infrastructure as Code",
    desc: "Terraform, Ansible, and CloudFormation for reproducible, version-controlled infrastructure. Configuration management at scale.",
    gradient: "from-secondary/20 to-muted/20",
    iconColor: "text-muted-foreground",
  },
  {
    id: "05",
    icon: Shield,
    title: "Security & Compliance",
    desc: "DevSecOps best practices — automated security scanning, vulnerability management, secrets management, and compliance automation for regulated industries.",
    gradient: "from-destructive/20 to-warning/20",
    iconColor: "text-destructive",
  },
  {
    id: "06",
    icon: Gauge,
    title: "Monitoring & Observability",
    desc: "Real-time monitoring, logging, and alerting with Datadog, Prometheus, and Grafana. Incident response and performance optimization.",
    gradient: "from-warning/20 to-warning/20",
    iconColor: "text-warning",
  },
  {
    id: "07",
    icon: Compass,
    title: "DevOps Strategy & Assessment",
    desc: "Evaluate your DevOps maturity, develop transformation roadmaps, and select the right tools. DORA metrics tracking and measurable KPIs.",
    gradient: "from-info/20 to-info/20",
    iconColor: "text-info",
  },
  {
    id: "08",
    icon: Globe,
    title: "Multi-Region & Hybrid Cloud",
    desc: "Deploy across multiple regions for high availability worldwide. Connect on-premises infrastructure with cloud for hybrid architectures.",
    gradient: "from-primary/20 to-primary/20",
    iconColor: "text-primary",
  },
  {
    id: "09",
    icon: Zap,
    title: "Release & Deployment Automation",
    desc: "One-click deployments, automated rollbacks, and progressive delivery. Reduce deployment time from days to minutes with zero-downtime releases.",
    gradient: "from-success/20 to-success/20",
    iconColor: "text-success",
  },
];

const whyChooseUs = [
  {
    title: "Cloud-Native Expertise",
    desc: "AWS, Azure, and GCP certified professionals with deep experience in modern DevOps practices.",
  },
  {
    title: "Cost Optimization",
    desc: "We design for efficiency — right-size resources and leverage savings plans to minimize cloud spend.",
  },
  {
    title: "Security First",
    desc: "Infrastructure security is never an afterthought. DevSecOps embedded into every pipeline stage.",
  },
  {
    title: "Measurable Results",
    desc: "Track DORA metrics: deployment frequency, lead time, MTTR, and change failure rate.",
  },
  {
    title: "24/7 Reliability",
    desc: "High availability, disaster recovery, and automated failover for business-critical applications.",
  },
  {
    title: "Knowledge Transfer",
    desc: "We document everything and train your team to manage infrastructure independently.",
  },
];

const techStack = [
  "AWS",
  "Azure",
  "GCP",
  "Docker",
  "Kubernetes",
  "Terraform",
  "Ansible",
  "GitHub Actions",
  "Jenkins",
  "GitLab CI",
  "Prometheus",
  "Grafana",
  "Vault",
  "ArgoCD",
];

const faqs = [
  {
    question: "Which cloud provider should we choose?",
    answer: "We help you select based on your requirements: AWS has the largest services ecosystem, Azure integrates best with Microsoft tools, and GCP excels in data/AI. We can also implement multi-cloud and hybrid strategies.",
  },
  {
    question: "How long does cloud migration take?",
    answer: "Lift-and-shift takes 2-4 months, re-platforming 4-6 months, and re-architecting 6-12 months. We use phased approaches with blue-green deployments and database replication to minimize downtime.",
  },
  {
    question: "What does a DevOps assessment cover?",
    answer: "Our assessment covers CI/CD pipelines, deployment frequency, lead time, MTTR, change failure rate, automation levels, team structure, tooling, and culture. We deliver a maturity model with a prioritized improvement roadmap.",
  },
  {
    question: "What processes should we automate first?",
    answer: "We prioritize based on frequency and impact: infrastructure provisioning, build processes, testing, deployments, and monitoring. High-frequency manual tasks deliver the biggest automation ROI.",
  },
  {
    question: "How do you ensure cloud security?",
    answer: "We implement defense-in-depth with IAM, network security, encryption, vulnerability scanning, secrets management, and compliance automation. We follow Well-Architected Framework best practices.",
  },
  {
    question: "Do you provide ongoing DevOps support?",
    answer: "Yes, we offer 24/7 support packages including monitoring, incident response, optimization, and continuous improvement. We can also upskill your team with hands-on workshops.",
  },
];
---

<ServicePageLayout
  title="Cloud & DevOps"
  description="End-to-end cloud infrastructure and DevOps services: AWS, Azure, GCP, Kubernetes, CI/CD pipelines, infrastructure as code, DevOps strategy, security automation, and 24/7 monitoring."
  heroBadge="Cloud & DevOps"
  heroTitle="Scale With"
  heroSubtitle="Confidence."
  heroDescription="From cloud architecture and migration to CI/CD automation, security, and monitoring — we build and operate the infrastructure that powers your applications. Modern DevOps practices that accelerate delivery and improve reliability."
  introTitle="Modern Infrastructure for Modern Teams"
  introText="The cloud has transformed how businesses build and deliver software. But without the right expertise, you can end up with sprawling infrastructure, security vulnerabilities, and runaway costs. We bring order to cloud chaos. Whether you're starting your DevOps journey or optimizing a mature practice, our engineers design infrastructure that's secure, scalable, and cost-effective. We implement automation from strategy through implementation, replacing manual processes with reliable pipelines so your team can focus on building features instead of fighting fires."
  servicesTitle="Cloud & DevOps Services"
  servicesDescription="End-to-end cloud solutions — from architecture design and DevOps strategy to automation and ongoing operations."
  services={services}
  whyChooseUs={whyChooseUs}
  whyChooseTitle="Why Choose Aexaware for Cloud & DevOps"
  whyChooseDescription="Infrastructure expertise that keeps your applications running smoothly."
  techStack={techStack}
  faqs={faqs}
/>
