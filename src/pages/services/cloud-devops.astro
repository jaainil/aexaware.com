---
import ServicePageLayout from "@/layouts/ServicePageLayout.astro";
import {
  Cloud,
  Container,
  GitBranch,
  Shield,
  Gauge,
  Server,
} from "lucide-astro";

const services = [
  {
    id: "01",
    icon: Cloud,
    title: "Cloud Architecture",
    desc: "Design and implement cloud infrastructure on AWS, Azure, or GCP. Scalable, secure, and cost-optimized architectures for any workload.",
    gradient: "from-primary/20 to-info/20",
    iconColor: "text-primary",
  },
  {
    id: "02",
    icon: Container,
    title: "Containerization",
    desc: "Docker and Kubernetes expertise for container orchestration. Microservices architecture, auto-scaling, and high availability.",
    gradient: "from-primary/20 to-primary/20",
    iconColor: "text-primary",
  },
  {
    id: "03",
    icon: GitBranch,
    title: "CI/CD Pipelines",
    desc: "Automated build, test, and deployment pipelines with GitHub Actions, Jenkins, or GitLab CI. Ship faster with confidence.",
    gradient: "from-success/20 to-success/20",
    iconColor: "text-success",
  },
  {
    id: "04",
    icon: Shield,
    title: "Security & Compliance",
    desc: "Infrastructure security, vulnerability scanning, secrets management, and compliance automation for regulated industries.",
    gradient: "from-destructive/20 to-warning/20",
    iconColor: "text-destructive",
  },
  {
    id: "05",
    icon: Gauge,
    title: "Monitoring & Observability",
    desc: "Real-time monitoring, logging, and alerting with tools like Datadog, Prometheus, and Grafana. Know before your users do.",
    gradient: "from-warning/20 to-warning/20",
    iconColor: "text-warning",
  },
  {
    id: "06",
    icon: Server,
    title: "Infrastructure as Code",
    desc: "Terraform, Ansible, and CloudFormation for reproducible, version-controlled infrastructure. Eliminate configuration drift.",
    gradient: "from-secondary/20 to-muted/20",
    iconColor: "text-muted-foreground",
  },
];

const whyChooseUs = [
  {
    title: "Cloud-Native Expertise",
    desc: "Deep experience with all major cloud providers and modern DevOps practices.",
  },
  {
    title: "Cost Optimization",
    desc: "We design for efficiency, helping you minimize cloud spend without sacrificing performance.",
  },
  {
    title: "Scalability Built-In",
    desc: "Architectures designed to handle growth from day one—auto-scaling, load balancing, and more.",
  },
  {
    title: "Security First",
    desc: "Infrastructure security is never an afterthought. We implement best practices from the start.",
  },
  {
    title: "24/7 Reliability",
    desc: "High availability, disaster recovery, and automated failover for business-critical applications.",
  },
  {
    title: "Knowledge Transfer",
    desc: "We document everything and train your team to manage infrastructure independently.",
  },
];

const techStack = [
  "AWS",
  "Azure",
  "GCP",
  "Docker",
  "Kubernetes",
  "Terraform",
  "GitHub Actions",
  "Jenkins",
  "Prometheus",
  "Grafana",
];

const faqs = [
  {
    question: "Which cloud provider should we choose?",
    answer: "We help you select based on your requirements: AWS has the largest services ecosystem, Azure integrates best with Microsoft tools, and GCP excels in data/AI. We can also implement multi-cloud strategies.",
  },
  {
    question: "How long does cloud migration take?",
    answer: "Migration timelines vary: lift-and-shift takes 2-4 months, re-architecture takes 4-8 months, and modernization takes 6-12 months. We provide detailed roadmaps with phased approaches.",
  },
  {
    question: "How do you ensure cloud security?",
    answer: "We implement defense-in-depth with IAM, network security, encryption, vulnerability scanning, and compliance automation. We follow Well-Architected Framework best practices.",
  },
  {
    question: "Do you provide ongoing DevOps support?",
    answer: "Yes, we offer 24/7 support packages including monitoring, incident response, optimization, and continuous improvement. We can also train your team to manage infrastructure.",
  },
];
---

<ServicePageLayout
  title="Cloud & DevOps"
  description="Secure, scalable cloud infrastructure and DevOps solutions. AWS, Azure, GCP, Kubernetes, CI/CD pipelines, and infrastructure automation."
  heroBadge="Cloud & DevOps"
  heroTitle="Scale With"
  heroSubtitle="Confidence."
  heroDescription="Secure and scalable cloud infrastructure setup, migration, and management services. We help you build, deploy, and operate applications with modern DevOps practices that accelerate delivery and improve reliability."
  introTitle="Modern Infrastructure for Modern Teams"
  introText="The cloud has transformed how businesses build and deliver software. But without the right expertise, you can end up with sprawling infrastructure, security vulnerabilities, and runaway costs. We bring order to cloud chaos. Our DevOps engineers design infrastructure that's secure, scalable, and cost-effective. We implement automation that lets your team focus on building features instead of fighting fires."
  servicesTitle="Cloud & DevOps Services"
  servicesDescription="End-to-end cloud solutions from architecture design to ongoing operations."
  services={services}
  whyChooseUs={whyChooseUs}
  whyChooseTitle="Why Choose Aexaware for Cloud & DevOps"
  whyChooseDescription="Infrastructure expertise that keeps your applications running smoothly."
  techStack={techStack}
  faqs={faqs}
/>
