---
import ServicePageLayout from "@/layouts/ServicePageLayout.astro";
import {
  Cloud,
  Container,
  GitBranch,
  FileCode,
  ShieldCheck,
  Wifi,
} from "lucide-astro";

const services = [
  {
    id: "01",
    icon: Cloud,
    title: "Cloud Architecture & Migration",
    desc: "Design and implement cloud infrastructure on AWS, Azure, or GCP. Scalable, secure, cost-optimized architectures with phased migration strategies.",
    gradient: "from-primary/20 to-info/20",
    iconColor: "text-primary",
  },
  {
    id: "02",
    icon: Container,
    title: "Containerization & Orchestration",
    desc: "Docker and Kubernetes expertise for microservices architecture. Auto-scaling, service mesh, high availability, and container orchestration.",
    gradient: "from-primary/20 to-primary/20",
    iconColor: "text-primary",
  },
  {
    id: "03",
    icon: GitBranch,
    title: "CI/CD Pipelines",
    desc: "Automated build, test, and deployment pipelines with GitHub Actions, Jenkins, or GitLab CI. Blue-green and canary deployments with rollback.",
    gradient: "from-success/20 to-success/20",
    iconColor: "text-success",
  },
  {
    id: "04",
    icon: FileCode,
    title: "Infrastructure as Code",
    desc: "Terraform, Ansible, and CloudFormation for reproducible, version-controlled infrastructure. Configuration management at scale.",
    gradient: "from-warning/20 to-warning/20",
    iconColor: "text-warning",
  },
  {
    id: "05",
    icon: ShieldCheck,
    title: "Security & Compliance",
    desc: "DevSecOps practices: automated security scanning, vulnerability management, secrets management, and compliance automation for regulated industries.",
    gradient: "from-destructive/20 to-destructive/20",
    iconColor: "text-destructive",
  },
  {
    id: "06",
    icon: Wifi,
    title: "IoT & Edge Computing",
    desc: "Connected devices from firmware to cloud: embedded development in C/C++/Rust, device management with AWS IoT and Azure IoT, plus edge deployment for low-latency processing.",
    gradient: "from-primary/20 to-success/20",
    iconColor: "text-primary",
  },
];

const whyChooseUs = [
  {
    title: "Uptime Matters",
    desc: "Monitoring, alerting, and incident runbooks ship with every deployment. You know about problems before your customers do.",
  },
  {
    title: "Cost Awareness",
    desc: "Cloud bills grow quietly. We right-size resources, set budgets and alerts, and review spend as part of the work.",
  },
  {
    title: "Security Built In",
    desc: "Scanning, secrets management, and least-privilege access from day one, not bolted on before an audit.",
  },
  {
    title: "Documented Handover",
    desc: "Every pipeline, cluster, and runbook is documented. Your team can operate without us on the call.",
  },
  {
    title: "Automation First",
    desc: "If a human does it twice, it becomes a script. Manual deploys and snowflake servers don't survive an engagement with us.",
  },
  {
    title: "Hands-On Firmware to Cloud",
    desc: "IoT work spans embedded code and cloud backends. One team owns both ends of the wire.",
  },
];

const techStack = [
  "AWS",
  "GCP",
  "Azure",
  "Docker",
  "Kubernetes",
  "Terraform",
  "GitHub Actions",
  "Prometheus",
  "Grafana",
  "AWS IoT",
  "MQTT",
  "C/C++",
];

const faqs = [
  {
    question: "Can you migrate us to the cloud without downtime?",
    answer: "In most cases, yes: phased migrations with parallel running, data replication, and DNS cutover keep the old system serving until the new one proves itself. Truly zero-downtime depends on your legacy constraints, and we'll tell you honestly what's possible.",
  },
  {
    question: "We already have DevOps engineers. How do you fit in?",
    answer: "Two common modes: a focused project (migration, pipeline overhaul, security hardening) delivered alongside your team, or specialized coverage (IoT, Kubernetes, compliance) for skills you don't need full-time.",
  },
  {
    question: "How do you handle cloud costs?",
    answer: "Right-sizing from the start, budgets and alerts per project, autoscaling where it pays, and a monthly spend review. Most migrations we take over were paying for idle resources nobody owned.",
  },
  {
    question: "Do you work with regulated industries?",
    answer: "Yes. We implement compliance automation for SOC 2 and HIPAA-style requirements: audit logging, access controls, encryption, and the evidence collection auditors ask for.",
  },
  {
    question: "Can you build both our devices and the cloud backend?",
    answer: "Yes. Firmware, connectivity, device management, and the cloud pipeline for device data are one engagement, so protocol decisions and backend schema are designed together.",
  },
];
---

<ServicePageLayout
  title="Cloud, DevOps & IoT"
  description="Cloud architecture, Kubernetes, CI/CD, infrastructure as code, DevSecOps, and IoT device-to-cloud development on AWS, GCP, and Azure."
  heroBadge="Cloud & DevOps"
  heroTitle="Infrastructure That"
  heroSubtitle="Runs Itself."
  heroDescription="Cloud architecture, pipelines, and connected devices built to be boring: automated, monitored, documented, and cheap to operate. You ship features; the platform takes care of itself."
  introTitle="Operations without the 3am surprises"
  introText="Good infrastructure is invisible until it fails, so we build for the failure: automated deploys with rollback, monitoring that pages a human before customers notice, and runbooks that don't require tribal knowledge. From a single staging server to multi-cloud Kubernetes to fleets of connected devices, the setup is documented enough for your team to own."
  servicesTitle="Cloud & DevOps Services"
  servicesDescription="From your first pipeline to device fleets at the edge."
  services={services}
  whyChooseUs={whyChooseUs}
  whyChooseTitle="Why Choose Aexaware for Cloud & DevOps"
  whyChooseDescription="Infrastructure engineered for uptime, cost, and handover."
  techStack={techStack}
  faqs={faqs}
/>
