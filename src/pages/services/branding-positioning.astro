---
import ServicePageLayout from "@/layouts/ServicePageLayout.astro";
import { Palette, Target, Zap, Globe, Star, Megaphone } from "lucide-astro";

const services = [
  {
    id: "01",
    icon: Palette,
    title: "Brand Identity",
    desc: "Create a distinctive brand that stands out. Logo, colors, typography, and brand guidelines.",
    gradient: "from-primary/20 to-info/20",
    iconColor: "text-primary",
  },
  {
    id: "02",
    icon: Target,
    title: "Brand Positioning",
    desc: "Define your unique market position. Differentiate from competitors and own your space.",
    gradient: "from-success/20 to-success/20",
    iconColor: "text-success",
  },
  {
    id: "03",
    icon: Zap,
    title: "Brand Strategy",
    desc: "Strategic direction for your brand. Values, personality, and messaging that resonates.",
    gradient: "from-warning/20 to-warning/20",
    iconColor: "text-warning",
  },
  {
    id: "04",
    icon: Globe,
    title: "Digital Branding",
    desc: "Consistent brand presence across all digital touchpoints. Websites, social media, and ads.",
    gradient: "from-primary/20 to-primary/20",
    iconColor: "text-primary",
  },
  {
    id: "05",
    icon: Star,
    title: "Brand Messaging",
    desc: "Compelling copy that communicates your value. Taglines, elevator pitches, and content.",
    gradient: "from-destructive/20 to-destructive/20",
    iconColor: "text-destructive",
  },
  {
    id: "06",
    icon: Megaphone,
    title: "Brand Launch",
    desc: "Launch your brand with impact. Go-to-market strategies and campaigns that create buzz.",
    gradient: "from-info/20 to-info/20",
    iconColor: "text-info",
  },
];

const whyChooseUs = [
  {
    title: "Strategic Thinking",
    desc: "Branding based on business strategy, not just design.",
  },
  {
    title: "Unique Identity",
    desc: "Distinctive designs that set you apart.",
  },
  {
    title: "Consistency",
    desc: "Brand guidelines that ensure consistency everywhere.",
  },
  {
    title: "Market Research",
    desc: "Deep understanding of your audience and competition.",
  },
  {
    title: "Measurable Impact",
    desc: "Brand equity improvements you can track.",
  },
  {
    title: "Long-Term Partnership",
    desc: "Ongoing support to evolve and grow your brand.",
  },
];

const techStack = [
  "Figma",
  "Adobe Creative Cloud",
  "Canva",
  "Sketch",
  "Illustrator",
  "Photoshop",
  "InVision",
  "Miro",
  "Brandboard",
];

const faqs = [
  {
    question: "What makes branding different from just logo design?",
    answer: "A logo is just one element. True branding encompasses your visual identity, brand voice, positioning, values, and the emotional connection you create with customers. It's the complete personality of your business that shapes how people perceive and relate to you.",
  },
  {
    question: "How long does a branding project take?",
    answer: "Typical branding projects run 4-8 weeks. Brand strategy and discovery take 2-3 weeks, visual identity development another 2-3 weeks, and guidelines documentation takes 1-2 weeks. We can accelerate timelines for urgent launches.",
  },
  {
    question: "Can you rebrand an existing company?",
    answer: "Yes, we specialize in brand refreshes and complete rebrands. We conduct competitive analysis, stakeholder interviews, and market research to develop a positioning that better reflects your current goals and market opportunities.",
  },
  {
    question: "What's included in brand guidelines?",
    answer: "Comprehensive guidelines cover logo usage, color palette with exact codes, typography specifications, imagery style, voice and tone, social media guidelines, and application examples. These ensure consistent brand expression across all touchpoints.",
  },
];
---

<ServicePageLayout
  title="Branding & Positioning Services"
  description="Strategic branding and brand positioning services. Create a powerful brand identity that differentiates you in the market."
  heroBadge="Branding"
  heroTitle="Own Your"
  heroSubtitle="Brand."
  heroDescription="Build a brand that stands out. Strategic branding and positioning that creates lasting impressions and customer loyalty."
  introTitle="Brand Power"
  introText="Your brand is more than a logo - it's what customers think and feel about your business. Our branding services help you define who you are, why you matter, and how to communicate that effectively. From brand strategy to visual identity, we create brands that connect with audiences and drive business growth."
  servicesTitle="Branding Services"
  servicesDescription="Build a powerful brand."
  services={services}
  whyChooseUs={whyChooseUs}
  whyChooseTitle="Why Choose Aexaware for Branding"
  whyChooseDescription="Strategic branding that makes an impact."
  techStack={techStack}
  faqs={faqs}
/>
