---
import ServicePageLayout from "@/layouts/ServicePageLayout.astro";
import {
  Fingerprint,
  MessageSquareText,
  Search,
  MousePointerClick,
  Users,
  Gauge,
} from "lucide-astro";

const services = [
  {
    id: "01",
    icon: Fingerprint,
    title: "Brand Identity & Strategy",
    desc: "Logo, colors, typography, and guidelines, plus the positioning work underneath: who you're for, what you say, and why anyone should care.",
    gradient: "from-primary/20 to-info/20",
    iconColor: "text-primary",
  },
  {
    id: "02",
    icon: MessageSquareText,
    title: "Messaging & Content",
    desc: "Taglines, website copy, and a content engine: blog posts, video, and thought leadership that attract the customers you actually want.",
    gradient: "from-primary/20 to-primary/20",
    iconColor: "text-primary",
  },
  {
    id: "03",
    icon: Search,
    title: "SEO",
    desc: "Technical SEO, content optimization, and link building driven by data. We also fix site speed, since fast pages rank and convert better.",
    gradient: "from-success/20 to-success/20",
    iconColor: "text-success",
  },
  {
    id: "04",
    icon: MousePointerClick,
    title: "Paid Advertising",
    desc: "Google Ads, Meta, and LinkedIn campaigns managed against ROI, not impressions. Landing pages and funnels built to match every campaign.",
    gradient: "from-warning/20 to-warning/20",
    iconColor: "text-warning",
  },
  {
    id: "05",
    icon: Users,
    title: "Social & Email",
    desc: "Organic social that builds an audience, plus automated email flows that nurture leads and win back customers. Segmented and A/B tested.",
    gradient: "from-primary/20 to-primary/20",
    iconColor: "text-primary",
  },
  {
    id: "06",
    icon: Gauge,
    title: "Conversion Rate Optimization",
    desc: "A/B testing, funnel analysis, and UX fixes that turn more of the traffic you already have into customers.",
    gradient: "from-success/20 to-info/20",
    iconColor: "text-success",
  },
];

const whyChooseUs = [
  {
    title: "Brand Meets Engineering",
    desc: "Most agencies stop at the mockup. We design the brand and build the site, so nothing gets lost in translation.",
  },
  {
    title: "Numbers Over Vibes",
    desc: "Every campaign reports against traffic, conversion, and cost per acquisition. If a channel isn't working, we say so and move the budget.",
  },
  {
    title: "Full-Funnel Thinking",
    desc: "Identity, site, content, ads, and email work as one system instead of five vendors pointing at each other.",
  },
  {
    title: "Content That Compounds",
    desc: "We write for search intent and real readers, so content keeps earning traffic months after publication.",
  },
  {
    title: "Fast Iteration",
    desc: "Monthly experiment cycles: hypothesis, launch, measure, keep or kill. Small bets, quick learnings.",
  },
  {
    title: "You Own Everything",
    desc: "Accounts, data, creative files, and code are yours from day one. No hostage situations.",
  },
];

const techStack = [
  "Figma",
  "Adobe Illustrator",
  "Google Ads",
  "GA4",
  "Semrush",
  "Ahrefs",
  "Meta Ads",
  "Hotjar",
  "Search Console",
];

const faqs = [
  {
    question: "We only need one of these. Can we start small?",
    answer: "Yes. Common entry points are an SEO audit, a brand refresh, or a single paid channel. We'd rather prove value on one project than sell you a retainer you're not sure about.",
  },
  {
    question: "How long before we see results?",
    answer: "Paid ads can produce qualified traffic within weeks. SEO and content compound over 3-6 months. Brand work pays off gradually across every touchpoint. We set expectations per channel up front, in writing.",
  },
  {
    question: "Do you work with our in-house marketing team?",
    answer: "Often. We can own specific channels (say, technical SEO or paid), handle execution while your team keeps strategy, or train your team on what we set up.",
  },
  {
    question: "Can you redesign our website as part of this?",
    answer: "Yes, and it's usually the right move when brand and marketing change together. Design, build, and migration are handled by the same team that runs this site.",
  },
];
---

<ServicePageLayout
  title="Branding & Marketing"
  description="Brand identity and positioning, SEO, paid advertising, content, social, email, and conversion rate optimization — designed and measured as one system."
  heroBadge="Branding & Marketing"
  heroTitle="Brands Built"
  heroSubtitle="To Convert."
  heroDescription="Identity, website, content, and campaigns that work as one system — designed by the same team that builds the site, and measured on customers gained, not likes."
  introTitle="Marketing with receipts"
  introText="A brand is what people say about you when you're not in the room; marketing is getting them to say it to someone with a credit card. We handle both, report against traffic and conversion every month, and kill what isn't working. Because we also build the websites, nothing gets designed here and rebuilt there."
  servicesTitle="Branding & Marketing Services"
  servicesDescription="From first logo to a full acquisition funnel."
  services={services}
  whyChooseUs={whyChooseUs}
  whyChooseTitle="Why Choose Aexaware for Branding & Marketing"
  whyChooseDescription="Design and engineering under one roof, campaigns judged on revenue."
  techStack={techStack}
  faqs={faqs}
/>
