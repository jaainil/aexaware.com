    iconColor: "text-destructive",
  },
];

const whyChooseUs = [
  {
    title: "User-Centered Approach",
    desc: "Every design decision is based on user needs, behaviors, and feedback—not assumptions.",
  },
  {
    title: "Aesthetics + Function",
    desc: "We create designs that are both visually stunning and highly functional.",
  },
  {
    title: "Collaborative Process",
    desc: "Regular design reviews and feedback loops keep you involved throughout the creative process.",
  },
  {
    title: "Developer-Friendly",
    desc: "Our designs come with detailed specs, assets, and documentation for seamless handoff.",
  },
  {
    title: "Accessibility First",
    desc: "WCAG-compliant designs that ensure your product is usable by everyone.",
  },
  {
    title: "Rapid Iteration",
    desc: "Quick turnaround on revisions so you can move from concept to launch faster.",
  },
];

const techStack = [
  "Figma",
  "Adobe XD",
  "Sketch",
  "Framer",
  "InVision",
  "Principle",
  "Tailwind CSS",
  "Storybook",
];

const faqs = [
  {
    question: "What is the design process?",
    answer: "Our process: Discovery (research, goals), Strategy (user personas, journey maps), Design (wireframes, prototypes), Visual Design (UI, branding), and Delivery (assets, specifications). We iterate based on feedback at each stage.",
  },
  {
    question: "How long does a design project take?",
    answer: "Timeline varies: simple projects 2-4 weeks, comprehensive design 4-8 weeks, design systems 8-12 weeks. We provide detailed timelines based on your scope.",
  },
  {
    question: "Do you provide developer handoff?",
    answer: "Yes, we provide comprehensive handoff including Figma files, design specs, style guides, component documentation, and asset export. We ensure smooth translation to code.",
  },
  {
    question: "Can you work with our existing brand guidelines?",
    answer: "Absolutely. We can design within your existing brand framework or help evolve your brand identity. We ensure consistency while enhancing visual appeal.",
  },
