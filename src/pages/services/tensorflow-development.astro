---
import ServicePageLayout from "@/layouts/ServicePageLayout.astro";
import { Box, Brain, Cpu, Layers, Network, Zap } from "lucide-astro";

const services = [
  {
    id: "01",
    icon: Box,
    title: "Custom TensorFlow Models",
    desc: "Build bespoke machine learning models using TensorFlow for your unique business requirements.",
    gradient: "from-primary/20 to-info/20",
    iconColor: "text-primary",
  },
  {
    id: "02",
    icon: Brain,
    title: "Neural Network Architecture",
    desc: "Design and implement CNNs, RNNs, LSTMs, and Transformers optimized for your data and use case.",
    gradient: "from-success/20 to-success/20",
    iconColor: "text-success",
  },
  {
    id: "03",
    icon: Cpu,
    title: "Model Optimization",
    desc: "Quantization, pruning, and distillation for faster inference and lower resource consumption.",
    gradient: "from-warning/20 to-warning/20",
    iconColor: "text-warning",
  },
  {
    id: "04",
    icon: Layers,
    title: "Transfer Learning",
    desc: "Leverage pre-trained models and fine-tune for your specific domain. Faster development with better results.",
    gradient: "from-primary/20 to-primary/20",
    iconColor: "text-primary",
  },
  {
    id: "05",
    icon: Network,
    title: "Distributed Training",
    desc: "Scale your training across multiple GPUs and machines for large models and datasets.",
    gradient: "from-destructive/20 to-destructive/20",
    iconColor: "text-destructive",
  },
  {
    id: "06",
    icon: Zap,
    title: "MLOps & Deployment",
    desc: "Production-ready TensorFlow serving, model versioning, and continuous training pipelines.",
    gradient: "from-info/20 to-info/20",
    iconColor: "text-info",
  },
];

const whyChooseUs = [
  {
    title: "TensorFlow Expertise",
    desc: "Certified TensorFlow developers with years of production experience.",
  },
  {
    title: "Production-Ready",
    desc: "Models optimized for real-world deployment at scale.",
  },
  {
    title: "Full Lifecycle",
    desc: "From research and prototyping to production and monitoring.",
  },
  {
    title: "Performance Focus",
    desc: "Inference optimization for latency-sensitive applications.",
  },
  {
    title: "Edge Deployment",
    desc: "TensorFlow Lite for mobile and edge devices.",
  },
  {
    title: "Enterprise Support",
    desc: "Scalable solutions for large organizations.",
  },
];

const techStack = [
  "TensorFlow",
  "Keras",
  "Python",
  "TensorFlow Lite",
  "TensorFlow Serving",
  "TensorFlow Hub",
  "Docker",
  "Kubernetes",
  "AWS SageMaker",
];
---

<ServicePageLayout
  title="TensorFlow Development"
  description="Enterprise TensorFlow development services. Custom ML models, neural networks, and production-ready AI solutions."
  heroBadge="TensorFlow"
  heroTitle="Build with"
  heroSubtitle="TensorFlow."
  heroDescription="Custom machine learning solutions built on TensorFlow. From neural networks to production deployment, we deliver enterprise-grade AI."
  introTitle="TensorFlow Excellence"
  introText="TensorFlow is the backbone of modern machine learning. Whether you need computer vision, natural language processing, or custom ML models, our TensorFlow experts build solutions that scale. We combine deep framework knowledge with domain expertise to deliver models that perform in production."
  servicesTitle="TensorFlow Services"
  servicesDescription="Enterprise ML with TensorFlow."
  services={services}
  whyChooseUs={whyChooseUs}
  whyChooseTitle="Why Choose Aexaware for TensorFlow"
  whyChooseDescription="Certified TensorFlow experts for your AI projects."
  techStack={techStack}
/>
