---
import ServicePageLayout from "@/layouts/ServicePageLayout.astro";
import {
    TrendingUp,
    Search,
    MousePointer,
    Share2,
    Mail,
    BarChart,
} from "lucide-astro";

const services = [
    {
        id: "01",
        icon: Search,
        title: "SEO Optimization",
        desc: "Improve your search engine rankings with data-driven SEO strategies. Technical SEO, content optimization, and link building to drive organic traffic.",
        gradient: "from-green-500/20 to-emerald-500/20",
        iconColor: "text-green-600",
    },
    {
        id: "02",
        icon: MousePointer,
        title: "PPC Advertising",
        desc: "Maximize ROI with targeted Pay-Per-Click campaigns on Google Ads, Facebook, LinkedIn, and other platforms. Performance-focused campaign management.",
        gradient: "from-blue-500/20 to-cyan-500/20",
        iconColor: "text-blue-600",
    },
    {
        id: "03",
        icon: Share2,
        title: "Social Media Marketing",
        desc: "Build your brand, engage your audience, and drive conversions across all major social media channels with strategic content and community management.",
        gradient: "from-pink-500/20 to-rose-500/20",
        iconColor: "text-pink-600",
    },
    {
        id: "04",
        icon: Mail,
        title: "Email Marketing",
        desc: "Nurture leads and retain customers with personalized email campaigns. Automation, segmentation, and A/B testing to maximize engagement.",
        gradient: "from-purple-500/20 to-violet-500/20",
        iconColor: "text-purple-600",
    },
    {
        id: "05",
        icon: TrendingUp,
        title: "Content Marketing",
        desc: "Create valuable content that attracts and engages your target audience. Blog posts, videos, infographics, and thought leadership content.",
        gradient: "from-orange-500/20 to-amber-500/20",
        iconColor: "text-orange-600",
    },
    {
        id: "06",
        icon: BarChart,
        title: "Analytics & Reporting",
        desc: "Data-driven insights to optimize your marketing efforts. Custom dashboards, conversion tracking, and actionable recommendations.",
        gradient: "from-indigo-500/20 to-blue-500/20",
        iconColor: "text-indigo-600",
    },
];

const whyChooseUs = [
    {
        title: "Data-Driven Approach",
        desc: "Every strategy is backed by data and analytics. We measure, analyze, and optimize for continuous improvement.",
    },
    {
        title: "ROI Focused",
        desc: "We focus on marketing activities that deliver measurable returns on your investment.",
    },
    {
        title: "Full-Funnel Strategy",
        desc: "From awareness to conversion, we create integrated campaigns that guide customers through their journey.",
    },
    {
        title: "Transparent Reporting",
        desc: "Regular reports with clear metrics so you always know how your campaigns are performing.",
    },
    {
        title: "Industry Expertise",
        desc: "Experience across B2B, B2C, e-commerce, and SaaS industries with proven results.",
    },
    {
        title: "Agile Optimization",
        desc: "Continuous testing and optimization to improve performance over time.",
    },
];

const techStack = [
    "Google Analytics",
    "Google Search Console",
    "SEMrush",
    "Ahrefs",
    "Facebook Ads",
    "LinkedIn Ads",
    "HubSpot",
    "Mailchimp",
];
---

<ServicePageLayout
    title="Digital Marketing"
    description="Data-driven digital marketing services including SEO, PPC, social media marketing, email marketing, and content strategy to grow your online presence."
    heroBadge="Digital Growth"
    heroTitle="Drive Traffic."
    heroSubtitle="Boost Sales."
    heroDescription="We help you reach your target audience and convert them into loyal customers. Our digital marketing strategies are built on data, creativity, and a focus on ROI to deliver measurable growth for your business."
    introTitle="Strategic Marketing That Delivers"
    introText="In today's digital landscape, effective marketing requires more than just posting ads. It demands a strategic, data-driven approach that connects with your audience at every touchpoint. We combine creativity with analytics to create marketing campaigns that not only look great but deliver real business results. From increasing brand awareness to driving conversions, our team develops integrated strategies tailored to your unique goals and market."
    servicesTitle="Digital Marketing Services"
    servicesDescription="Comprehensive marketing solutions designed to elevate your brand and grow your business."
    services={services}
    whyChooseUs={whyChooseUs}
    whyChooseTitle="Why Choose Aexaware for Digital Marketing"
    whyChooseDescription="Strategic marketing expertise combined with deep technical knowledge for results that matter."
    techStack={techStack}
/>
