---
import ServicePageLayout from "@/layouts/ServicePageLayout.astro";
import {
    Globe,
    Palette,
    Plug,
    Database,
    ArrowLeftRight,
    Wrench,
} from "lucide-astro";

const services = [
    {
        id: "01",
        icon: Globe,
        title: "WordPress Development",
        desc: "Custom WordPress websites with sleek designs and responsive functionality. From blogs to enterprise sites, we deliver solutions that are easy to manage.",
        gradient: "from-blue-500/20 to-indigo-500/20",
        iconColor: "text-blue-600",
    },
    {
        id: "02",
        icon: Palette,
        title: "Theme Customization",
        desc: "Transform any theme to match your brand identity perfectly. We customize layouts, colors, typography, and functionality to create unique experiences.",
        gradient: "from-purple-500/20 to-pink-500/20",
        iconColor: "text-purple-600",
    },
    {
        id: "03",
        icon: Plug,
        title: "Plugin Development",
        desc: "Need specific functionality? We develop custom WordPress plugins that extend your site's capabilities while maintaining performance and security.",
        gradient: "from-green-500/20 to-emerald-500/20",
        iconColor: "text-green-600",
    },
    {
        id: "04",
        icon: Database,
        title: "Headless CMS Solutions",
        desc: "Modern, fast websites using Sanity, Strapi, or Contentful with React/Next.js frontends. Get the best of both worlds: easy content management and blazing performance.",
        gradient: "from-orange-500/20 to-amber-500/20",
        iconColor: "text-orange-600",
    },
    {
        id: "05",
        icon: ArrowLeftRight,
        title: "Shopify Development",
        desc: "Launch your e-commerce store with custom Shopify themes and integrations. We create shopping experiences that convert visitors into customers.",
        gradient: "from-teal-500/20 to-cyan-500/20",
        iconColor: "text-teal-600",
    },
    {
        id: "06",
        icon: Wrench,
        title: "CMS Migration",
        desc: "Seamlessly migrate your existing content to a new CMS platform. We handle data migration, URL redirects, and SEO preservation.",
        gradient: "from-gray-500/20 to-slate-500/20",
        iconColor: "text-gray-600",
    },
];

const whyChooseUs = [
    {
        title: "Simplicity",
        desc: "We build CMS solutions that are intuitive to use. Your team can manage content without needing technical expertise.",
    },
    {
        title: "Flexibility",
        desc: "From blogs to complex portals, our CMS implementations adapt to your unique business needs and content workflows.",
    },
    {
        title: "Publishing Tools",
        desc: "Create drafts, schedule publications, manage revisions, and control access—all from a user-friendly dashboard.",
    },
    {
        title: "User Management",
        desc: "Sophisticated role-based access control. Administrators, editors, authors, and contributors each get appropriate permissions.",
    },
    {
        title: "Media Management",
        desc: "Upload, organize, and edit media effortlessly. Drag-and-drop functionality with built-in image optimization.",
    },
    {
        title: "Standards Compliance",
        desc: "Full W3C compliance ensures your website works in today's browsers and maintains forward compatibility.",
    },
];

const techStack = [
    "WordPress",
    "Shopify",
    "Sanity",
    "Strapi",
    "PHP",
    "React",
    "Next.js",
    "Liquid",
    "MySQL",
    "GraphQL",
];
---

<ServicePageLayout
    title="CMS Development"
    description="Custom CMS development services including WordPress, Shopify, and Headless CMS solutions. Empower your team to manage content with ease."
    heroBadge="CMS Solutions"
    heroTitle="Content Managed."
    heroSubtitle="Simply."
    heroDescription="With custom CMS development, get easy page management and multisite functionality from a single UI. We help you develop mobile-ready sites that create the ultimate web experience and run your business globally."
    introTitle="What We Do"
    introText="At Aexaware, we're not just a CMS development company—we're your partners in bringing your online vision to life. Specializing in CMS web development, we offer solutions that go beyond the ordinary to build your online presence. Our focus on precision-driven CMS development ensures your website not only looks good but is also user-friendly, dynamic, and efficient. We analyze your business and client needs to recommend the best solution, understanding that no CMS is one-size-fits-all."
    servicesTitle="CMS Development Services"
    servicesDescription="We provide expert support, design, and development for the most popular content management systems."
    services={services}
    whyChooseUs={whyChooseUs}
    whyChooseTitle="Why WordPress & Modern CMS"
    whyChooseDescription="The right CMS transforms how your team creates and manages content."
    techStack={techStack}
/>
