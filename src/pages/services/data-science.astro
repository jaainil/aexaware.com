---
import ServicePageLayout from "@/layouts/ServicePageLayout.astro";
import { FlaskConical, Brain, Code2, Database, LineChart, Target, PieChart, Activity, Zap } from "lucide-astro";

const services = [
  {
    id: "01",
    icon: FlaskConical,
    title: "Predictive Modeling",
    desc: "Build ML models that forecast outcomes. Demand forecasting, risk prediction, churn analysis, and trend identification.",
    gradient: "from-primary/20 to-info/20",
    iconColor: "text-primary",
  },
  {
    id: "02",
    icon: Brain,
    title: "Machine Learning",
    desc: "Supervised and unsupervised learning for classification, regression, clustering, recommendation, and anomaly detection.",
    gradient: "from-success/20 to-success/20",
    iconColor: "text-success",
  },
  {
    id: "03",
    icon: Code2,
    title: "Statistical Analysis",
    desc: "Hypothesis testing, A/B analysis, and statistical modeling for data-driven decisions with full confidence intervals.",
    gradient: "from-warning/20 to-warning/20",
    iconColor: "text-warning",
  },
  {
    id: "04",
    icon: PieChart,
    title: "Customer & Marketing Analytics",
    desc: "Deep customer insights for segmentation, lifetime value, churn prediction, attribution modeling, and campaign ROI analysis.",
    gradient: "from-primary/20 to-primary/20",
    iconColor: "text-primary",
  },
  {
    id: "05",
    icon: Activity,
    title: "Operations & Real-Time Analytics",
    desc: "Optimize operations with data-driven insights. Process efficiency, resource planning, streaming data processing, and live dashboards.",
    gradient: "from-destructive/20 to-destructive/20",
    iconColor: "text-destructive",
  },
  {
    id: "06",
    icon: LineChart,
    title: "Time Series & Forecasting",
    desc: "Forecast trends over time with seasonality detection. Revenue projections, demand planning, and long-term predictions.",
    gradient: "from-info/20 to-info/20",
    iconColor: "text-info",
  },
  {
    id: "07",
    icon: Database,
    title: "Data Processing & Engineering",
    desc: "Clean, transform, and prepare data for analysis. Feature engineering, data preprocessing, and integration from any source.",
    gradient: "from-success/20 to-success/20",
    iconColor: "text-success",
  },
  {
    id: "08",
    icon: Target,
    title: "Custom Algorithms",
    desc: "Build bespoke algorithms tailored to your specific business problems and data. XGBoost, ensemble methods, and domain-specific models.",
    gradient: "from-warning/20 to-warning/20",
    iconColor: "text-warning",
  },
];

const whyChooseUs = [
  {
    title: "Domain Expertise",
    desc: "Data scientists with deep industry knowledge and business acumen.",
  },
  {
    title: "Full Lifecycle",
    desc: "From problem definition to model deployment, monitoring, and retraining.",
  },
  {
    title: "Any Data Source",
    desc: "Integrate data from databases, APIs, files, warehouses, and streaming sources.",
  },
  {
    title: "Interpretable Models",
    desc: "Models that are transparent and explainable to stakeholders.",
  },
  {
    title: "Scalable Processing",
    desc: "Handle datasets from GBs to PBs with production-ready infrastructure.",
  },
  {
    title: "Clear Reporting",
    desc: "Actionable reports and dashboards that every stakeholder understands.",
  },
];

const techStack = [
  "Python",
  "R",
  "TensorFlow",
  "PyTorch",
  "Scikit-learn",
  "XGBoost",
  "Pandas",
  "NumPy",
  "SQL",
  "AWS SageMaker",
  "Snowflake",
  "BigQuery",
];

const faqs = [
  {
    question: "What can data science do for my business?",
    answer: "Data science enables predictive maintenance, customer segmentation, demand forecasting, fraud detection, price optimization, marketing attribution, and personalization. It transforms historical data into future insights that drive revenue and reduce costs.",
  },
  {
    question: "What types of analytics do you offer?",
    answer: "We offer descriptive analytics (what happened), diagnostic analytics (why it happened), predictive analytics (what will happen), and prescriptive analytics (what to do about it). Our services cover customer, operations, marketing, and financial analysis.",
  },
  {
    question: "What data do I need for data science projects?",
    answer: "Required data depends on your goals. We work with historical data, transactional records, customer behavior data, sensor data, and can help establish data collection and consolidation from multiple sources for future projects.",
  },
  {
    question: "How long does a data science project take?",
    answer: "Exploratory analysis takes 2-4 weeks, predictive models take 1-3 months, and enterprise implementations take 3-6 months. We deliver incremental value through agile sprints.",
  },
  {
    question: "How do you measure data science ROI?",
    answer: "We define measurable KPIs upfront: revenue increase, cost reduction, customer retention, or efficiency gains. We track model performance and business impact throughout the project.",
  },
  {
    question: "Do you provide ongoing analytics support?",
    answer: "Yes, we offer retainer plans for continuous analytics, dashboard maintenance, recurring reporting, and model monitoring. We can also train your team to conduct analysis independently.",
  },
];
---

<ServicePageLayout
  title="Data Science & Analytics"
  description="Advanced data science and analytics services: predictive modeling, machine learning, customer analytics, time-series forecasting, statistical analysis, and real-time operations analytics."
  heroBadge="Data Science & Analytics"
  heroTitle="Science of"
  heroSubtitle="Data."
  heroDescription="Unlock the power of your data with advanced data science. From predictive modeling and customer analytics to real-time operations insights — we transform raw data into strategic assets that drive measurable business value."
  introTitle="Data-Driven Decisions"
  introText="Your data holds the answers to your biggest business questions. Data science combines statistics, machine learning, and domain expertise to extract insights that matter. Whether you need customer churn prediction, demand forecasting, operations optimization, or marketing attribution, our data science services uncover hidden patterns, predict future trends, and provide actionable insights that transform raw data into strategic advantage."
  servicesTitle="Data Science & Analytics Services"
  servicesDescription="From descriptive analytics to predictive models — insights that create real value."
  services={services}
  whyChooseUs={whyChooseUs}
  whyChooseTitle="Why Choose Aexaware for Data Science"
  whyChooseDescription="Expert data scientists for complex business challenges."
  techStack={techStack}
  faqs={faqs}
/>
