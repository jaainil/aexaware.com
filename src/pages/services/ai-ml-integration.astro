---
import ServicePageLayout from "@/layouts/ServicePageLayout.astro";
import {
  Bot,
  MessageSquare,
  ImagePlus,
  LineChart,
  ScanEye,
  Database,
} from "lucide-astro";

const services = [
  {
    id: "01",
    icon: MessageSquare,
    title: "LLM Integration & Chatbots",
    desc: "Customer support bots, document intelligence, and content generation built on GPT, Claude, and open models. Grounded in your data with RAG, priced with token budgets in mind.",
    gradient: "from-primary/20 to-info/20",
    iconColor: "text-primary",
  },
  {
    id: "02",
    icon: Bot,
    title: "AI Agent Development",
    desc: "Agents that handle workflows end to end: customer service, research, data entry, multi-step automation. Custom MCP servers, tool use, and multi-agent orchestration.",
    gradient: "from-primary/20 to-primary/20",
    iconColor: "text-primary",
  },
  {
    id: "03",
    icon: ImagePlus,
    title: "Generative Media",
    desc: "Image and video generation pipelines with Stable Diffusion, DALL-E, and custom-trained models. Product imagery, marketing assets, and virtual try-on at scale.",
    gradient: "from-success/20 to-success/20",
    iconColor: "text-success",
  },
  {
    id: "04",
    icon: LineChart,
    title: "Predictive Analytics",
    desc: "Demand forecasting, churn prediction, risk scoring, and trend analysis. Models that plug into your existing dashboards and return numbers you can act on.",
    gradient: "from-warning/20 to-warning/20",
    iconColor: "text-warning",
  },
  {
    id: "05",
    icon: ScanEye,
    title: "Computer Vision & NLP",
    desc: "Image recognition, visual inspection, sentiment analysis, document processing, and translation. Classic ML and deep learning, chosen by what the problem needs.",
    gradient: "from-primary/20 to-primary/20",
    iconColor: "text-primary",
  },
  {
    id: "06",
    icon: Database,
    title: "Data Engineering & BI",
    desc: "The plumbing AI depends on: ETL pipelines, data warehouses on Snowflake and BigQuery, streaming with Kafka, and executive dashboards your team actually opens.",
    gradient: "from-warning/20 to-info/20",
    iconColor: "text-warning",
  },
];

const whyChooseUs = [
  {
    title: "Production First",
    desc: "Demos are easy. We ship models with monitoring, fallbacks, and cost controls so they survive real traffic.",
  },
  {
    title: "Model Agnostic",
    desc: "We pick per problem: hosted APIs when they're enough, fine-tuned or open models when they're not. No vendor lock-in.",
  },
  {
    title: "Your Data Stays Yours",
    desc: "Private deployments, data agreements, and pipelines that keep sensitive information inside your infrastructure.",
  },
  {
    title: "Measured Outcomes",
    desc: "Every engagement defines success metrics up front: accuracy, cost per task, hours saved. We report against them.",
  },
  {
    title: "Full Stack Delivery",
    desc: "From data pipelines to API to frontend, one team owns the whole path so nothing falls between vendors.",
  },
  {
    title: "Ongoing Optimization",
    desc: "Models drift and prompts age. We monitor, retrain, and tune after launch as part of the engagement.",
  },
];

const techStack = [
  "Python",
  "OpenAI",
  "Anthropic",
  "LangChain",
  "TensorFlow",
  "PyTorch",
  "pgvector",
  "Pinecone",
  "Stable Diffusion",
  "Kafka",
  "Spark",
  "Snowflake",
];

const faqs = [
  {
    question: "How long does it take to implement AI solutions?",
    answer: "A focused LLM integration or chatbot typically ships in 4-8 weeks. Custom model training and data-heavy pipelines take 8-12 weeks or more. We scope honestly after seeing your data.",
  },
  {
    question: "What data do you need to start?",
    answer: "For chatbots and agents: your docs, FAQs, and past support tickets. For predictive models: historical records with the outcomes you want to predict. If your data is messy, cleaning it is part of the engagement.",
  },
  {
    question: "Can AI models run on our own infrastructure?",
    answer: "Yes. We deploy open-weight models on your cloud or on-prem when data can't leave your environment, and use hosted APIs when that's overkill. The tradeoffs are cost, control, and speed — we walk through them with you.",
  },
  {
    question: "How do you keep AI costs under control?",
    answer: "Token budgets, response caching, model routing (small models for easy tasks, large for hard ones), and per-feature cost monitoring. You see the spend per feature, not one mystery bill.",
  },
  {
    question: "Do you provide support after launch?",
    answer: "Yes: monitoring for accuracy and drift, prompt and model updates as providers ship new versions, and retraining pipelines when your data grows.",
  },
];
---

<ServicePageLayout
  title="AI & Machine Learning"
  description="AI development services: LLM integration, AI agents, generative media, predictive analytics, computer vision, and data engineering."
  heroBadge="AI & Machine Learning"
  heroTitle="AI That"
  heroSubtitle="Ships."
  heroDescription="Chatbots, agents, generative media, and predictive models — built on GPT, Claude, and open models, wired into your actual systems, and measured on results instead of demos."
  introTitle="Practical AI, production-grade"
  introText="Most AI projects die between the demo and the deployment. Ours don't, because we build the boring parts first: clean data pipelines, evaluation suites, and cost controls. Then the model goes live with monitoring, and you get reports on what it actually does for your business."
  servicesTitle="AI & ML Services"
  servicesDescription="Six ways we put AI to work, from a support bot to a full data platform."
  services={services}
  whyChooseUs={whyChooseUs}
  whyChooseTitle="Why Choose Aexaware for AI & ML"
  whyChooseDescription="Research-grade models, production engineering habits, and no hype."
  techStack={techStack}
  faqs={faqs}
/>
