  servicesDescription="Practical AI solutions that automate, optimize, and create new possibilities."
  services={services}
  whyChooseUs={whyChooseUs}
  whyChooseTitle="Why Choose Aexaware for AI"
  whyChooseDescription="AI expertise grounded in practical business applications."
  techStack={techStack}
/>
