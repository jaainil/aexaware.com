---
import ServicePageLayout from "@/layouts/ServicePageLayout.astro";
import { Globe, Server, ShoppingCart, FileText, RefreshCw, Cloud } from "lucide-astro";

const services = [
  {
    id: "01",
    icon: Globe,
    title: "React & Next.js Development",
    desc: "Modern, fast web applications with React and Next.js. Server-side rendering, static generation, and dynamic features for optimal performance and SEO.",
    gradient: "from-primary/20 to-info/20",
    iconColor: "text-primary",
  },
  {
    id: "02",
    icon: Server,
    title: "Custom Web Applications",
    desc: "Full-stack builds on Node.js, Python, and PHP/Laravel. REST and GraphQL APIs, real-time features, and business logic that fits how you actually work.",
    gradient: "from-success/20 to-success/20",
    iconColor: "text-success",
  },
  {
    id: "03",
    icon: ShoppingCart,
    title: "E-commerce Builds",
    desc: "Stores on Shopify and WooCommerce, or fully custom with Medusa. Payment integration with Stripe, PayPal, and Razorpay, inventory management, and conversion-focused checkout.",
    gradient: "from-primary/20 to-primary/20",
    iconColor: "text-primary",
  },
  {
    id: "04",
    icon: FileText,
    title: "CMS & Headless Content",
    desc: "WordPress with custom themes and plugins, or headless stacks on Sanity, Strapi, and Contentful with Next.js frontends. Your team edits content without touching code.",
    gradient: "from-warning/20 to-warning/20",
    iconColor: "text-warning",
  },
  {
    id: "05",
    icon: Cloud,
    title: "SaaS Platforms & APIs",
    desc: "Multi-tenant SaaS products with subscription management, plus the public APIs and SDKs that let customers build on your platform.",
    gradient: "from-primary/20 to-primary/20",
    iconColor: "text-primary",
  },
  {
    id: "06",
    icon: RefreshCw,
    title: "Legacy Modernization",
    desc: "Migrate aging sites and systems to modern stacks while preserving content, URLs, and search rankings. Phased moves, no big-bang rewrites.",
    gradient: "from-warning/20 to-destructive/20",
    iconColor: "text-warning",
  },
];

const whyChooseUs = [
  {
    title: "Modern Tech Stack",
    desc: "We use the latest frameworks and tools to build fast, scalable, and maintainable web applications.",
  },
  {
    title: "SEO Optimized",
    desc: "Every website we build is optimized for search engines from the ground up, helping you rank higher.",
  },
  {
    title: "Responsive Design",
    desc: "Cross-browser and cross-device compatibility ensures your website looks great everywhere.",
  },
  {
    title: "Performance Focused",
    desc: "We optimize for Core Web Vitals and page speed, critical factors for user experience and SEO.",
  },
  {
    title: "Security First",
    desc: "From HTTPS to input validation, we implement security best practices to protect your users.",
  },
  {
    title: "Scalable Architecture",
    desc: "Built to handle growth—from your first visitors to millions of monthly users.",
  },
];

const techStack = [
  "React",
  "Next.js",
  "TypeScript",
  "Node.js",
  "Python",
  "PHP",
  "Laravel",
  "PostgreSQL",
  "MongoDB",
  "Shopify",
  "WooCommerce",
  "WordPress",
  "Stripe",
  "AWS",
];

const faqs = [
  {
    question: "How long does it take to build a custom web application?",
    answer: "Project timelines vary based on complexity. A simple website takes 4-6 weeks, while complex web applications can take 3-6 months. We provide detailed timelines after the discovery phase.",
  },
  {
    question: "Which platform should we choose for our store or content site?",
    answer: "Shopify is the fastest path to selling online, WooCommerce suits WordPress-first teams, and headless CMS plus a custom frontend wins on performance and flexibility. We recommend based on your budget, content workflow, and growth plans.",
  },
  {
    question: "What is the cost of web development services?",
    answer: "Costs depend on project scope, features, and complexity. We offer flexible pricing models: fixed-price for defined projects, time-and-material for evolving requirements, and dedicated team models for long-term partnerships.",
  },
  {
    question: "Can you migrate our existing website or CMS without losing SEO?",
    answer: "Yes. We handle data migration, URL redirects, and content preservation so rankings survive the move. We've migrated sites from WordPress, PHP, and legacy platforms to Next.js, React, and Astro.",
  },
  {
    question: "Do you provide post-launch support and maintenance?",
    answer: "Yes, we offer 90-day post-launch warranty and ongoing maintenance packages. Our support includes security updates, performance monitoring, bug fixes, and feature enhancements.",
  },
];
---

<ServicePageLayout
  title="Web & Software Development"
  description="Custom web and software development: React, Next.js, Node.js, e-commerce, CMS, SaaS platforms, and legacy modernization."
  heroBadge="Web & Software"
  heroTitle="Websites & Software"
  heroSubtitle="That Hold Up."
  heroDescription="From marketing sites to e-commerce stores to SaaS platforms: designed, built, and shipped by one team. Fast to launch, cheap to maintain, ready for real traffic."
  introTitle="What we build"
  introText="Web platforms, online stores, content sites, and custom business software. One team covers the whole range, so you never get handed off between agencies mid-project. Every build ships with analytics, security basics, and a staging environment you can test on."
  servicesTitle="Web & Software Services"
  servicesDescription="Six ways we build for the web, from a first store to a full platform."
  services={services}
  whyChooseUs={whyChooseUs}
  whyChooseTitle="Why Choose Aexaware for Web & Software"
  whyChooseDescription="With deep expertise across frameworks and technologies, we deliver web experiences that stand out."
  techStack={techStack}
  faqs={faqs}
/>
