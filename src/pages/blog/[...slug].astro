---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import { Calendar, User, Clock, ChevronRight } from "lucide-astro";
import { Image } from "astro:assets";
import Comments from "@/components/Comments.astro";
import BlogSidebar from "@/components/BlogSidebar.astro";
import ReadNext from "@/components/ReadNext.astro";
import { Schema } from "astro-seo-schema";
import BackgroundGrid from "@/components/astro/BackgroundGrid.astro";
import CTA from "@/components/astro/CTA.astro";
import Prose from "@/components/Prose.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await post.render();

// Helper to format date
const formatDate = (date: Date) => {
  return date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
};

// Generate Article JSON-LD
const siteUrl = Astro.site || "https://aexaware.com";
---

<Layout
  title={post.data.title}
  description={post.data.description}
  image={post.data.image?.src ?? "/og-image.png"}
  type="article"
  publishedTime={post.data.date.toISOString()}
  modifiedTime={post.data.date.toISOString()}
  author={post.data.author}
>
  <Schema
    slot="head"
    item={{
      "@context": "https://schema.org",
      "@type": "Article",
      headline: post.data.title,
      description: post.data.description,
      image: post.data.image
        ? new URL(post.data.image.src, siteUrl).href
        : new URL("/og-image.png", siteUrl).href,
      datePublished: post.data.date.toISOString(),
      dateModified: post.data.date.toISOString(),
      author: {
        "@type": "Person",
        name: post.data.author,
      },
      publisher: {
        "@type": "Organization",
        name: "Aexaware Infotech",
        logo: {
          "@type": "ImageObject",
          url: new URL("/og-image.png", siteUrl).href,
        },
      },
    }}
  />
  <Schema
    slot="head"
    item={{
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: siteUrl.toString(),
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Blog",
          item: new URL("/blog", siteUrl).href,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: post.data.title,
        },
      ],
    }}
  />

  {/* Modern Grid Background - Fixed to stay behind content */}
  {/* FIX: Semantic Grid Background */}
  <BackgroundGrid density="sm" fixed mask="top" class="-z-10" />

  <article>
    {/* Hero Section */}
    <section
      class="relative pt-(--navbar-height) pb-16 lg:pb-20 overflow-hidden"
    >
      <div class="container-normal">
        <div class="text-center max-w-4xl mx-auto">
          {/* Breadcrumbs */}
          <nav
            class="flex items-center justify-center gap-2 mb-10 text-sm text-muted-foreground"
            aria-label="Breadcrumb"
          >
            <a href="/" class="hover:text-foreground transition-colors">Home</a>
            <ChevronRight class="size-3 text-muted-foreground/40" />
            <a href="/blog" class="hover:text-foreground transition-colors"
              >Blog</a
            >
          </nav>

          {/* Title - full width like parent container */}
          <h1
            class="font-heading font-bold text-3xl sm:text-4xl lg:text-5xl tracking-tighter leading-[1.1] text-foreground mb-8"
          >
            {post.data.title}
          </h1>

          {/* Description */}
          {
            post.data.description && (
              <p class="text-xl text-muted-foreground mt-4 mb-8 max-w-2xl mx-auto leading-relaxed">
                {post.data.description}
              </p>
            )
          }

          <div
            class="flex flex-wrap items-center justify-center gap-y-4 gap-x-8 text-muted-foreground text-sm"
          >
            <div class="flex items-center gap-2">
              <div
                class="size-8 rounded-full bg-muted flex items-center justify-center border border-border"
              >
                <User className="size-4" />
              </div>
              <span class="font-medium text-foreground">{post.data.author}</span
              >
            </div>
            <div class="flex items-center gap-2">
              <Calendar className="size-4" />
              {formatDate(post.data.date)}
            </div>
            <div class="flex items-center gap-2">
              <Clock className="size-4" />
              {remarkPluginFrontmatter.minutesRead}
            </div>
          </div>
        </div>
      </div>
    </section>

    <div class="container-normal pb-16 lg:pb-24">
      {/* Cinematic Image */}
      {
        post.data.image && (
          <div class="max-w-[1400px] mx-auto mb-20">
            <div class="aspect-video relative rounded-section overflow-hidden shadow-2xl border border-border/50">
              <Image
                src={post.data.image}
                alt={post.data.title}
                class="w-full h-full object-cover"
                width={1400}
                height={800}
                format="webp"
                quality={90}
                loading="eager"
                layout="none"
              />
              <div class="absolute inset-0 bg-linear-to-t from-background/20 via-transparent to-transparent opacity-40 pointer-events-none" />
            </div>
          </div>
        )
      }

      <div
        class="grid grid-cols-1 lg:grid-cols-12 gap-16 max-w-[1400px] mx-auto"
      >
        {/* Main Content Column */}
        <div class="lg:col-span-8 order-1">
          <Prose
            size="xl"
            class="[&_pre_code]:bg-transparent [&_pre_code]:p-0 [&_pre_code]:text-inherit"
          >
            <Content />
          </Prose>

          <ReadNext currentSlug={post.slug} />
          <Comments />
        </div>

        {/* Sidebar Column */}
        <div class="hidden lg:block lg:col-span-4 order-2">
          <BlogSidebar
            headings={headings}
            url={Astro.url.href}
            title={post.data.title}
          />
        </div>
      </div>
    </div>
  </article>

  {/* Standardized CTA */}
  <CTA
    title="Need expert tech solutions?"
    titleHighlight=""
    description="Turn these insights into action. Let's build your next big project together."
    buttonText="Get Expert Help"
    class="mb-24"
  />
</Layout>
