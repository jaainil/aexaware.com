---
import Layout from '@/layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { ArrowRight, Calendar, Sparkles, ChevronRight } from 'lucide-astro';
import { Image } from 'astro:assets';

export async function getStaticPaths() {
  // Helper to slugify text
  const slugify = (text: string) => {
    return text
      .toString()
      .toLowerCase()
      .trim()
      .replace(/\s+/g, '-')      // Replace spaces with -
      .replace(/[^\w\-]+/g, '') // Remove all non-word chars
      .replace(/\-\-+/g, '-');  // Replace multiple - with single -
  };

  const allPosts = await getCollection('blog');
  // Get unique categories, ensuring we filter out undefined
  const uniqueCategories = [...new Set(allPosts.map((post) => post.data.category).filter(Boolean))];

  return uniqueCategories.map((category) => {
    // Filter posts that match this category
    const filteredPosts = allPosts.filter((post) => 
      post.data.category === category
    ).sort(
      (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
    );
    
    return {
      params: { category: slugify(category as string) },
      props: { posts: filteredPosts, categoryName: category },
    };
  });
}

const { category } = Astro.params;
const { posts, categoryName } = Astro.props;

// Helper to format date
const formatDate = (date: Date) => {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
};
---

<Layout 
  title={`${categoryName} Articles | Aexaware Tech Blog`} 
  description={`Explore our latest articles and insights on ${categoryName}.`}
>
  
  {/* Hero Section */}
  {/* FIX: Use 100dvh for full-screen hero on mobile and desktop */}
  <section class="relative w-full min-h-[100dvh] flex flex-col justify-center pt-[var(--navbar-height)] pb-16 lg:pb-24 overflow-hidden border-b border-border/40">
    
    {/* FIX: Semantic Grid Background */}
    <div class="absolute inset-0 bg-[linear-gradient(to_right,hsl(var(--foreground)/0.03)_1px,transparent_1px),linear-gradient(to_bottom,hsl(var(--foreground)/0.03)_1px,transparent_1px)] bg-[size:14px_24px] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)] pointer-events-none" />

    <div class="container-normal relative z-10">
      <div class="max-w-4xl mx-auto text-center">
         <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-primary/20 bg-primary/5 backdrop-blur-sm mb-6">
          <Sparkles className="w-4 h-4 text-primary" />
          <span class="text-sm font-semibold text-primary tracking-wide uppercase">Category Archive</span>
        </div>

        {/* FIX: Use font-heading */}
        <h1 class="font-heading font-bold text-4xl sm:text-6xl lg:text-7xl tracking-tighter leading-[0.9] text-foreground mb-6 text-balance overflow-visible py-2">
          All articles in <br class="hidden sm:block" />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-accent">{categoryName}</span>
        </h1>
        <p class="mx-auto mt-6 max-w-2xl text-lg text-muted-foreground leading-relaxed text-pretty">
           Deep dives, tutorials, and insights specifically about {categoryName}.
        </p>
      </div>
    </div>
  </section>

  {/* Blog Grid */}
  <section class="section-padding bg-background relative">
    <div class="container-normal">
      <div class="grid gap-12 md:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => (
          <a
             href={`/blog/${post.slug}`}
             class="group flex flex-col"
          >
            <div class="aspect-[16/10] overflow-hidden rounded-card-lg bg-muted mb-6 relative border border-border/50">
              {post.data.image && (
                <Image
                  src={post.data.image}
                  alt={post.data.title}
                  class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                  width={800}
                  height={500}
                  format="webp"
                  quality={80}
                />
              )}
               <div class="absolute inset-0 bg-gradient-to-tr from-primary/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none" />
            </div>
            
            <div class="flex flex-1 flex-col">
              <div class="mb-4 flex items-center gap-4 text-xs font-medium text-muted-foreground">
                 <span class="text-primary font-bold uppercase tracking-wider">
                  {post.data.category || 'Tech'}
                </span>
                <span class="size-1 rounded-full bg-border" />
                <div class="flex items-center gap-1.5">
                  <Calendar className="size-3.5" />
                  {formatDate(post.data.date)}
                </div>
              </div>
              
              <h3 class="font-heading text-2xl font-bold text-foreground mb-3 leading-tight group-hover:text-primary transition-colors">
                  {post.data.title}
              </h3>
              
              <p class="mb-6 text-muted-foreground leading-relaxed line-clamp-2 text-base">
                {post.data.description}
              </p>
              
              <div class="mt-auto flex items-center gap-2 text-sm font-semibold text-primary opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300">
                  Read More <ChevronRight className="size-4" />
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>