---
import Layout from '@/layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { ArrowRight, Calendar, User } from 'lucide-astro';
import { Image } from 'astro:assets';

export async function getStaticPaths() {
  // Helper to slugify tags
  const slugify = (text: string) => {
    return text
      .toString()
      .toLowerCase()
      .trim()
      .replace(/\s+/g, '-')     // Replace spaces with -
      .replace(/[^\w\-]+/g, '') // Remove all non-word chars
      .replace(/\-\-+/g, '-');  // Replace multiple - with single -
  };

  const allPosts = await getCollection('blog');
  const uniqueTags = [...new Set(allPosts.map((post) => post.data.tags).flat())];

  return uniqueTags.map((tag) => {
    // Filter posts that contain the original tag
    const filteredPosts = allPosts.filter((post) => 
      post.data.tags && post.data.tags.includes(tag as string)
    ).sort(
      (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
    );
    return {
      params: { tag: slugify(tag as string) },
      props: { posts: filteredPosts, tagName: tag },
    };
  });
}

const { tag } = Astro.params;
const { posts, tagName } = Astro.props;

// Helper to format date
const formatDate = (date: Date) => {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
};
---

<Layout 
  title={`Blog Posts Tagged with ${tag} | Aexaware Tech Blog`} 
  description={`Explore our latest articles and insights on ${tag}.`}
>
  {/* Hero Section - Updated to match Main Blog */}
  <section class="relative w-full min-h-[100svh] flex flex-col justify-center py-32 lg:py-48 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-primary/5 to-transparent -z-10" />
    <div class="container mx-auto px-6 lg:px-8 relative z-10">
      <div class="max-w-4xl mx-auto text-center">
        <span class="inline-block px-4 py-1.5 rounded-full bg-primary/10 text-primary text-sm font-medium">
          Tag Archive
        </span>
        <h1 class="mt-8 font-serif text-5xl font-medium leading-tight text-foreground sm:text-6xl lg:text-7xl">
          Posts tagged with <br/>
          <span class="italic text-muted-foreground">#{tagName}</span>
        </h1>
        <p class="mx-auto mt-8 max-w-2xl text-lg text-muted-foreground leading-relaxed">
          Browse our collection of articles related to {tagName}.
        </p>
      </div>
    </div>
  </section>

  {/* Blog Grid */}
  <section class="py-24 bg-secondary/30">
    <div class="container mx-auto px-6 lg:px-8">
      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => (
          <div class="group flex flex-col overflow-hidden rounded-3xl bg-background border border-border/50 transition-all hover:shadow-xl hover:-translate-y-1">
            <a
              href={`/blog/${post.slug}`}
              class="aspect-[16/9] overflow-hidden bg-muted block"
            >
              {post.data.image && (
                <Image
                  src={post.data.image}
                  alt={post.data.title}
                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                  width={800}
                  height={450}
                />
              )}
            </a>
            <div class="flex flex-1 flex-col p-6">
              <div class="mb-4 flex items-center gap-4 text-xs text-muted-foreground">
                <span class="font-semibold uppercase tracking-wider text-primary">
                  {post.data.tags ? post.data.tags[0] : 'Tech'}
                </span>
                <div class="flex items-center gap-1">
                  <Calendar className="size-3" />
                  {formatDate(post.data.date)}
                </div>
              </div>
              <a href={`/blog/${post.slug}`} class="block mb-3">
                <h3 class="text-xl font-medium text-foreground group-hover:text-primary transition-colors">
                  {post.data.title}
                </h3>
              </a>
              <p class="mb-6 text-muted-foreground leading-relaxed line-clamp-3 text-sm">
                {post.data.description}
              </p>
              <div class="mt-auto flex items-center justify-between border-t border-border pt-4">
                <div class="flex items-center gap-2 text-sm text-muted-foreground">
                  <User className="size-4" />
                  {post.data.author}
                </div>
                <a href={`/blog/${post.slug}`} class="inline-flex items-center gap-2 text-sm font-medium text-primary hover:text-primary/80 transition-colors group/link">
                  Read More 
                  <ArrowRight className="size-4 transition-transform group-hover/link:translate-x-1" />
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
