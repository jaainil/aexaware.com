---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import { Image } from 'astro:assets';
import { buttonVariants } from '@/components/ui/button-variants';
import { cn } from '@/lib/utils';
import { ArrowLeft, ExternalLink, Calendar, Clock, Layers } from 'lucide-astro';

export async function getStaticPaths() {
  const posts = await getCollection('portfolio');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
---

<Layout title={`${post.data.title} | Case Study`} description={post.data.description}>
  <div class="relative pt-32 pb-20 lg:pt-48 lg:pb-32 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-primary/5 to-transparent -z-10" />
    
    <div class="container mx-auto px-6 lg:px-8">
      {/* Back Link */}
      <a 
        href="/portfolio" 
        class="inline-flex items-center gap-2 text-sm text-muted-foreground hover:text-primary transition-colors mb-12"
      >
        <ArrowLeft class="size-4" />
        Back to Portfolio
      </a>

      {/* Header */}
      <div class="grid lg:grid-cols-2 gap-12 items-center mb-16">
        <div>
           {post.data.client && (
            <span class="inline-block px-4 py-1.5 rounded-full bg-primary/10 text-primary text-sm font-medium mb-6">
              {post.data.client}
            </span>
          )}
          <h1 class="font-serif text-3xl md:text-5xl lg:text-6xl font-medium leading-tight text-foreground mb-6">
            {post.data.title}
          </h1>
          <p class="text-xl text-muted-foreground leading-relaxed">
            {post.data.description}
          </p>
        </div>
        
        {/* Project Meta */}
        <div class="bg-secondary/30 rounded-3xl p-6 md:p-8 border border-border/50">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
            <div>
              <div class="flex items-center gap-2 text-muted-foreground mb-2">
                <Layers class="size-4" />
                <span class="text-sm font-medium">Category</span>
              </div>
              <p class="font-medium text-foreground">{post.data.category}</p>
            </div>
            
            <div>
              <div class="flex items-center gap-2 text-muted-foreground mb-2">
                <Calendar class="size-4" />
                <span class="text-sm font-medium">Year</span>
              </div>
              <p class="font-medium text-foreground">{post.data.year}</p>
            </div>

            <div>
              <div class="flex items-center gap-2 text-muted-foreground mb-2">
                <Clock class="size-4" />
                <span class="text-sm font-medium">Duration</span>
              </div>
               <p class="font-medium text-foreground">{post.data.duration ?? "Ongoing"}</p>
            </div>

            {post.data.website && (
              <div>
                <span class="text-sm font-medium text-muted-foreground block mb-2">Live Site</span>
                <a 
                  href={post.data.website} 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1 text-primary hover:underline font-medium"
                >
                  Visit Website
                  <ExternalLink class="size-3" />
                </a>
              </div>
            )}
          </div>

          <div class="mt-8 pt-8 border-t border-border/50">
           <span class="text-sm font-medium text-muted-foreground block mb-4">Technologies</span>
            <div class="flex flex-wrap gap-2">
              {post.data.technologies.map(tech => (
                <span class="bg-background border border-border px-3 py-1 rounded-full text-sm text-muted-foreground">
                  {tech}
                </span>
              ))}
            </div>
          </div>
        </div>
      </div>

       {/* Hero Image */}
       <div class="aspect-video relative rounded-3xl overflow-hidden shadow-2xl border border-border/50 mb-20">
          <Image
            src={post.data.image}
            alt={post.data.imageAlt || post.data.title}
            width={1600}
            height={900}
            class="w-full h-full object-cover"
            loading="eager"
          />
       </div>

      {/* Content */}
      <div class="max-w-3xl mx-auto">
        <div class="prose prose-lg prose-slate dark:prose-invert max-w-none prose-headings:font-serif prose-headings:font-medium prose-p:text-muted-foreground prose-p:leading-relaxed prose-li:text-muted-foreground">
          <Content />
        </div>
      </div>
      
       {/* CTA */}
      <div class="max-w-3xl mx-auto mt-24 pt-12 border-t border-border">
        <div class="bg-primary text-primary-foreground rounded-3xl p-8 md:p-12 text-center">
            <h2 class="font-serif text-3xl md:text-4xl font-medium mb-4">Inspired by this project?</h2>
            <p class="text-primary-foreground/80 mb-8 max-w-xl mx-auto">
                Let's discuss how we can build something similar for your business.
            </p>
            <a 
            href="/contact" 
            class={cn(buttonVariants({ variant: "secondary", size: "lg" }), "rounded-full px-8")}
            >
            Start Your Project
            </a>
        </div>
      </div>

    </div>
  </div>
</Layout>
