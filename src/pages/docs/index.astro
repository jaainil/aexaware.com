---
import Layout from '@/layouts/Layout.astro';
import { BookOpen, Key, Webhook, Bot, FileCode, CheckCircle2, ArrowRight, Code2, Terminal, ExternalLink, ShieldCheck, Sparkles } from 'lucide-astro';
import BackgroundGrid from '@/components/home/BackgroundGrid.astro';
import CTA from '@/components/home/CTA.astro';

const docCards = [
  {
    title: "Aexaware OpenAPI Specification",
    description: "Machine-readable OpenAPI 3.1.0 specification defining our public API endpoints, schemas, parameters, and responses.",
    href: "/docs/openapi",
    badge: "OpenAPI 3.1",
    icon: FileCode,
    links: [
      { label: "View JSON Spec", url: "/openapi.json" },
      { label: "View YAML Spec", url: "/openapi.yaml" }
    ]
  },
  {
    title: "Aexaware Authentication & Agent Permissions",
    description: "Authorization flows, OAuth 2.0 metadata, Bearer token integration, and identity assertion verification for AI agents.",
    href: "/docs/auth",
    badge: "OAuth & Auth.md",
    icon: Key,
    links: [
      { label: "Read auth.md", url: "/auth.md" },
      { label: "OAuth Server Card", url: "/.well-known/oauth-authorization-server" }
    ]
  },
  {
    title: "Aexaware Webhooks & Event Notifications",
    description: "Subscribe to real-time events with HMAC-SHA256 signature verification and exponential backoff retry handling.",
    href: "/docs/webhooks",
    badge: "Webhooks",
    icon: Webhook,
    links: [
      { label: "Read webhooks.md", url: "/webhooks.md" }
    ]
  },
  {
    title: "Aexaware Model Context Protocol (MCP) Server",
    description: "Connect Claude, ChatGPT, Cursor, and custom agent workflows directly to Aexaware Infotech tools and resources.",
    href: "/docs/mcp",
    badge: "MCP Server",
    icon: Bot,
    links: [
      { label: "MCP Server Card", url: "/.well-known/mcp/server-card.json" },
      { label: "Read mcp.md", url: "/mcp.md" }
    ]
  }
];

const endpoints = [
  {
    method: "GET",
    path: "/openapi.json",
    description: "Returns the OpenAPI 3.1.0 specification in JSON format.",
    contentType: "application/vnd.oai.openapi+json",
    auth: "Public",
  },
  {
    method: "GET",
    path: "/openapi.yaml",
    description: "Returns the OpenAPI 3.1.0 specification in YAML format.",
    contentType: "application/yaml",
    auth: "Public",
  },
  {
    method: "GET",
    path: "/llms.txt",
    description: "Structured markdown summary of Aexaware Infotech services and architecture for LLMs.",
    contentType: "text/plain; charset=utf-8",
    auth: "Public",
  },
  {
    method: "GET",
    path: "/llms-full.txt",
    description: "Comprehensive markdown documentation of all services, portfolio projects, and blogs.",
    contentType: "text/plain; charset=utf-8",
    auth: "Public",
  },
  {
    method: "GET",
    path: "/.well-known/api-catalog",
    description: "RFC 9727 API Catalog Linkset index defining service documentation and descriptor URLs.",
    contentType: "application/linkset+json",
    auth: "Public",
  },
  {
    method: "GET",
    path: "/.well-known/mcp/server-card.json",
    description: "Model Context Protocol (MCP) server descriptor card and registered tool definitions.",
    contentType: "application/json",
    auth: "Public",
  },
  {
    method: "GET",
    path: "/.well-known/agent-skills/index.json",
    description: "Directory of capabilities, tools, and skills available for AI agent workflows.",
    contentType: "application/json",
    auth: "Public",
  },
  {
    method: "GET",
    path: "/auth.md",
    description: "Standardized agent authorization policy and credential discovery metadata.",
    contentType: "text/markdown; charset=utf-8",
    auth: "Public",
  },
  {
    method: "GET",
    path: "/webhooks.md",
    description: "Webhook event definitions, payload schemas, and HMAC-SHA256 signature instructions.",
    contentType: "text/markdown; charset=utf-8",
    auth: "Public",
  },
  {
    method: "GET",
    path: "/sitemap-index.xml",
    description: "Primary XML sitemap index listing all crawlable pages and service routes.",
    contentType: "application/xml",
    auth: "Public",
  },
  {
    method: "GET",
    path: "/rss.xml",
    description: "RSS 2.0 XML feed of published technical blogs and software engineering articles.",
    contentType: "application/rss+xml",
    auth: "Public",
  },
];
---

<Layout
  title="Aexaware Infotech Developer Documentation & API Reference"
  description="Official developer documentation for Aexaware Infotech. Access our OpenAPI specification, authentication guide, webhooks documentation, and MCP server endpoints."
  tags={["Aexaware developer docs", "Aexaware API documentation", "Aexaware OpenAPI spec", "Aexaware auth docs", "Aexaware webhooks", "Aexaware MCP server"]}
>
  <div class="relative w-full bg-background min-h-dvh pt-32 pb-24 overflow-hidden border-b border-border/40">
    <BackgroundGrid density="md" mask="center" />

    {/* Ambient Glows */}
    <div
      class="pointer-events-none absolute top-0 left-1/2 -translate-x-1/2 -z-10 h-[500px] w-[1000px] rounded-full bg-primary/10 blur-3xl"
      aria-hidden="true"
    >
    </div>

    <div class="container-normal relative z-10">
      <!-- Breadcrumb & Header -->
      <div class="max-w-3xl mb-16">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-primary/20 bg-primary/5 text-primary text-xs font-semibold uppercase tracking-wider mb-6">
          <BookOpen class="w-3.5 h-3.5" />
          Developer Portal & API Reference
        </div>

        <h1 class="font-heading font-bold text-4xl sm:text-5xl md:text-6xl text-foreground tracking-tight mb-6">
          Aexaware Infotech <span class="text-primary">Developer Documentation</span>
        </h1>

        <p class="text-xl text-muted-foreground leading-relaxed">
          The complete guide to Aexaware Infotech's public APIs, OpenAPI 3.1.0 specifications, security authentication, webhooks, and Model Context Protocol (MCP) server endpoints.
        </p>
      </div>

      <!-- Quick Resource Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-20">
        {docCards.map((doc) => (
          <div class="group bg-card/60 backdrop-blur-xs border border-border/50 rounded-card-lg p-8 flex flex-col justify-between hover:border-primary/40 transition-all hover:shadow-xl">
            <div>
              <div class="flex items-center justify-between mb-6">
                <div class="h-12 w-12 rounded-xl bg-primary/10 flex items-center justify-center text-primary">
                  <doc.icon class="h-6 w-6" />
                </div>
                <span class="text-xs font-semibold px-3 py-1 bg-secondary rounded-full border border-border/60 text-muted-foreground">
                  {doc.badge}
                </span>
              </div>

              <h2 class="font-heading font-bold text-2xl text-foreground mb-3 group-hover:text-primary transition-colors">
                <a href={doc.href} class="hover:underline">
                  {doc.title}
                </a>
              </h2>

              <p class="text-muted-foreground leading-relaxed mb-6">
                {doc.description}
              </p>
            </div>

            <div class="border-t border-border/40 pt-6 flex flex-wrap items-center justify-between gap-4">
              <div class="flex flex-wrap gap-3">
                {doc.links.map((link) => (
                  <a
                    href={link.url}
                    class="text-xs font-medium text-muted-foreground hover:text-foreground underline underline-offset-4 transition-colors"
                  >
                    {link.label}
                  </a>
                ))}
              </div>

              <a
                href={doc.href}
                class="inline-flex items-center text-sm font-semibold text-primary hover:text-primary/80 transition-colors"
              >
                Documentation <ArrowRight class="ml-1 w-4 h-4" />
              </a>
            </div>
          </div>
        ))}
      </div>

      <!-- 1. Authentication Section -->
      <section id="authentication" class="mb-20">
        <div class="flex items-center gap-3 mb-6">
          <div class="p-2.5 rounded-xl bg-primary/10 text-primary">
            <Key class="w-6 h-6" />
          </div>
          <div>
            <h2 class="font-heading font-bold text-3xl text-foreground">
              Aexaware API Authentication
            </h2>
            <p class="text-muted-foreground text-sm">Security models, open discovery, and agent authorization</p>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
          <div class="p-6 bg-card border border-border/50 rounded-card">
            <div class="flex items-center gap-2 text-primary font-semibold text-sm mb-2">
              <CheckCircle2 class="w-4 h-4" /> Public & Open Discovery
            </div>
            <p class="text-sm text-muted-foreground leading-relaxed">
              All OpenAPI specifications, LLMs.txt summaries, service catalogs, sitemaps, and RSS feeds on <strong class="text-foreground">https://aexaware.com</strong> are completely public and accessible without authentication.
            </p>
          </div>

          <div class="p-6 bg-card border border-border/50 rounded-card">
            <div class="flex items-center gap-2 text-primary font-semibold text-sm mb-2">
              <ShieldCheck class="w-4 h-4" /> Authenticated Integrations
            </div>
            <p class="text-sm text-muted-foreground leading-relaxed">
              For dedicated partner endpoints and verified agent requests, credentials can be supplied using standard Bearer tokens or API keys:
            </p>
            <div class="mt-3 bg-secondary/50 rounded-md p-3 font-mono text-xs text-foreground">
              <code>Authorization: Bearer &lt;YOUR_API_TOKEN&gt;</code><br />
              <code>X-API-Key: &lt;YOUR_API_KEY&gt;</code>
            </div>
          </div>
        </div>

        <p class="text-sm text-muted-foreground">
          For full agent registration specifications and OAuth metadata, review <a href="/auth.md" class="text-primary underline">auth.md</a> or the <a href="/docs/auth" class="text-primary underline">Authentication Guide</a>.
        </p>
      </section>

      <!-- 2. Endpoints Directory -->
      <section id="endpoints" class="mb-20">
        <div class="flex items-center gap-3 mb-6">
          <div class="p-2.5 rounded-xl bg-primary/10 text-primary">
            <FileCode class="w-6 h-6" />
          </div>
          <div>
            <h2 class="font-heading font-bold text-3xl text-foreground">
              Aexaware API Endpoints Directory
            </h2>
            <p class="text-muted-foreground text-sm">Public endpoints, content feeds, and machine-readable resources</p>
          </div>
        </div>

        <div class="overflow-x-auto border border-border/50 rounded-card bg-card/40">
          <table class="w-full text-left text-sm">
            <thead class="bg-secondary/40 border-b border-border/50 text-xs font-semibold uppercase text-muted-foreground">
              <tr>
                <th class="py-3.5 px-4">Method</th>
                <th class="py-3.5 px-4">Endpoint Path</th>
                <th class="py-3.5 px-4">Content Type</th>
                <th class="py-3.5 px-4">Description</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border/40">
              {endpoints.map((ep) => (
                <tr class="hover:bg-secondary/20 transition-colors">
                  <td class="py-3.5 px-4 font-mono font-bold text-xs text-primary">
                    <span class="px-2 py-0.5 rounded-md bg-primary/10">{ep.method}</span>
                  </td>
                  <td class="py-3.5 px-4 font-mono font-semibold text-foreground">
                    <a href={ep.path} class="hover:text-primary hover:underline">{ep.path}</a>
                  </td>
                  <td class="py-3.5 px-4 text-xs font-mono text-muted-foreground">{ep.contentType}</td>
                  <td class="py-3.5 px-4 text-muted-foreground">{ep.description}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <!-- 3. Example Requests Section -->
      <section id="examples" class="mb-20">
        <div class="flex items-center gap-3 mb-6">
          <div class="p-2.5 rounded-xl bg-primary/10 text-primary">
            <Terminal class="w-6 h-6" />
          </div>
          <div>
            <h2 class="font-heading font-bold text-3xl text-foreground">
              Example API Requests & Code Snippets
            </h2>
            <p class="text-muted-foreground text-sm">Copy-and-paste examples in cURL, JavaScript / TypeScript, and Python</p>
          </div>
        </div>

        <div class="space-y-8">
          <!-- cURL Examples -->
          <div class="border border-border/50 rounded-card-lg bg-card overflow-hidden">
            <div class="bg-secondary/40 px-6 py-3 border-b border-border/50 flex items-center justify-between">
              <span class="text-xs font-bold uppercase tracking-wider text-foreground">1. cURL Requests</span>
              <span class="text-xs text-muted-foreground font-mono">Terminal / CLI</span>
            </div>
            <div class="p-6 space-y-4 font-mono text-xs text-foreground bg-secondary/10 overflow-x-auto">
              <div>
                <p class="text-muted-foreground font-sans mb-1 font-semibold text-xs">// Fetch OpenAPI specification in JSON:</p>
                <code>curl -sL https://aexaware.com/openapi.json | jq .</code>
              </div>
              <div>
                <p class="text-muted-foreground font-sans mb-1 font-semibold text-xs">// Fetch token-efficient markdown context for LLMs:</p>
                <code>curl -sL https://aexaware.com/llms.txt</code>
              </div>
              <div>
                <p class="text-muted-foreground font-sans mb-1 font-semibold text-xs">// Request page in Markdown format via Accept header:</p>
                <code>curl -sL -H "Accept: text/markdown" https://aexaware.com/services/web-development</code>
              </div>
              <div>
                <p class="text-muted-foreground font-sans mb-1 font-semibold text-xs">// Fetch Model Context Protocol (MCP) server card:</p>
                <code>curl -sL https://aexaware.com/.well-known/mcp/server-card.json | jq .</code>
              </div>
            </div>
          </div>

          <!-- JavaScript / TypeScript Example -->
          <div class="border border-border/50 rounded-card-lg bg-card overflow-hidden">
            <div class="bg-secondary/40 px-6 py-3 border-b border-border/50 flex items-center justify-between">
              <span class="text-xs font-bold uppercase tracking-wider text-foreground">2. JavaScript / TypeScript Fetch</span>
              <span class="text-xs text-muted-foreground font-mono">Node.js / Browser</span>
            </div>
            <div class="p-6 font-mono text-xs text-foreground bg-secondary/10 overflow-x-auto">
              <pre><code>{`// Fetch Aexaware OpenAPI 3.1.0 Specification
async function getAexawareApiSpec() {
  const response = await fetch("https://aexaware.com/openapi.json", {
    headers: {
      "Accept": "application/vnd.oai.openapi+json, application/json",
      "User-Agent": "MyAgent/1.0"
    }
  });

  if (!response.ok) {
    throw new Error(\`Failed with status \${response.status}\`);
  }

  const spec = await response.json();
  console.log("Aexaware API Title:", spec.info.title);
  return spec;
}

getAexawareApiSpec().then(console.log);`}</code></pre>
            </div>
          </div>

          <!-- Python Example -->
          <div class="border border-border/50 rounded-card-lg bg-card overflow-hidden">
            <div class="bg-secondary/40 px-6 py-3 border-b border-border/50 flex items-center justify-between">
              <span class="text-xs font-bold uppercase tracking-wider text-foreground">3. Python (requests)</span>
              <span class="text-xs text-muted-foreground font-mono">Python 3</span>
            </div>
            <div class="p-6 font-mono text-xs text-foreground bg-secondary/10 overflow-x-auto">
              <pre><code>{`import requests

def fetch_aexaware_services():
    url = "https://aexaware.com/llms.txt"
    headers = {
        "User-Agent": "AexawareAgent/1.0"
    }
    response = requests.get(url, headers=headers)
    response.raise_for_status()
    
    print("Aexaware Context:")
    print(response.text[:500])

if __name__ == "__main__":
    fetch_aexaware_services()`}</code></pre>
            </div>
          </div>
        </div>
      </section>

      <!-- Agent Discovery Standards Section -->
      <div class="bg-secondary/10 border border-border/60 rounded-card-lg p-8 md:p-12">
        <h2 class="font-heading font-bold text-2xl md:text-3xl text-foreground mb-4">
          Aexaware Machine-Readable Standards
        </h2>
        <p class="text-muted-foreground text-base md:text-lg mb-8 max-w-2xl">
          We implement open standards enabling autonomous agents and LLM crawlers to inspect our capabilities programmatically.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          <div class="bg-background border border-border/40 rounded-card p-5">
            <h3 class="font-heading font-semibold text-base text-foreground mb-2">RFC 9727 API Catalog</h3>
            <p class="text-xs text-muted-foreground mb-4">Machine-readable Linkset directory.</p>
            <a href="/.well-known/api-catalog" class="text-xs font-semibold text-primary hover:underline">View Catalog &rarr;</a>
          </div>

          <div class="bg-background border border-border/40 rounded-card p-5">
            <h3 class="font-heading font-semibold text-base text-foreground mb-2">MCP Server Card</h3>
            <p class="text-xs text-muted-foreground mb-4">Model Context Protocol endpoint registry.</p>
            <a href="/.well-known/mcp/server-card.json" class="text-xs font-semibold text-primary hover:underline">View Server Card &rarr;</a>
          </div>

          <div class="bg-background border border-border/40 rounded-card p-5">
            <h3 class="font-heading font-semibold text-base text-foreground mb-2">LLMs.txt Overview</h3>
            <p class="text-xs text-muted-foreground mb-4">Structured markdown context for LLMs.</p>
            <a href="/llms.txt" class="text-xs font-semibold text-primary hover:underline">Read llms.txt &rarr;</a>
          </div>

          <div class="bg-background border border-border/40 rounded-card p-5">
            <h3 class="font-heading font-semibold text-base text-foreground mb-2">Agent Skills</h3>
            <p class="text-xs text-muted-foreground mb-4">Autonomous agent tooling registry.</p>
            <a href="/.well-known/agent-skills/index.json" class="text-xs font-semibold text-primary hover:underline">View Skills &rarr;</a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <CTA
    title="Ready to Build with Aexaware?"
    titleHighlight="Let's Connect."
    description="Need a custom API, AI agent integration, or enterprise cloud solution? Book a free consultation with our engineering team."
    buttonText="Schedule Consultation"
    buttonHref="https://cal.com/aexaware-infotech"
    secondaryButtonText="Contact Engineers"
    secondaryButtonHref="/contact"
  />
</Layout>

