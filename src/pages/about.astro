
---
import Layout from '@/layouts/Layout.astro';
import { Image } from 'astro:assets';
import teamCollaborationImg from "@/assets/team-collaboration.jpg";
import {
  ArrowRight,
  Target,
  Lightbulb,
  Rocket,
  Users,
  CheckCircle2,
  Code2,
  BarChart3,
  Globe,
  Sparkles
} from "lucide-astro";
import { buttonVariants } from '@/components/ui/button-variants';
import { cn } from '@/lib/utils';

const values = [
  {
    icon: Target,
    title: "Our Mission",
    desc: "To help startups and enterprises turn their ideas into scalable web, mobile, AI/ML and UI/UX solutions.",
    gradient: "from-blue-500/20 to-cyan-500/20"
  },
  {
    icon: Lightbulb,
    title: "Our Vision",
    desc: "To be a trusted IT innovation partner, empowering businesses globally with modern, scalable technology.",
    gradient: "from-purple-500/20 to-pink-500/20"
  },
  {
    icon: Rocket,
    title: "Our Values",
    desc: "Innovation, Customer-Centricity, Reliability, Integrity, and Agility.",
    gradient: "from-amber-500/20 to-orange-500/20"
  },
];

const process = [
  {
    step: "01",
    title: "Discovery & Strategy",
    desc: "We dive deep into your business goals to create a roadmap for success.",
  },
  {
    step: "02",
    title: "Design & Development",
    desc: "Our experts craft intuitive designs and robust code tailored to your needs.",
  },
  {
    step: "03",
    title: "Testing & Launch",
    desc: "Rigorous quality assurance ensures a flawless deployment to the world.",
  },
  {
    step: "04",
    title: "Growth & Optimization",
    desc: "We monitor performance and iterate to maximize your ROI continuously.",
  },
];

const capabilities = [
  { icon: Globe, label: "Web Development" },
  { icon: Code2, label: "AI/ML Integration" },
  { icon: Users, label: "UI/UX Design" },
  { icon: BarChart3, label: "Cloud & DevOps" },
  { icon: Rocket, label: "Mobile Apps" },
  { icon: CheckCircle2, label: "QA Testing" },
];
---

<Layout 
  title="About Aexaware Infotech – Trusted Innovation Partner" 
  description="Learn how Aexaware Infotech grew from Vadodara to a global digital agency delivering web, AI and app solutions."
>
  
  {/* Hero Section */}
  {/* FIX: Use 100dvh for full-screen hero on mobile and desktop */}
  <section class="relative w-full min-h-[100dvh] flex flex-col justify-center pt-[var(--navbar-height)] pb-16 lg:pb-24 overflow-hidden border-b border-border/40">
    
    {/* FIX: Semantic Grid Background */}
    <div class="absolute inset-0 bg-[linear-gradient(to_right,hsl(var(--foreground)/0.03)_1px,transparent_1px),linear-gradient(to_bottom,hsl(var(--foreground)/0.03)_1px,transparent_1px)] bg-[size:14px_24px] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)] pointer-events-none" />

    <div class="container-normal relative z-10">
      <div class="max-w-4xl mx-auto text-center">
         <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-primary/20 bg-primary/5 backdrop-blur-sm mb-8">
          <Sparkles className="w-4 h-4 text-primary" />
          <span class="text-sm font-semibold text-primary tracking-wide uppercase">Who We Are</span>
        </div>

        <h1 class="font-heading font-bold text-4xl sm:text-6xl lg:text-8xl tracking-tighter leading-none lg:leading-[0.9] text-foreground mb-8 text-balance">
          Strategic Innovation. <br/>
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-accent">Flawless Execution.</span>
        </h1>
        <p class="mx-auto mt-8 max-w-2xl text-xl text-muted-foreground leading-relaxed text-pretty">
          Aexaware Infotech is a full-service digital agency that helps
          startups and enterprises turn their ideas into scalable web,
          mobile, AI/ML and UI/UX solutions.
        </p>
        <div class="mt-12 flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/contact" class={cn(buttonVariants({ size: "lg" }), "h-14 rounded-full px-10 text-lg shadow-lg hover:shadow-primary/20 transition-all")}>
            Get a Quote 
            <ArrowRight className="ml-2 h-5 w-5" />
          </a>
          <a href="#story" class={cn(buttonVariants({ variant: "outline", size: "lg" }), "h-14 rounded-full px-10 text-lg bg-background/50 hover:bg-background")}>
            Our Story
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* Who We Are & Capabilities */}
  <section id="story" class="section-padding bg-background relative overflow-hidden">
    <div class="container-normal">
      <div class="grid gap-16 lg:grid-cols-2 items-center">
        
        {/* Visual */}
        <div class="relative group">
          <div class="absolute inset-0 bg-gradient-to-tr from-primary/20 to-accent/20 rounded-section blur-2xl opacity-50 -z-10 group-hover:opacity-70 transition-opacity duration-700" />
          <div class="aspect-square rounded-section overflow-hidden border border-border/50 shadow-2xl relative">
            <Image
              src={teamCollaborationImg}
              alt="Team collaboration"
              width={800}
              height={800}
              format="webp"
              class="w-full h-full object-cover grayscale hover:grayscale-0 transition-all duration-700"
            />
             <div class="absolute inset-0 bg-gradient-to-t from-background/60 to-transparent" />
          </div>
          
          {/* Floating Stats Card */}
          <div class="absolute -bottom-8 -right-8 bg-card/80 backdrop-blur-md p-8 rounded-card-lg border border-border/50 shadow-xl hidden md:block max-w-xs">
            <div class="flex items-center gap-4 mb-2">
                <div class="p-2 bg-primary/10 rounded-full text-primary">
                    <CheckCircle2 class="w-6 h-6" />
                </div>
                <span class="text-sm font-bold uppercase tracking-wider text-muted-foreground">Guarantee</span>
            </div>
            <p class="font-serif text-3xl font-bold mb-1 text-foreground">100%</p>
            <p class="text-sm text-muted-foreground">
              Client Satisfaction Commitment
            </p>
          </div>
        </div>

        {/* Content */}
        <div class="space-y-10">
          <div>
              <span class="text-sm font-bold uppercase tracking-widest text-primary mb-4 block">Our DNA</span>
              <h2 class="font-heading font-bold text-4xl md:text-5xl text-foreground mb-6 leading-tight">
                More than just a <br/> development studio.
              </h2>
              <div class="space-y-6 text-lg text-muted-foreground leading-relaxed">
                <p>
                  At Aexaware Infotech, we emphasize a customer-centric
                  approach, full-stack expertise, agile workflows, and
                  end-to-end execution. We listen to clients first, tailor
                  solutions to specific business challenges, and promise on-time
                  delivery with transparent communication.
                </p>
                <p>
                  We aren't just service providers; we are your trusted IT
                  innovation partners. Whether it's crafting a stunning UI/UX,
                  developing robust software, or integrating AI/ML solutions,
                  our team is dedicated to elevating your digital presence.
                </p>
              </div>
          </div>

          <div class="grid grid-cols-2 gap-4">
            {capabilities.map((item) => (
              <div class="flex items-center gap-3 p-3 rounded-xl bg-secondary/30 hover:bg-secondary/50 transition-colors border border-border/50">
                <div class="p-2 rounded-lg bg-background text-primary shadow-sm">
                  <item.icon className="h-4 w-4" />
                </div>
                <span class="font-medium text-foreground text-sm">
                  {item.label}
                </span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* Mission, Vision, Values */}
  <section class="section-padding bg-secondary/5 border-y border-border/40">
    <div class="container-normal">
      <div class="text-center max-w-3xl mx-auto mb-20">
        <span class="text-sm font-bold uppercase tracking-widest text-primary mb-4 block">Core Principles</span>
        <h2 class="font-heading font-bold text-4xl md:text-5xl text-foreground mb-6">
          Our Guiding Principles
        </h2>
        <p class="text-xl text-muted-foreground">
          We are driven by a commitment to excellence and a passion for
          innovation.
        </p>
      </div>

      <div class="grid gap-8 md:grid-cols-3">
        {values.map((item) => (
          <div
            class="group p-10 rounded-section bg-background border border-border/50 hover:border-primary/50 hover:shadow-xl transition-all duration-500 hover:-translate-y-2 relative overflow-hidden"
          >
             {/* Hover Gradient Background */}
            <div class={`absolute inset-0 bg-gradient-to-br ${item.gradient} opacity-0 group-hover:opacity-100 transition-opacity duration-500`} />

            <div class="relative z-10">
                <div class="mb-8 inline-flex p-4 rounded-2xl bg-secondary text-primary group-hover:scale-110 transition-transform duration-500 shadow-sm border border-border/50">
                <item.icon className="h-8 w-8" />
                </div>
                <h3 class="font-heading text-2xl font-bold mb-4 text-foreground">
                {item.title}
                </h3>
                <p class="text-muted-foreground leading-relaxed text-lg">
                {item.desc}
                </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* Our Process */}
  <section class="section-padding bg-foreground text-background overflow-hidden relative">
     {/* Background Grid - Semantic Inverse */}
    <div class="absolute inset-0 bg-[linear-gradient(to_right,hsl(var(--background)/0.1)_1px,transparent_1px),linear-gradient(to_bottom,hsl(var(--background)/0.1)_1px,transparent_1px)] bg-[size:40px_40px] pointer-events-none opacity-20" />

    <div class="container-normal relative z-10">
      <div class="grid lg:grid-cols-2 gap-20 items-center">
        <div>
          <span class="inline-block px-4 py-1.5 rounded-full bg-primary/20 text-primary-foreground border border-primary/20 text-sm font-bold mb-6">
              Workflow
          </span>
          {/* FIX: Added 'text-background' explicitly to override global heading styles */}
          <h2 class="font-heading font-bold text-4xl md:text-6xl mb-8 leading-tight text-background">
            How We Work
          </h2>
          <p class="text-xl opacity-80 leading-relaxed mb-10 text-background/80 max-w-lg">
            We believe in a transparent, collaborative process that keeps
            you involved at every step. From the initial spark of an idea to
            the final launch, we ensure precision and quality.
          </p>
          <a href="/contact" class={cn(buttonVariants({ size: "lg" }), "h-14 rounded-full px-10 text-lg bg-background text-foreground hover:bg-background/90")}>
            Start Project
          </a>
        </div>
        
        <div class="grid gap-6">
          {process.map((phase) => (
            <div
              class="flex gap-6 items-start p-8 rounded-card bg-white/5 border border-white/10 backdrop-blur-sm hover:bg-white/10 transition-colors duration-300 hover:border-primary/50 group"
            >
              <span class="text-5xl font-bold opacity-20 text-white group-hover:text-primary group-hover:opacity-100 transition-all font-serif">
                {phase.step}
              </span>
              <div class="pt-2">
                <h3 class="font-heading text-xl font-bold mb-2 text-white">{phase.title}</h3>
                <p class="text-white/60 text-base leading-relaxed">
                  {phase.desc}
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  {/* CTA Section */}
  <section class="section-padding bg-background relative overflow-hidden">
    
    {/* FIX: Semantic Grid Background */}
    <div class="absolute inset-0 bg-[linear-gradient(to_right,hsl(var(--foreground)/0.03)_1px,transparent_1px),linear-gradient(to_bottom,hsl(var(--foreground)/0.03)_1px,transparent_1px)] bg-[size:40px_40px] pointer-events-none" />

    <div class="container-normal relative z-10">
      <div class="relative overflow-hidden rounded-section bg-foreground px-6 py-24 text-center sm:px-16 shadow-2xl">
        
        {/* Glow Effects */}
        <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-full max-w-3xl bg-primary/20 blur-[120px] rounded-full pointer-events-none" />

        <div class="relative z-10 mx-auto max-w-3xl">
          <h2 class="font-heading font-bold text-4xl font-serif text-background md:text-6xl tracking-tight mb-8">
            Let’s Build Something <br />
            <span class="text-white italic">Extraordinary.</span>
          </h2>
          <p class="text-xl text-background/80 mb-10 max-w-xl mx-auto leading-relaxed">
              Ready to transform your digital presence? Book a free consultation and let's map out your success.
          </p>
          <div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
            <a 
              href="/contact" 
              class={cn(buttonVariants({ size: "lg" }), "h-16 rounded-full px-10 text-xl font-bold bg-background text-foreground hover:bg-background/90 hover:scale-105 transition-all shadow-xl")}
            >
              Book Free Consultation
            </a>
            <a href="tel:+918140734392" class="inline-flex items-center justify-center rounded-full px-10 h-16 text-lg font-bold border border-white/20 text-background hover:bg-white/10 transition-colors backdrop-blur-sm">
             Call Us Now
          </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>