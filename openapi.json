{
  "openapi": "3.1.0",
  "info": {
    "title": "Aexaware Infotech Public API & Service Catalog",
    "summary": "Machine-readable API surface, AI discovery endpoints, Model Context Protocol (MCP) server, and developer resources.",
    "description": "Comprehensive, self-describing OpenAPI 3.1.0 specification for Aexaware Infotech (https://aexaware.com). Exposes programmatic developer endpoints, free self-serve API key provisioning, simulated sandbox inquiry execution, Model Context Protocol (MCP) Streamable HTTP tools, RFC 9727 API catalog discovery, and structured markdown feeds for autonomous AI agents.",
    "termsOfService": "https://aexaware.com/terms",
    "contact": {
      "name": "Aexaware Infotech Engineering Support",
      "url": "https://aexaware.com/contact",
      "email": "info@aexaware.com"
    },
    "license": {
      "name": "MIT / Open Discovery",
      "url": "https://aexaware.com/privacy-policy"
    },
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://aexaware.com",
      "description": "Production Edge Gateway (Cloudflare Pages + Workers)"
    },
    {
      "url": "http://localhost:4321",
      "description": "Local Development Server"
    }
  ],
  "tags": [
    {
      "name": "MCP Server",
      "description": "Model Context Protocol (MCP) Streamable HTTP endpoint exposing Aexaware engineering tools to Claude, Cursor, ChatGPT, and autonomous agents."
    },
    {
      "name": "Self-Serve Authentication",
      "description": "Zero-friction programmatic API key provisioning for developers and autonomous AI agents. No credit card or sales form required."
    },
    {
      "name": "Sandbox Environment",
      "description": "Safe simulated endpoints allowing developers and autonomous agents to test API integrations and inquiry flows without real-world CRM side effects."
    },
    {
      "name": "AI & Agent Discovery",
      "description": "Token-efficient markdown feeds, LLM context guides, and decision criteria files for AI assistants and search crawlers."
    },
    {
      "name": "Metadata & Catalogs",
      "description": "RFC 9727 Linkset API catalogs, MCP server cards, OAuth discovery metadata, and agent skill registries."
    },
    {
      "name": "Content & Feeds",
      "description": "Engineering blog RSS feeds, XML sitemaps, and technical documentation resources."
    }
  ],
  "paths": {
    "/api/mcp": {
      "get": {
        "tags": ["MCP Server"],
        "summary": "Discover MCP server capabilities or initiate SSE stream",
        "description": "Returns the Model Context Protocol (MCP) server configuration, protocol version (2025-03-26), and all 6 registered tools as JSON. If the request includes 'Accept: text/event-stream', opens a Server-Sent Events (SSE) stream for server-initiated messages over Streamable HTTP transport.",
        "operationId": "mcpGetCapabilitiesOrStream",
        "parameters": [
          {
            "name": "Accept",
            "in": "header",
            "required": false,
            "description": "Specify 'text/event-stream' for Streamable HTTP SSE streaming, or 'application/json' for static capability inspection.",
            "schema": {
              "type": "string",
              "default": "application/json",
              "enum": ["application/json", "text/event-stream"]
            },
            "example": "application/json"
          },
          {
            "name": "Mcp-Session-Id",
            "in": "header",
            "required": false,
            "description": "Optional session identifier for continuous multi-turn MCP client sessions.",
            "schema": {
              "type": "string"
            },
            "example": "mcp-sess-9f82ab3c"
          }
        ],
        "responses": {
          "200": {
            "description": "MCP server capabilities or active SSE stream endpoint event.",
            "headers": {
              "Access-Control-Allow-Origin": { "$ref": "#/components/headers/AccessControlAllowOrigin" },
              "Mcp-Session-Id": { "$ref": "#/components/headers/McpSessionId" },
              "X-RateLimit-Limit": { "$ref": "#/components/headers/RateLimitLimit" },
              "X-RateLimit-Remaining": { "$ref": "#/components/headers/RateLimitRemaining" },
              "X-RateLimit-Reset": { "$ref": "#/components/headers/RateLimitReset" }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/McpCapabilitiesResponse"
                }
              },
              "text/event-stream": {
                "schema": {
                  "type": "string",
                  "description": "Server-Sent Events stream with 'event: endpoint' initialization data.",
                  "example": "event: endpoint\ndata: {\"endpoint\":\"/api/mcp\"}\n\n"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded (120 req/min).",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "500": {
            "description": "Internal server execution error.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["MCP Server"],
        "summary": "Execute MCP JSON-RPC 2.0 tool calls and protocol methods",
        "description": "Handles standard JSON-RPC 2.0 messages for Model Context Protocol. Supported methods: 'initialize', 'notifications/initialized', 'tools/list', 'tools/call', and 'ping'. Supported tools: 'list_services', 'list_portfolio', 'search_blog', 'get_contact_info', 'provision_api_key', and 'get_openapi_spec'. Supports single and batch request arrays.",
        "operationId": "mcpPostJsonRpcMessage",
        "parameters": [
          {
            "name": "Accept",
            "in": "header",
            "required": false,
            "description": "Specify 'text/event-stream' to stream responses via SSE, or 'application/json' for synchronous JSON-RPC response.",
            "schema": {
              "type": "string",
              "default": "application/json",
              "enum": ["application/json", "text/event-stream"]
            },
            "example": "application/json"
          },
          {
            "name": "Mcp-Session-Id",
            "in": "header",
            "required": false,
            "description": "Optional session identifier to track multi-turn tool execution state.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "description": "JSON-RPC 2.0 Request object or array of Request objects (batch).",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/McpJsonRpcRequest"
              },
              "examples": {
                "initialize": {
                  "summary": "Initialize MCP Session",
                  "value": {
                    "jsonrpc": "2.0",
                    "id": 1,
                    "method": "initialize",
                    "params": {
                      "protocolVersion": "2025-03-26",
                      "clientInfo": { "name": "ClaudeDesktop", "version": "1.0.0" },
                      "capabilities": {}
                    }
                  }
                },
                "toolsList": {
                  "summary": "List Available Tools",
                  "value": {
                    "jsonrpc": "2.0",
                    "id": 2,
                    "method": "tools/list",
                    "params": {}
                  }
                },
                "callListServices": {
                  "summary": "Call list_services Tool",
                  "value": {
                    "jsonrpc": "2.0",
                    "id": 3,
                    "method": "tools/call",
                    "params": {
                      "name": "list_services",
                      "arguments": { "category": "AI / ML & Data Science" }
                    }
                  }
                },
                "callSearchBlog": {
                  "summary": "Call search_blog Tool",
                  "value": {
                    "jsonrpc": "2.0",
                    "id": 4,
                    "method": "tools/call",
                    "params": {
                      "name": "search_blog",
                      "arguments": { "query": "LLM agents" }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful JSON-RPC 2.0 Response object or batch array.",
            "headers": {
              "Access-Control-Allow-Origin": { "$ref": "#/components/headers/AccessControlAllowOrigin" },
              "Mcp-Session-Id": { "$ref": "#/components/headers/McpSessionId" },
              "X-RateLimit-Limit": { "$ref": "#/components/headers/RateLimitLimit" },
              "X-RateLimit-Remaining": { "$ref": "#/components/headers/RateLimitRemaining" },
              "X-RateLimit-Reset": { "$ref": "#/components/headers/RateLimitReset" }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/McpJsonRpcResponse"
                }
              },
              "text/event-stream": {
                "schema": {
                  "type": "string",
                  "description": "Stream of JSON-RPC response message events."
                }
              }
            }
          },
          "400": {
            "description": "JSON parse error or malformed JSON-RPC envelope.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/McpJsonRpcError" }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded (120 req/min).",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "500": {
            "description": "Internal server execution failure.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/McpJsonRpcError" }
              }
            }
          }
        }
      }
    },
    "/api/keys/provision": {
      "post": {
        "tags": ["Self-Serve Authentication"],
        "summary": "Programmatically provision a free developer trial API key",
        "description": "Instantly generates an active developer API key for autonomous agents, automated workflows, and trial developers without sales forms, CAPTCHAs, or credit card requirements. Returns 10,000 monthly sandbox requests quota and rate limits.",
        "operationId": "provisionSandboxApiKey",
        "parameters": [
          {
            "name": "User-Agent",
            "in": "header",
            "required": false,
            "description": "Client identifier string for logging and debugging.",
            "schema": { "type": "string" },
            "example": "ClaudeAgent/1.0"
          }
        ],
        "requestBody": {
          "required": false,
          "description": "Optional metadata specifying the agent or application name.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApiKeyProvisionRequest"
              },
              "examples": {
                "agentRequest": {
                  "summary": "Agent Autonomous Provisioning",
                  "value": {
                    "agent_name": "Claude3.7-Autonomous-Agent",
                    "client_email": "agent-dev@example.com",
                    "intended_use": "evaluating full-stack engineering capabilities"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "API key successfully provisioned with full quota metadata.",
            "headers": {
              "Access-Control-Allow-Origin": { "$ref": "#/components/headers/AccessControlAllowOrigin" },
              "X-RateLimit-Limit": { "$ref": "#/components/headers/RateLimitLimit" },
              "X-RateLimit-Remaining": { "$ref": "#/components/headers/RateLimitRemaining" },
              "X-RateLimit-Reset": { "$ref": "#/components/headers/RateLimitReset" }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiKeyProvisionResponse"
                }
              }
            }
          },
          "429": {
            "description": "Provisioning rate limit exceeded (maximum 20 keys per IP per hour).",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "500": {
            "description": "Internal provisioning error.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/api/inquiry/sandbox": {
      "post": {
        "tags": ["Sandbox Environment"],
        "summary": "Simulate a project inquiry submission in test sandbox",
        "description": "Accepts project inquiry parameters (scope, timeline, budget, tech stack) and runs full validation and pricing estimates in safe sandbox mode without dispatching notifications or CRM entries.",
        "operationId": "submitSandboxInquiry",
        "security": [
          { "BearerAuth": [] },
          { "ApiKeyAuth": [] }
        ],
        "requestBody": {
          "required": true,
          "description": "Project inquiry payload for simulated estimation and validation.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SandboxInquiryRequest"
              },
              "examples": {
                "mvpInquiry": {
                  "summary": "SaaS MVP Development Inquiry",
                  "value": {
                    "project_name": "HealthTech AI Platform",
                    "service_category": "MVP Development",
                    "timeline_weeks": 4,
                    "tech_stack": ["React", "Node.js", "PostgreSQL", "OpenAI"],
                    "budget_range": "$5,000 - $15,000",
                    "contact_email": "founder@healthtech-mvp.io"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sandbox inquiry validated and simulated successfully.",
            "headers": {
              "Access-Control-Allow-Origin": { "$ref": "#/components/headers/AccessControlAllowOrigin" },
              "X-RateLimit-Limit": { "$ref": "#/components/headers/RateLimitLimit" },
              "X-RateLimit-Remaining": { "$ref": "#/components/headers/RateLimitRemaining" }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SandboxInquiryResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid inquiry payload format or missing required fields.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "401": {
            "description": "Missing or invalid sandbox API key in Authorization header.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "429": {
            "description": "Sandbox rate limit exceeded (120 req/min).",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
