        "description": "Returns the RSS 2.0 feed containing all technical engineering blog posts, AI tutorials, and software architecture articles.",
        "operationId": "getEngineeringBlogRssFeed",
        "responses": {
          "200": {
            "description": "RSS 2.0 XML Feed.",
            "headers": {
              "Content-Type": { "schema": { "type": "string", "example": "application/rss+xml; charset=utf-8" } }
            },
            "content": {
              "application/rss+xml": { "schema": { "type": "string" } },
              "text/xml": { "schema": { "type": "string" } }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API Key",
        "description": "Enter your sandbox API key (e.g. 'aex_free_8f93e1b742a0d9e2') or live key. Obtain a free key instantly via POST /api/keys/provision."
      },
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "API Key header for server-to-server calls."
      }
    },
    "headers": {
      "AccessControlAllowOrigin": {
        "description": "CORS header permitting cross-origin requests from any client.",
        "schema": { "type": "string", "example": "*" }
      },
      "McpSessionId": {
        "description": "Identifier for active multi-turn MCP client sessions.",
        "schema": { "type": "string", "example": "mcp-sess-9f82ab3c" }
      },
      "RateLimitLimit": {
        "description": "Maximum requests permitted per minute.",
        "schema": { "type": "integer", "example": 120 }
      },
      "RateLimitRemaining": {
        "description": "Number of requests remaining in the current 60-second window.",
        "schema": { "type": "integer", "example": 118 }
      },
      "RateLimitReset": {
        "description": "Unix epoch timestamp when the current rate limit window resets.",
        "schema": { "type": "integer", "example": 1740321600 }
      }
    },
    "schemas": {
      "ApiKeyProvisionRequest": {
        "type": "object",
        "properties": {
          "agent_name": {
            "type": "string",
            "description": "Name or identifier of the requesting agent or client application.",
            "example": "ClaudeAgent"
          },
          "client_email": {
            "type": "string",
            "format": "email",
            "description": "Optional contact email to receive API key backups and updates.",
            "example": "developer@example.com"
          },
          "intended_use": {
            "type": "string",
            "description": "Optional brief note describing intended use.",
            "example": "Automated code evaluation and sandbox estimation"
          }
        }
      },
      "ApiKeyProvisionResponse": {
        "type": "object",
        "required": ["status", "api_key", "tier", "monthly_quota", "rate_limit", "sandbox_mode"],
        "properties": {
          "status": {
            "type": "string",
            "enum": ["success", "error"],
            "example": "success"
          },
          "api_key": {
            "type": "string",
            "description": "Active API key string. Prefix 'aex_free_' denotes sandbox tier.",
            "example": "aex_free_8f93e1b742a0d9e2"
          },
          "tier": {
            "type": "string",
            "example": "developer_free_trial"
          },
          "monthly_quota": {
            "type": "integer",
            "description": "Total free requests allocated per month.",
            "example": 10000
          },
          "rate_limit": {
            "type": "string",
            "description": "Maximum requests per minute.",
            "example": "120 req/min"
          },
          "sandbox_mode": {
            "type": "boolean",
            "description": "Indicates whether this key is scoped to the sandbox mock environment.",
            "example": true
          },
          "agent_name": {
            "type": "string",
            "example": "ClaudeAgent"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-08-23T20:00:00Z"
          },
          "endpoints": {
            "type": "object",
            "properties": {
              "developer_portal": { "type": "string", "example": "https://aexaware.com/developers" },
              "sandbox": { "type": "string", "example": "https://aexaware.com/developers#sandbox" },
              "openapi": { "type": "string", "example": "https://aexaware.com/openapi.json" },
              "mcp_server": { "type": "string", "example": "https://aexaware.com/api/mcp" }
            }
          },
          "note": {
            "type": "string",
            "example": "Free tier includes full sandbox access. Zero sales forms or credit card required."
          }
        }
      },
      "SandboxInquiryRequest": {
        "type": "object",
        "required": ["project_name", "service_category"],
        "properties": {
          "project_name": {
            "type": "string",
            "description": "Name or title of the proposed software project.",
            "example": "HealthTech SaaS Platform"
          },
          "service_category": {
            "type": "string",
            "description": "Target service capability area.",
            "enum": [
              "Web Development",
              "Mobile Development",
              "MVP Development",
              "AI Agent Development",
              "Generative AI",
              "Cloud & DevOps",
              "Software Solutions",
              "UI/UX Design",
              "Extended Team"
            ],
            "example": "MVP Development"
          },
          "timeline_weeks": {
            "type": "integer",
            "minimum": 1,
            "maximum": 52,
            "description": "Desired delivery timeline in weeks.",
            "example": 4
          },
          "tech_stack": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Preferred technologies, frameworks, or databases.",
            "example": ["React", "Node.js", "Supabase", "OpenAI API"]
          },
          "budget_range": {
            "type": "string",
            "description": "Estimated budget bracket.",
            "example": "$5,000 - $15,000"
          },
          "contact_email": {
            "type": "string",
            "format": "email",
            "description": "Contact email for simulated estimation delivery.",
            "example": "founder@startup.io"
          }
        }
      },
      "SandboxInquiryResponse": {
        "type": "object",
        "required": ["status", "environment", "message", "estimated_delivery_weeks", "consultation_url"],
        "properties": {
          "status": {
            "type": "string",
            "enum": ["success"],
            "example": "success"
          },
          "environment": {
            "type": "string",
            "enum": ["sandbox"],
            "example": "sandbox"
          },
          "message": {
            "type": "string",
            "example": "Sandbox inquiry validated and estimated successfully. No real-world CRM side effects triggered."
          },
          "estimated_delivery_weeks": {
            "type": "integer",
            "example": 4
          },
          "recommended_team_size": {
            "type": "string",
            "example": "1 Senior Full-Stack Engineer + 1 UI/UX Designer"
          },
          "consultation_url": {
            "type": "string",
            "example": "https://cal.com/aexaware-infotech"
          }
        }
      },
      "McpCapabilitiesResponse": {
        "type": "object",
        "required": ["server", "protocol", "transport", "tools_count", "tools"],
        "properties": {
          "server": {
            "type": "object",
            "properties": {
              "name": { "type": "string", "example": "aexaware-mcp-server" },
              "version": { "type": "string", "example": "1.0.0" }
            }
          },
          "protocol": { "type": "string", "example": "2025-03-26" },
          "transport": { "type": "string", "example": "streamable-http" },
          "endpoint": { "type": "string", "example": "https://aexaware.com/api/mcp" },
          "tools_count": { "type": "integer", "example": 6 },
          "tools": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/McpToolDefinition" }
          }
        }
      },
      "McpToolDefinition": {
        "type": "object",
        "required": ["name", "description", "inputSchema"],
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "list_services",
              "list_portfolio",
              "search_blog",
              "get_contact_info",
              "provision_api_key",
              "get_openapi_spec"
            ],
            "example": "list_services"
          },
          "description": {
            "type": "string",
            "example": "Returns all 19 specialized engineering services offered by Aexaware Infotech."
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "type": { "type": "string", "example": "object" },
              "properties": { "type": "object" },
              "required": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      },
      "McpJsonRpcRequest": {
        "type": "object",
        "required": ["jsonrpc", "method", "id"],
        "properties": {
          "jsonrpc": { "type": "string", "enum": ["2.0"], "example": "2.0" },
          "id": { "type": ["integer", "string"], "example": 1 },
          "method": {
            "type": "string",
            "enum": ["initialize", "notifications/initialized", "tools/list", "tools/call", "ping"],
            "example": "tools/call"
          },
          "params": {
            "type": "object",
            "properties": {
              "name": { "type": "string", "example": "list_services" },
              "arguments": { "type": "object" },
              "protocolVersion": { "type": "string", "example": "2025-03-26" },
              "clientInfo": { "type": "object" }
            }
          }
        }
      },
      "McpJsonRpcResponse": {
        "type": "object",
        "required": ["jsonrpc", "id"],
        "properties": {
          "jsonrpc": { "type": "string", "enum": ["2.0"], "example": "2.0" },
          "id": { "type": ["integer", "string", "null"], "example": 1 },
          "result": {
            "type": "object",
            "properties": {
              "content": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "type": { "type": "string", "example": "text" },
                    "text": { "type": "string" }
                  }
                }
              },
              "isError": { "type": "boolean", "example": false },
              "tools": {
                "type": "array",
                "items": { "$ref": "#/components/schemas/McpToolDefinition" }
              }
            }
          },
          "error": {
            "$ref": "#/components/schemas/McpJsonRpcError"
          }
        }
      },
      "McpJsonRpcError": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "integer", "example": -32601 },
          "message": { "type": "string", "example": "Method not found" },
          "data": { "type": "object" }
        }
      },
      "ApiCatalogLinkset": {
        "type": "object",
        "required": ["linkset"],
        "properties": {
          "linkset": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["anchor"],
              "properties": {
                "anchor": { "type": "string", "format": "uri", "example": "https://aexaware.com/docs" },
                "service-desc": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "href": { "type": "string", "format": "uri" },
                      "type": { "type": "string" }
                    }
                  }
                },
                "service-doc": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "href": { "type": "string", "format": "uri" },
                      "type": { "type": "string" }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "AgentSkillsDirectory": {
        "type": "object",
        "required": ["name", "version", "skills"],
        "properties": {
          "name": { "type": "string", "example": "aexaware-skills" },
          "version": { "type": "string", "example": "1.0.0" },
          "skills": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "description", "endpoint"],
              "properties": {
                "name": { "type": "string", "example": "mcp-server-card" },
                "description": { "type": "string", "example": "Query engineering services, portfolio, blog, and provision API keys." },
                "endpoint": { "type": "string", "example": "https://aexaware.com/api/mcp" }
              }
            }
          }
        }
      },
      "OAuthProtectedResource": {
        "type": "object",
        "required": ["resource", "authorization_servers"],
        "properties": {
          "resource": { "type": "string", "format": "uri", "example": "https://aexaware.com" },
          "authorization_servers": {
            "type": "array",
            "items": { "type": "string", "format": "uri" },
            "example": ["https://aexaware.com"]
          },
          "scopes_supported": {
            "type": "array",
            "items": { "type": "string" },
            "example": ["api:read", "api:sandbox", "mcp:tools"]
          },
          "bearer_methods_supported": {
            "type": "array",
            "items": { "type": "string" },
            "example": ["header"]
          }
        }
      },
      "OAuthAuthServer": {
        "type": "object",
        "required": ["issuer", "token_endpoint", "response_types_supported"],
        "properties": {
          "issuer": { "type": "string", "format": "uri", "example": "https://aexaware.com" },
          "token_endpoint": { "type": "string", "format": "uri", "example": "https://aexaware.com/api/keys/provision" },
          "response_types_supported": {
            "type": "array",
            "items": { "type": "string" },
            "example": ["token"]
          },
          "grant_types_supported": {
            "type": "array",
            "items": { "type": "string" },
            "example": ["client_credentials", "anonymous_trial"]
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["error", "message", "status_code", "resolution_hints"],
        "properties": {
          "error": {
            "type": "string",
            "description": "Standardized machine-readable error code.",
            "example": "RATE_LIMIT_EXCEEDED"
          },
          "message": {
            "type": "string",
            "description": "Human-readable explanation of why the request failed.",
            "example": "Rate limit of 120 requests per minute exceeded. Please retry after 1740321600."
          },
          "status_code": {
            "type": "integer",
            "description": "HTTP status code matching the response header.",
            "example": 429
          },
          "resolution_hints": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Actionable instructions enabling autonomous agents or developers to resolve the error.",
            "example": [
              "Inspect the X-RateLimit-Reset header for backoff duration.",
              "Provision a fresh sandbox key via POST https://aexaware.com/api/keys/provision.",
              "Read rate limit documentation at https://aexaware.com/auth.md."
            ]
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "example": "2026-08-23T20:00:00Z"
          },
          "request_id": {
            "type": "string",
            "example": "req_8f93e1b7"
          }
        }
      }
    }
  }
}
