# Ultra-lightweight static server for pre-built Astro site
# Used by Coolify on the 'deploy' branch (no build needed!)
FROM nginx:alpine

# Copy pre-built static files
COPY . /usr/share/nginx/html

# Custom nginx config for SPA routing (optional)
RUN echo 'map $http_accept $markdown_request { \
    default 0; \
    "~*text/markdown" 1; \
} \
server { \
    listen 80; \
    root /usr/share/nginx/html; \
    index index.html; \
    add_header Link "</.well-known/api-catalog>; rel=\"api-catalog\", </llms.txt>; rel=\"describedby\", </.well-known/mcp/server-card.json>; rel=\"service-desc\", </services>; rel=\"service-doc\""; \
    add_header Vary Accept; \
    location / { \
        if ($markdown_request) { \
            rewrite ^/$ /index.md last; \
            rewrite ^/(.+)/$ /$1.md last; \
            rewrite ^/(.+)$ /$1.md last; \
        } \
        try_files $uri $uri/ $uri.html /index.html; \
    } \
    location ~ \.md$ { \
        default_type text/markdown; \
        add_header Content-Type "text/markdown; charset=utf-8"; \
        add_header Vary Accept; \
    } \
    gzip on; \
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml text/markdown; \
}' > /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
